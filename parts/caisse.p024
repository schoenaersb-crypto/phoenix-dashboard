 ─────────────────────────────────────────────────────────────────
   LE SERVEUR EN POSTE — sa connexion vaut pointage.
   ───────────────────────────────────────────────────────────────── */
var MOI = null;
function chargeMoi(){
  try{ var b = sessionStorage.getItem('phx_caisse_moi');
       if(b) MOI = JSON.parse(b); }catch(e){}
}
function poseMoi(m){
  MOI = m;
  try{ sessionStorage.setItem('phx_caisse_moi', JSON.stringify(m)); }catch(e){}
  el('btnMoi').textContent = m ? m.nom.slice(0,2).toUpperCase() : '··';
}
function pointe(sens){
  if(!MOI) return;
  var p = { ts:Date.now(), qui:MOI.nom, sens:sens, poste:'caisse' };
  S.pointages.push(p); sauve();
  envoiDiffere({ action:'pointage', qui:MOI.nom, sens:sens,
                 ts:new Date(p.ts).toISOString(), poste:'caisse' });
}

/* La liste des prénoms est mise en cache : si le wifi tombe entre deux
   services, on doit pouvoir reprendre le poste sans réseau. */
var PROFILS = [];
function chargeProfils(){
  try{ PROFILS = JSON.parse(localStorage.getItem('phx_caisse_profils')||'[]'); }catch(e){ PROFILS=[]; }
  if(!PROFILS.length) PROFILS = ['Clément','Bouchra','Oumaima','Bastien'];
  rendLogin();
  if(!API || API.indexOf('http')!==0) return;
  if(chargeProfils.fait) return;
  chargeProfils.fait = 1;
  fetch(API, {method:'POST', cache:'no-store',
    headers:{'Content-Type':'text/plain;charset=utf-8'},
    body: JSON.stringify({ action:'caisse_profils' })})
   .then(function(r){ return r.json(); })
   .then(function(j){ if(j && j.ok && j.noms && j.noms.length){
      PROFILS = j.noms; localStorage.setItem('phx_caisse_profils', JSON.stringify(PROFILS)); rendLogin(); } })
   .catch(function(){});
}

var LG_SEL = null, LG_CODE = '';
function rendLogin(){
  el('lgQui').innerHTML = PROFILS.map(function(n){
    return '<button data-qui="'+esc(n)+'"'+(n===LG_SEL?' class="on"':'')+'>'+esc(n)+'</button>';
  }).join('');
  el('lgLangues').innerHTML = Object.keys(T).map(function(k){
    return '<button data-lg="'+k+'"'+(k===LG?' class="on"':'')+'>'+esc(T[k].nom)+'</button>';
  }).join('');
  el('lgPave').innerHTML = [1,2,3,4,5,6,7,8,9].map(function(n){
      return '<button data-num="'+n+'">'+n+'</button>'; }).join('')
    + '<button class="eff" data-num="C">&#9003;</button><button data-num="0">0</button>'
    + '<button data-num="ok" style="color:var(--gold)">✓</button>';
  majEcranCode();
}
/* Les cases vides doivent se distinguer des chiffres tapes. Avant, un code
   efface affichait quatre points identiques a quatre chiffres masques : le
   serveur appuyait sur C, voyait toujours quatre points, et croyait que son
   code s'ajoutait par-dessus. Ici les cases remplies sont pleines et dorees,
   les cases vides sont creuses et grises. */
function majEcranCode(){
  var n = LG_CODE.length, cases = '';
  for(var i=0;i<Math.max(4,n);i++){
    cases += i<n ? '<b style="color:var(--gold)">&#9679;</b>'
                 : '<b style="color:var(--ink3);font-weight:400">&#9675;</b>';
  }
  el('lgEcr').innerHTML = '<span style="letter-spacing:.18em">' + cases + '</span>'
    + '<small>' + esc(LG_SEL ? LG_SEL : t('qui_es_tu')) + '</small>';
}
var LG_LONG = 4;
function tenteConnexion(){
  if(tenteConnexion.enCours) return;              /* deux appuis = deux pointages */
  if(!LG_SEL){ el('lgMsg').style.color='var(--alert)';
               el('lgMsg').textContent = t('qui_es_tu'); return; }
  if(LG_CODE.length<LG_LONG){ el('lgMsg').style.color='var(--alert)';
               el('lgMsg').textContent = t('mauvais_code'); return; }
  tenteConnexion.enCours = true;
  el('lgPave').style.opacity = '.45';
  var msg = el('lgMsg'); msg.style.color='var(--ink3)'; msg.textContent='…';
  function ouvre(){
    tenteConnexion.enCours = false; el('lgPave').style.opacity = '1';
    msg.textContent=''; LG_CODE=''; majEcranCode();
    poseMoi({ nom:LG_SEL, debut:Date.now() });
    pointe('entree');
    el('vLogin').classList.remove('on');
    PHXtoast(t('bonjour') + ' ' + MOI.nom);
    aller('plan');
  }
  if(!API || API.indexOf('http')!==0){ ouvre(); return; }

  /* Le serveur met deux a quatre secondes a repondre — c'est Apps Script, et
     il n'y a rien a y faire. Attendre cela a chaque prise de service, en plein
     coup de feu, est insupportable. Alors : si cet appareil a deja vu ce code
     fonctionner, on ouvre TOUT DE SUITE et on verifie derriere. Si le serveur
     refuse, la session se ferme et le message le dit. Le premier jour, ou
     apres un changement de code, l'attente reste — une seule fois. */
  var att = null; try{ att = localStorage.getItem('phx_ec_'+LG_SEL); }catch(e){}
  var connu = att && att === sceau(LG_CODE);
  var qui = LG_SEL, cle = LG_CODE;

  /* Sans delai de garde, un serveur muet laissait l'ecran sur « … » pour
     toujours. Et Apps Script renvoie parfois du HTML au lieu du JSON. */
  function verifie(surSucces, surEchec){
    var fini = false;
    var minuteur = setTimeout(function(){ if(!fini){ fini=true; surEchec(true); } }, 12000);
    fetch(API, {method:'POST', cache:'no-store',
      headers:{'Content-Type':'text/plain;charset=utf-8'},
      body: JSON.stringify({ action:'caisse_login', prenom:qui, code:cle })})
     .then(function(r){ return r.text(); })
     .then(function(txt){
       if(fini) return; fini=true; clearTimeout(minuteur);
       var j=null; try{ j=JSON.parse(txt); }catch(e){}
       if(!j) return surEchec(true);
       if(j.ok){ try{ localStorage.setItem('phx_ec_'+qui, sceau(cle)); }catch(e){}
                 surSucces(); }
       else surEchec(false);
     })
     .catch(function(){ if(fini) return; fini=true; clearTimeout(minuteur); surEchec(true); });
  }
  function refuse(reseau){
    tenteConnexion.enCours = false;
    el('lgPave').style.opacity = '1';
    msg.style.color='var(--alert)';
    if(reseau){ msg.textContent = 'Serveur injoignable — reessaie'; return; }
    msg.textContent = t('mauvais_code'); LG_CODE=''; majEcranCode();
  }

  if(connu){
    ouvre();
    verifie(function(){}, function(reseau){
      if(reseau) return;
      PHXtoast(t('mauvais_code'));
      poseMoi(null);
      try{ sessionStorage.removeItem('phx_caisse_moi');
           localStorage.removeItem('phx_ec_'+qui); }catch(e){}
      LG_SEL=null; LG_CODE=''; rendLogin();
      el('vLogin').classList.add('on');
    });
    return;
  }
  verifie(ouvre, refuse);
}
/* Empreinte locale du code : de quoi reconnaître le même code sans le
   garder en clair sur la tablette. Ce n'est pas un coffre-fort, c'est
   un dépannage pour les soirs sans wifi. */
function sceau(c){
  var s = 'phoenix|' + c, h1 = 5381, h2 = 52711;
  for(var i=0;i<s.length;i++){ h1 = ((h1*33) ^ s.charCodeAt(i)) >>> 0;
                               h2 = ((h2*39) ^ s.charCodeAt(s.length-1-i)) >>> 0; }
  return h1.toString(36) + '-' + h2.toString(36);
}
function deconnexion(){
  pointe('sortie');
  var d = MOI ? MOI.debut : Date.now();
  poseMoi(null);
  try{ sessionStorage.removeItem('phx_caisse_moi'); }catch(e){}
  LG_SEL=null; LG_CODE=''; rendLogin();
  el('vLogin').classList.add('on');
  fermerFeuille();
}

/* ─────────────────────────────────────────────────────────────────
   FILE D'ATTENTE RÉSEAU — rien ne bloque le service.
   ───────────────────────────────────────────────────────────────── */
var FILE = [];
try{ FILE = JSON.parse(localStorage.getItem('phx_caisse_file')||'[]'); }catch(e){ FILE=[]; }
function fileSauve(){ try{ localStorage.setItem('phx_caisse_file', JSON.stringify(FILE)); }catch(e){} }
function envoiDiffere(p){ FILE.push({ p:p, essais:0 }); fileSauve(); videFile(); }
var enVidage = false;
function videFile(){
  if(enVidage || !FILE.length || !API || API.indexOf('http')!==0) return;
  if(!navigator.onLine){ majHors(); return; }
  enVidage = true;
  var it = FILE[0];
  fetch(API, {method:'POST', cache:'no-store',
    headers:{'Content-Type':'text/plain;charset=utf-8'}, body: JSON.stringify(it.p)})
   .then(function(r){ return r.json(); })
   .then(function(){ FILE.shift(); fileSauve(); enVidage=false; majHors(); if(FILE.length) videFile(); })
   .catch(function(){ it.essais++; enVidage=false; majHors();
                      setTimeout(videFile, Math.min(60000, 3000*it.essais)); });
}
function majHors(){
  el('hors').classList.toggle('on', !navigator.onLine || FILE.length>2);
}
window.addEventListener('online', function(){ majHors(); videFile(); });
window.addEventListener('offline', majHors);

/* ─────────────────────────────────────────────────────────────────
   LA SALLE
   ───────────────────────────────────────────────────────────────── */
var VUE = 'plan', TREF = null, CAT = D.ordre[0], ECRAN = 'cuisine', RECH = '';
var ORDRE_SVC = ['aperitif','entree','plat','dessert','boisson'];
