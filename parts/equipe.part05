
  if(remarque) notes.push('◦ ' + remarque);
  var commentaire = notes.join('  ·  ');

  var queue = [];
  services.forEach(function(s, i){
    queue.push({ action:'equipe', date:date, heures:s.d.heures, ressenti:s.d.ressenti,
      commentaire:'['+s.nom+' · '+s.d.meteo+']' + (i===0 && commentaire ? ' ' + commentaire : '') });
  });
  if(!services.length && commentaire){
    queue.push({ action:'retour', type:'Remarque', message:commentaire });
  }
  cmds.forEach(function(c){
    queue.push({ action:'commande', article:c.article, quantite:'', urgence:c.urgence });
  });
  if(priv) queue.push({ action:'retour', type:'Prive', message:priv });

  var btn = el('sendBtn');
  btn.disabled = true;

  (function run(i){
    if(i >= queue.length){
      btn.disabled = false;
      el('confirm').classList.add('on');
      setTimeout(function(){ location.reload(); }, 2400);
      return;
    }
    post(queue[i]).then(function(){ run(i+1); }).catch(function(e){
      btn.disabled = false;
      if(/code/i.test(e.message)){
        CODE=''; try{ localStorage.removeItem('phx_eq_code'); }catch(_){}
        openGate(t('err_code'));
      } else {
        err.textContent = t('err_send') + ' (' + e.message + ')';
      }
    });
  })(0);
});

/* ── réservations (hub équipe) ── */
/* SECURITE : les guillemets manquaient, ce qui laissait un nom de produit piégé
   sortir d'un attribut HTML et devenir du code. */
function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }
function labelDay(iso){
  var today = isoToday();
  var d = new Date(); d.setDate(d.getDate()+1);
  var tom = d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
  if(iso === today) return t('resa_today');
  if(iso === tom) return t('resa_tomorrow');
  try{ return new Date(iso+'T12:00:00').toLocaleDateString(t('locale'), {weekday:'long', day:'numeric', month:'long'}); }
  catch(_){ return iso; }
}
/* ══ Réservations — vue équipe ══
   Chaque réservation porte désormais son numéro de ligne, ce qui permet de
   l'ouvrir, de cocher l'arrivée et de la corriger. Les corrections partent
   directement dans le classeur, mais chaque changement est journalisé avec le
   nom de l'employé, l'ancienne et la nouvelle valeur (choix du 30/07/2026). */
var RESAS = [];

function totauxJour(list){
  var ajd = isoToday(), nb = 0, cv = 0;
  list.forEach(function(r){
    if(r.date !== ajd) return;
    if(/annul/i.test(r.statut||'')) return;
    nb++; cv += Number(r.couverts) || 0;
  });
  return { nb:nb, cv:cv };
}

function majTotaux(list){
  var tt = totauxJour(list);
  var b = el('resaTot');
  if(!b) return;
  b.innerHTML = '<span class="n">'+tt.nb+'</span><span class="u">'+t('resa_tot_resa')+'</span>'
              + '<span class="sep"></span>'
              + '<span class="n">'+tt.cv+'</span><span class="u">'+t('resa_tot_cov')+'</span>';
}

function renderResa(list){
  RESAS = list || [];
  majTotaux(RESAS);
  var box = el('resaList');
  if(!RESAS.length){ box.innerHTML = '<div class="resa-empty">'+t('resa_empty')+'</div>'; return; }
  var html='', lastDay='';
  RESAS.forEach(function(r, i){
    var day = labelDay(r.date);
    if(day !== lastDay){ html += '<div class="resa-day">'+esc(day)+'</div>'; lastDay = day; }
    var annul = /annul/i.test(r.statut||'');
    var warn = (!annul && r.statut && /valid/i.test(r.statut)) ? ' warn' : '';
    var arr  = r.arrivee ? ' arrive' : '';
    var meta = esc(r.source||'');
    if(warn)  meta += ' · <span class="resa-badge">'+t('status_avalider')+'</span>';
    if(annul) meta += ' · <span class="resa-badge annul">'+t('status_annulee')+'</span>';
    if(r.arrivee) meta += ' · <span class="resa-badge ok">\u2713 '+esc(r.arrivee)+'</span>';
    if(r.note) meta += ' · '+esc(r.note);
    html += '<div class="resa-item'+warn+arr+(annul?' annul':'')+'" data-i="'+i+'">'
      + '<button class="rtick'+(r.arrivee?' on':'')+'" data-tick="'+i+'" '
      +   'aria-label="'+esc(t('resa_arrive'))+'" title="'+esc(t('resa_arrive'))+'">\u2713</button>'
      + '<div class="rt">'+esc(r.heure||'—')+'</div>'
      + '<div class="rmid"><div class="rnom">'+esc(r.nom||'')+'</div><div class="rmeta">'+meta+'</div></div>'
      + '<div class="rcov">'+esc(r.couverts||'')+'</div></div>';
  });
  box.innerHTML = html;

  box.querySelectorAll('.resa-item').forEach(function(n){
    n.addEventListener('click', function(ev){
      if(ev.target.closest('.rtick')) return;      /* le ✓ ne doit pas ouvrir la fiche */
      resaOuvre(+n.getAttribute('data-i'));
    });
  });
  box.querySelectorAll('.rtick').forEach(function(n){
    n.addEventListener('click', function(){ resaArrivee(+n.getAttribute('data-tick')); });
  });
}

function loadReservations(){
  if(!NOM || !CODE){ openGate(); return; }
  PHX.load.inline('resaList', t('resa_loading'));
  post({ action:'reservations' })
    .then(function(j){ renderResa(j.reservations || []); })
    .catch(function(){ el('resaList').innerHTML = '<div class="resa-empty">'+t('err_send')+'</div>'; });
}

/* ── pointage de l'arrivée : un aller-retour, réversible ── */
function resaArrivee(i){
  var r = RESAS[i]; if(!r) return;
  var btn = document.querySelector('[data-tick="'+i+'"]');
  if(btn) btn.disabled = true;
  post({ action:'resa_arrivee', ligne:r.ligne, annuler: r.arrivee ? true : false })
    .then(function(){ loadReservations(); })
    .catch(function(){ if(btn) btn.disabled = false; });
}

/* ── fiche complète, modifiable ── */
var RESA_OUVERTE = -1;

function resaOuvre(i){
  var r = RESAS[i]; if(!r) return;
  RESA_OUVERTE = i;
  el('rdNom').value     = r.nom || '';
  el('rdDate').value    = r.date || '';
  el('rdHeure').value   = r.heure || '';
  el('rdCov').value     = r.couverts || '';
  el('rdContact').value = r.contact || '';
  el('rdNote').value    = r.note || '';
  el('rdStatut').value  = /annul/i.test(r.statut||'') ? 'Annulée'
                        : (/valid/i.test(r.statut||'') ? 'À valider' : 'Confirmée');
  el('rdSource').textContent = r.source || '—';
  el('rdArr').textContent = r.arrivee ? (t('resa_arrive_a')+' '+r.arrivee) : t('resa_pas_arrive');
  el('rdErr').textContent = '';
  el('rdErr').style.color = '';
  el('rdSheet').classList.add('on');
  document.body.style.overflow = 'hidden';
}

function resaFerme(){
  el('rdSheet').classList.remove('on');
  document.body.style.overflow = '';
  RESA_OUVERTE = -1;
}

function resaEnregistre(){
  var r = RESAS[RESA_OUVERTE]; if(!r) return;
  var e = el('rdErr'); e.style.color=''; e.textContent = '';
  var nom = el('rdNom').value.trim();
  if(!nom){ e.style.color='var(--alert)'; e.textContent = t('resa_need_name'); return; }

  var btn = el('rdSave'); btn.disabled = true;
  post({
    action:'resa_maj_equipe', ligne:r.ligne,
    nom:nom, date:el('rdDate').value, heure:el('rdHeure').value,
    couverts:el('rdCov').value, contact:el('rdContact').value.trim(),
    note:el('rdNote').value.trim(), statut:el('rdStatut').value
  }).then(function(j){
    btn.disabled = false;
    e.style.color = 'var(--ok)';
    e.textContent = j.modifie ? t('resa_maj_ok') : t('resa_maj_rien');
    setTimeout(function(){ resaFerme(); loadReservations(); }, 700);
  }).catch(function(err){
    btn.disabled = false;
    e.style.color = 'var(--alert)';
    e.textContent = (err && err.message) || t('err_send');
  });
}

document.querySelectorAll('.navbtn').forEach(function(b){
  b.addEventListener('click', function(){
    document.querySelectorAll('.navbtn').forEach(function(x){x.classList.remove('on')});
    b.classList.add('on');
    var v = b.dataset.v;
    el('viewFiche').style.display = (v==='fiche') ? '' : 'none';
    el('viewResa').style.display  = (v==='resa')  ? '' : 'none';
    el('viewCmd').style.display   = (v==='cmd')   ? '' : 'none';
    if(v==='resa') loadReservations();
    if(v==='cmd') loadCommandes();
  });
});
el('resaRefresh').addEventListener('click', loadReservations);
el('rdCancel').addEventListener('click', resaFerme);
el('rdSave').addEventListener('click', resaEnregistre);
el('rdSheet').addEventListener('click', function(ev){ if(ev.target === this) resaFerme(); });
document.addEventListener('keydown', function(ev){ if(ev.key === 'Escape') resaFerme(); });
el('rDate').value = isoToday(); el('rDate').min = isoToday();
el('rSave').addEventListener('click', function(){
  var e = el('rErr'); e.style.color=''; e.textContent='';
  var date = el('rDate').value, nom = el('rNom').value.trim();
  if(!date){ e.textContent = t('resa_need_date'); return; }
  if(!nom){ e.textContent = t('resa_need_name'); return; }
  var btn = el('rSave'); btn.disabled = true;
  post({ action:'reservation_manuelle', date:date, heure:el('rTime').value,
    couverts:el('rCov').value, nom:nom, contact:el('rContact').value.trim(), note:el('rNote').value.trim() })
  .then(function(){
    el('rNom').value=''; el('rContact').value=''; el('rNote').value=''; el('rTime').value='';
    btn.disabled=false;
    e.style.color='var(--ok)'; e.textContent = t('resa_saved');
    setTimeout(function(){ e.textContent=''; e.style.color=''; }, 2500);
    loadReservations();
  })
  .catch(function(err){
    btn.disabled=false;
    if(/code/i.test(err.message)){ CODE=''; try{localStorage.removeItem('phx_eq_code');}catch(_){}; openGate(t('err_code')); }
    else e.textContent = t('err_send');
  });
});
/* ── commandes (hub équipe) ── */
function urgClass(u){ if(/urgent/i.test(u)) return 'u-urgent'; if(/semaine|week|semana|encomend|esta/i.test(u)) return 'u-semaine'; return 'u-normal'; }
function thumbUrl(id){ return 'https://drive.google.com/thumbnail?id='+encodeURIComponent(id)+'&sz=w200'; }
function driveView(id){ return 'https://drive.google.com/file/d/'+encodeURIComponent(id)+'/view'; }
function renderCmd(list){
  var box = el('cmdList');
  if(!list || !list.length){ box.innerHTML = '<div class="resa-empty">'+t('cmd_empty')+'</div>'; return; }
  box.innerHTML = list.map(function(c){
    var ph = c.photo ? '<a href="'+driveView(c.photo)+'" target="_blank" rel="noopener"><img class="cthumb" src="'+thumbUrl(c.photo)+'" onerror="this.style.display=\'none\'"></a>' : '';
    var qt = c.quantite ? ' <b style="color:var(--ink-2)">×'+esc(c.quantite)+'</b>' : '';
    return '<div class="cmd-item">'+ph
      + '<div class="cmid"><div class="cart">'+esc(c.article||'')+qt+'</div>'
      + '<div class="cmeta">'+esc(c.employe||'')+' · '+esc(c.date||'')
      + (c.urgence ? ' <span class="cmd-urg '+urgClass(c.urgence)+'">'+esc(c.urgence)+'</span>' : '')
      + '</div></div>'
      + '<button class="cdone" data-row="'+c.row+'" title="'+esc(t('cmd_mark'))+'">\u2713</button></div>';
  }).join('');
  box.querySelectorAll('.cdone').forEach(function(btn){
    btn.addEventListener('click', function(){
      btn.disabled = true;
      post({ action:'commande_statut', row:+btn.dataset.row, statut:'Reçu' })
        .then(loadCommandes).catch(function(){ btn.disabled = false; });
    });
  });
}
function loadCommandes(){
  if(!NOM || !CODE){ openGate(); return; }
  PHX.load.inline('cmdList', t('resa_loading'));
  post({ action:'commandes_liste' })
    .then(function(j){ renderCmd(j.commandes || []); })
    .catch(function(){ el('cmdList').innerHTML = '<div class="resa-empty">'+t('err_send')+'</div>'; });
  if(CATALOGUE === null) loadCatalogue();
}
el('cmdRefresh').addEventListener('click', loadCommandes);


/* ═══ LA FICHE DE COMMANDE — embarquée ═══════════════════════════════
   Les 171 références des cinq feuilles papier photographiées par
   Bastien (fiche du 17/07 + relevé du 2 août), avec unité et
   fournisseur. La liste du classeur ne sert plus que d'appoint,
   filtrée sur Type = produit — les charges (salaires, fibra,
   certificados…) n'apparaissent jamais ici.
   À faire relire par Clément avant de s'y fier les 