.nom);
      if(l.opt.g) h += '<em>'+esc(l.opt.g)+'</em>';
      if(l.opt.r) h += '<em class="ret">'+esc(l.opt.r)+'</em>';
      h += '</span></div>';
    });
    h += '<div style="display:flex;gap:7px">'
       + '<button class="fait" data-fait="'+k.id+'" style="flex:1">✓ '+t('servi')+'</button>'
       + '<button class="fait" data-impk="'+k.id+'" style="flex:none;width:52px;color:var(--copper)">⎙</button>'
       + '</div></div>';
    return h;
  }).join('') : '<div class="vide">'+t('aucun_ticket')+'</div>';
}
function majBadge(){
  var n = S.tickets.filter(function(k){ return !k.fait; }).length;
  var b = el('bdg'); b.style.display = n ? '' : 'none'; b.textContent = n;
}

