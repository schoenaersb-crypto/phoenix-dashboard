)
     .catch(function(){ imprimeNavigateur(lignes); });
    return;
  }
  imprimeNavigateur(lignes);
}
/* Les balises de fermeture sont coupées en deux morceaux à dessein : le
   script qui injecte le bloc d'attente cherche la première balise de
   fermeture du corps de page, et il l'avait trouvée ici, au milieu de cette
   chaîne — ce qui a mis l'application en ligne par terre le 31 juillet.
   Ne pas les recoller, et ne pas écrire cette balise en toutes lettres. */
function imprimeNavigateur(lignes){
  if(window.__phxSansImpression){ (window.__impressions=window.__impressions||[]).push(lignes.join('\n')); return; }
  