 return; }
  if(b.dataset.lig){ feuilleLigne(b.dataset.lig); return; }
  if(b.dataset.rupt){ S.rupture[b.dataset.rupt]=1; sauve(); fermerFeuille(); renderCarte();
    S.journal.push({ts:Date.now(), qui:MOI?MOI.nom:'', type:'86', detail:b.dataset.rupt, montant:0}); return; }
  if(b.dataset.ruptOff){ delete S.rupture[b.dataset.ruptOff]; sauve(); fermerFeuille(); renderCarte(); return; }
  if(b.dataset.motif){ MOTIF = b.dataset.motif;
    b.parentNode.querySelectorAll('.opt').forEach(function(x){ x.classList.toggle('on', x===b); });
    return; }
  if(b.dataset.sup){ annuleLigne(b.dataset.sup); return; }
  if(b.dataset.offre){ offreLigne(b.dataset.offre); return; }
  if(b.dataset.lq){
    var tb2=S.tables[TREF], l2=tb2.lignes.filter(function(x){ return x.id===b.dataset.lid; })[0];
    if(l2){ l2.qte = Math.max(1, Math.min(30, l2.qte + (b.dataset.lq==='+'?1:-1))); sauve();
            feuilleLigne(l2.id); renderTable(); }
    return; }

  /* — feuille produit — */
  if(b.dataset.q){ EN_COURS.qte = Math.max(1, Math.min(30, EN_COURS.qte + (b.dataset.q==='+'?1:-1)));
    EN_COURS.note = (el('noteLibre')||{}).value||''; dessinerFeuille(); return; }
  if(b.dataset.vq){ EN_COURS.verres = Math.max(1, Math.min(12,
      EN_COURS.verres + (b.dataset.vq==='+'?1:-1))); dessinerFeuille(); return; }
  if(b.dataset.mod){ EN_COURS.mods[b.dataset.mod] = b.dataset.val;
    EN_COURS.note=(el('noteLibre')||{}).value||''; dessinerFeuille(); return; }
  if(b.dataset.ret){ var rr=b.dataset.ret, ii=EN_COURS.retraits.indexOf(rr);
    if(ii>=0) EN_COURS.retraits.splice(ii,1); else EN_COURS.retraits.push(rr);
    EN_COURS.note=(el('noteLibre')||{}).value||''; dessinerFeuille(); return; }
  if(b.id==='okProd'){ validerProduit(); return; }

  /* — addition — */
  if(b.dataset.am){ ADD.mode=b.dataset.am; ADD.sel={}; 