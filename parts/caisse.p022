var LG = localStorage.getItem('phx_caisse_lg') || 'fr';
if(!T[LG]) LG = 'fr';
function t(k){ var v = (T[LG]||T.fr)[k]; return v==null ? (T.fr[k]==null?k:T.fr[k]) : v; }
function appliqueLangue(){
  var d = T[LG].dir;
  document.documentElement.setAttribute('lang', LG);
  document.documentElement.setAttribute('dir', d);
  document.body.setAttribute('dir', d);
  document.querySelectorAll('[data-t]').forEach(function(n){ n.textContent = t(n.dataset.t); });
  el('rech').setAttribute('placeholder', t('chercher'));
  el('hors').textContent = t('hors_ligne');
  el('btnAjouter').textContent = '+ ' + t('carte');
  el('btnAddition').textContent = t('addition');
  el('btnEnvoyer').textContent = t('envoyer');
  localStorage.setItem('phx_caisse_lg', LG);
}

/* ─────────────────────────────────────────────────────────────────
   L'ÉTAT — écrit sur l'appareil à chaque changement.
   ───────────────────────────────────────────────────────────────── */
var CLE = 'phx_caisse_v2';
var S = null;
function etatNeuf(){
  return { v:2, jour:jourService(), tables:{}, tickets:[], ventes:[], journal:[],
           pointages:[], seq:0, numTicket:0, fond:0, rupture:{}, ouvertA:Date.now() };
}
function charge(){
  try{
    var b = localStorage.getItem(CLE);
    if(b){ var o = JSON.parse(b);
      if(o && o.v===2){
        /* Une journée nouvelle sans Z de la veille : on garde tout, le
           Z de la veille reste à faire et l'écran de journée le dira. */
        S = o; return;
      } }
  }catch(e){}
  S = etatNeuf();
}
