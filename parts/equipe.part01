es */
.cmd-item{display:flex;align-items:center;gap:10px;padding:11px 12px;border:1px solid var(--hair-soft);
  border-radius:12px;margin-bottom:8px;background:rgba(11,30,44,.35)}
.cmd-item .cmid{flex:1;min-width:0}
.cmd-item .cart{font-size:15px;color:var(--ink)}
.cmd-item .cmeta{font-size:12px;color:var(--ink-3);display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-top:2px}
.cmd-item .cdone{flex:none;width:42px;height:42px;border-radius:11px;border:1px solid var(--hair-soft);
  background:none;color:var(--ok);font-size:18px;cursor:pointer}
.cmd-item .cdone:active{transform:scale(.92)}
.cmd-urg{font-family:var(--mono);font-size:9px;letter-spacing:.04em;text-transform:uppercase;padding:2px 7px;border-radius:999px}
.cmd-urg.u-urgent{background:rgba(196,99,63,.2);color:var(--alert)}
.cmd-urg.u-semaine{background:rgba(185,141,85,.2);color:var(--copper)}
.cmd-urg.u-normal{background:rgba(127,163,122,.18);color:var(--ok)}
.cmd-item .cthumb{width:42px;height:42px;border-radius:9px;object-fit:cover;flex:none;border:1px solid var(--hair-soft)}

/* catalogue produits */
.cat-row{display:flex;align-items:center;gap:10px;padding:9px 2px;border-bottom:1px solid var(--hair-soft)}
.cat-row:last-child{border-bottom:0}
.cat-row input[type=checkbox]{width:21px;height:21px;accent-color:var(--gold);flex:none}
.cat-row .cname{flex:1;min-width:0;font-size:14.5px;color:var(--ink)}
.cat-row .cunit{font-size:11px;color:var(--ink-3)}
.cat-row .cqty{width:66px;flex:none;padding:8px 6px;text-align:center;font-size:14px}
.cat-empty{font-size:13px;color:var(--ink-3);text-align:center;padding:14px 0}
#catList{max-height:340px;overflow-y:auto}
.photobtn{display:block;text-align:center;font-size:13.5px;color:var(--copper);
  background:none;border:1px dashed var(--hair);border-radius:12px;padding:12px;cursor:pointer;margin-top:10px}
#cPhotoPrev{margin-top:10px}
#cPhotoPrev img{max-width:100%;border-radius:12px;border:1px solid var(--hair-soft);display:block}
#cPhotoPrev .rm{display:inline-block;margin-top:7px;font-size:12.5px;color:var(--alert);cursor:pointer}

/* liste réservations */
.resa-empty{font-size:13.5px;color:var(--ink-3);text-align:center;padding:16px 0}
.resa-day{font-family:var(--mono);font-size:10px;letter-spacing:.15em;text-transform:uppercase;color:var(--copper);margin:14px 0 8px}
.resa-day:first-child{margin-top:2px}
.resa-item{display:flex;align-items:center;gap:11px;padding:11px 12px;border:1px solid var(--hair-soft);
  border-radius:12px;margin-bottom:8px;background:rgba(11,30,44,.35)}
.resa-item .rt{font-family:var(--mono);font-size:15px;color:var(--gold);min-width:48px}
.resa-item .rmid{flex:1;min-width:0}
.resa-item .rnom{font-size:15px;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.resa-item .rmeta{font-size:12px;color:var(--ink-3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.resa-item .rcov{font-family:var(--serif);font-size:23px;color:var(--ink);min-width:30px;text-align:center}
.resa-item.warn{border-color:rgba(212,168,67,.5);background:rgba(212,168,67,.08)}
/* ── totaux du jour, en haut à droite de l'onglet Réservations ── */
.resa-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
#resaTot{display:flex;align-items:baseline;gap:6px;flex:none;padding:5px 11px;border-radius:999px;
  border:1px solid var(--hair);background:rgba(185,141,85,.09)}
#resaTot .n{font-family:var(--serif);font-size:20px;line-height:1;color:var(--gold)}
#resaTot .u{font-family:var(--mono);font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3)}
#resaTot .sep{width:1px;height:14px;background:var(--hair);margin:0 3px;align-self:center}

/* ── ligne de réservation : cliquable, avec le ✓ d'arrivée ── */
.resa-item{cursor:pointer;-webkit-tap-highlight-color:transparent}
.resa-item:active{background:rgba(185,141,85,.1)}
.resa-item.arrive{border-color:rgba(127,163,122,.45)}
.resa-item.annul{opacity:.45}
.resa-item.annul .rnom{text-decoration:line-through}
.rtick{flex:none;width:28px;height:28px;border-radius:50%;border:1px solid var(--hair);
  background:transparent;color:var(--ink-3);font-size:14px;line-height:1;cursor:pointer;
  display:grid;place-items:center;padding:0;transition:.15s}
.rtick.on{background:var(--ok);border-color:var(--ok);color:#fff}
.rtick:disabled{opacity:.4}
.resa-badge.ok{color:var(--ok)}
.resa-badge.annul{color:var(--alert)}

/* ── fiche détaillée ── */
#rdSheet{position:fixed;inset:0;z-index:9000;display:none;background:rgba(11,26,36,.72);
  -webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}
#rdSheet.on{display:block}
#rdSheet .panel{position:absolute;left:0;right:0;bottom:0;max-height:92vh;overflow-y:auto;
  background:var(--navy-card-solid);border-top:1px solid var(--hair);
  border-radius:var(--r) var(--r) 0 0;padding:16px var(--pad) calc(20px + env(safe-area-inset-bottom));
  animation:rdUp .22s cubic-bezier(.22,.9,.3,1) both}
@keyframes rdUp{from{transform:translateY(22px);opacity:0}to{transform:none;opacity:1}}
#rdSheet .grab{width:36px;height:4px;border-radius:2px;background:var(--hair);margin:0 auto 14px}
#rdSheet h3{font-family:var(--serif);font-weight:400;font-size:21px;color:var(--cream);margin:0 0 2px}
#rdSheet .sub{font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;
  color:var(--copper);margin-bottom:14px}
#rdSheet .duo{display:flex;gap:10px}
#rdSheet .duo>div{flex:1;min-width:0}
#rdSheet .acts{display:flex;gap:10px;margin-top:16px}
#rdSheet .acts .submit{flex:1;margin-top:0}
.rdclose{flex:none;padding:0 16px;border-radius:12px;border:1px solid var(--hair);
  background:transparent;color:var(--ink-2);font-family:var(--sans);font-size:14px;cursor:pointer}
#rdArr{font-size:12.5px;color:var(--ink-3);margin-top:10px}
@media (prefers-reduced-motion:reduce){ #rdSheet .panel{animation:none} }

.resa-badge{font-family:var(--mono);font-size:9.5px;letter-spacing:.05em;color:var(--warn);text-transform:uppercase}

@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}
}
</style>
</head>

<body>
<div class="ambient" aria-hidden="true"></div>

<div class="wrap">
  <header class="masthead">
    <div class="eyebrow">Brasserie Phoenix</div>
    <h1 data-t="title">Retours journaliers</h1>
    <div class="date" id="mastDate"></div>
    <div class="banner" id="banner" style="display:none"></div>
    <div class="idrow">
      <span class="idchip" id="whoChip">—</span>
      <span class="lang" id="langRow">
        <button data-l="fr">FR</button><button data-l="es">ES</button><button data-l="pt">PT</button><button data-l="ar">AR</button>
      </span>
      <button class="switch" id="switchBtn">⇄</button>
    </div>
  </header>

  <nav class="nav"><div class="navseg">
    <button class="navbtn on" data-v="fiche" data-t="nav_fiche">Ma fiche</button>
    <button class="navbtn" data-v="resa" data-t="nav_resa">Réservations</button>
    <button class="navbtn" data-v="cmd" data-t="nav_cmd">Commandes</button>
  </div></nav>

  <div id="viewFiche">
  <!-- date du service -->
  <div class="card">
    <div class="f-label" data-t="lbl_service_date">Date du service</div>
    <input class="f-input" type="date" id="svcDate">
    <div class="hint" data-t="hint_service_date"></div>
  </div>

  <!-- service du midi -->
  <div class="card" data-svc="midi">
    <h2><span data-t="svc_midi_title">☀️ Service du midi</span>
      <label class="sw"><input type="checkbox" class="workedChk"><i></i></label>
    </h2>
    <div class="svc-off on" data-t="lbl_not_worked_note"></div>
    <div class="svc-body">
      <div class="f-label" data-t="lbl_hours">Heures travaillées</div>
      <div class="times">
        <input class="f-input tStart" type="time">
        <span class="arrow">→</span>
        <input class="f-input tEnd" type="time">
      </div>
      <div class="dur"></div>
      <div class="f-label" data-t="lbl_weather">Météo du service</div>
      <div class="weather">
        <div class="w-opt" data-w="5"><span class="ic">🌤</span><span data-t="w_fluide">Fluide</span></div>
        <div class="w-opt" data-w="4"><span class="ic">⛅</span><span data-t="w_correct">Correct</span></div>
        <div class="w-opt" data-w="2"><span class="ic">🌧</span><span data-t="w_tendu">Tendu</span></div>
        <div class="w-opt" data-w="1"><span class="ic">⛈</span><span data-t="w_difficile">Difficile</span></div>
      </div>
    </div>
  </div>

  <!-- service du soir -->
  <div class="card" data-svc="soir">
    <h2><span data-t="svc_soir_title">🌙 Service du soir</span>
      <label class="sw"><input type="checkbox" class="workedChk" checked><i></i></label>
    </h2>
    <div class="svc-off" data-t="lbl_not_worked_note"></div>
    <div class="svc-body on">
      <div class="f-label" data-t="lbl_hours">Heures travaillées</div>
      <div class="times">
        <input class="f-input tStart" type="time" value="18:00">
        <span class="arrow">→</span>
        <input class="f-input tEnd" type="time" value="23:30">
      </div>
      <div class="dur"></div>
      <div class="f-label" data-t="lbl_weather">Météo du service</div>
      <div class="weather">
        <div class="w-opt" data-w="5"><span class="ic">🌤</span><span data-t="w_fluide">Fluide</span></div>
        <div class="w-opt" data-w="4"><span class="ic">⛅</span><span data-t="w_correct">Correct</span></div>
        <div class="w-opt" data-w="2"><span class="ic">🌧</span><span data-t="w_tendu">Tendu</span></div>
        <div class="w-opt" data-w="1"><span class="ic">⛈</span><span data-t="w_difficile">Difficile</span></div>
      </div>
    </div>
  </div>

  <!-- forces / faiblesses -->
  <div class="card">
    <div class="f-label" style="margin-top:0" data-t="lbl_fort">Ce qui a marché</div>
    <textarea class="f-area" id="fort" data-p="ph_fort"></textarea>
    <div class="f-label" data-t="lbl_faible">Ce qui a coincé</div>
    <textarea class="f-area" id="faible" data-p="ph_faible"></textarea>
  </div>

  <!-- commandes & besoins -->
  <div class="card">
    <div class="f-label" style="margin-top:0" data-t="lbl_besoins">Commandes &amp; besoins</div>
    <div id="orders"></div>
    <button class="addline" id="addOrder" data-t="btn_add_order">+ Ajouter un produit</button>
  </div>

  <!-- mot privé -->
  <div class="card">
    <label class="priv-head"><label class="sw"><input type="checkbox" id="privChk"><i></i></label>
      <span data-t="lbl_private_toggle">🔒 Un mot privé pour le patron uniquement</span></label>
    <div class="priv-body" id="privBody">
      <textarea class="f-area" id="privMsg" data-p="ph_private"></textarea>
    </div>
  </div>

  <!-- remarque libre -->
  <div class="card">
    <div class="f-label" style="margin-top:0"><span data-t="lbl_remarque">Remarque libre</span> <span class="opt" data-t="lbl_opt">(facultatif)</span></div>
    <textarea class="f-area" id="remarque" data-p="ph_remarque"></textarea>
  </div>

  <button class="submit" id="sendBtn" data-t="btn_submit">Envoyer la fiche</button>
  <div class="form-err" id="formErr"></div>
  <div class="footnote" data-t="footnote">Rempli chaque jour · 30 secondes</div>
  </div><!-- /viewFiche -->

  <div id="viewResa" style="display:none">
    <div class="card">
      <div class="resa-head">
        <div class="f-label" style="margin-top:0" data-t="resa_upcoming">Réservations à venir</div>
        <div id="resaTot" aria-live="polite"></div>
      </div>
      <div id="resaList"><div class="resa-empty" data-t="resa_loading">Chargement…</div></div>
      <button class="addline" id="resaRefresh" data-t="resa_refresh" style="margin-top:8px">↻ Actualiser</button>
    </div>
    <div class="card">
      <div class="f-label" style="margin-top:0" data-t="resa_add_title">+ Ajouter une réservation</div>
      <div class="f-label" data-t="resa_f_date">Date</div>
      <input class="f-input" type="date"