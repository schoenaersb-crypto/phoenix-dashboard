/* Le service tel que Bastien le veut : chronos, retards, débarrassage.
     Deux chronos — depuis la prise de commande (sur la table), depuis le
     faire marcher (sur chaque service). Au-delà du délai : orange qui
     clignote, en salle comme en cuisine. Le débarrassage se marque ici,
     et ouvre la fenêtre du service suivant. */
  var maintenant = Date.now();
  tb.debar = tb.debar || {};
  if(tb.tsCommande){
    var mnT = Math.floor((maintenant - tb.tsCommande)/60000);
    el('soustitre').textContent += ' · ' + t('commande_dep') + ' ' + mnT + ' min';
  }
  var h='';
  var precDebar = true;   /* le premier service à table n'attend personne */
  ORDRE_SVC.forEach(function(sv){
    var lst = tb.lignes.filter(function(l){ return l.service===sv; });
    if(!lst.length) return;
    var vives = lst.filter(function(l){ return !l.annule; });
    var enAttente = vives.some(function(l){ return l.etat==='attente'; });
    var lance     = vives.some(function(l){ return l.etat==='lance'; });
    var toutParti = vives.length && vives.every(function(l){ return l.etat==='lance'; });
    var mange = sv==='entree' || sv==='plat' || sv==='dessert';
    h += '<div class="svc"><h3>'+esc(NOM_SVC[sv]);
    if(tb.debar[sv]){
      h += '<span class="etat e-debar">'+t('debarrasse')+' '+hhmm(tb.debar[sv])+'</span>';
    } else if(lance){
      var tsl = Math.max.apply(null, vives.filter(function(l){ return l.etat==='lance'; })
                                          .map(function(l){ return l.tsLance||0; }));
      var mn = Math.floor((maintenant - tsl)/60000);
      var seuil = SEUIL_SVC[sv]||10;
      h += '<span class="etat '+(mn>seuil && mange ? 'e-retard':'e-lance')+'">'
         + (mn>seuil && mange ? t('en_retard')+' · ' : t('lance')+' · ') + mn + ' min</span>';
    }
    if(enAttente && !lance) h += '<span class="etat e-attente">'+t('en_attente')+'</span>';
    if(enAttente) h += '<button data-marche="'+sv+'"'
       + (precDebar ? ' class="pulse"' : '') + '>'+t('faire_marcher')+'</button>';
    if(toutParti && mange && !tb.debar[sv])
       h += '<button data-debar="'+sv+'">'+t('debarrasser')+'</button>';
    h += '</h3>';
    if(mange) precDebar = !!tb.debar[sv];
    