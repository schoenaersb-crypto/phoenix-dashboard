<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; connect-src 'self' https://script.google.com https://script.googleusercontent.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-inline'; frame-src https://drive.google.com https://docs.google.com; form-action 'none'; base-uri 'none'; object-src 'none'">

<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0B1E2C">
<title>Phoenix — Retours journaliers</title>

<!-- PWA : à ajouter à l'écran d'accueil du téléphone -->
<link rel="apple-touch-icon" href="icone.png">
<link rel="icon" type="image/png" sizes="192x192" href="icone.png">
<meta name="apple-mobile-web-app-title" content="Phoenix Équipe">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Jost:wght@300;400;500;600&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">

<style>
:root{
  --navy:#16364A; --navy-deep:#0B1E2C;
  --navy-card:rgba(27,63,85,.5); --navy-card-solid:#17394E;
  --copper:#B98D55; --gold:#D4A843; --cream:#F6F0E4;
  --ink:var(--cream); --ink-2:rgba(246,240,228,.62); --ink-3:rgba(246,240,228,.4);
  --ok:#7FA37A; --warn:#D4A843; --alert:#C4633F;
  --hair:rgba(185,141,85,.3); --hair-soft:rgba(185,141,85,.15);
  --serif:'Cormorant Garamond',Georgia,serif;
  --sans:'Jost',system-ui,-apple-system,sans-serif;
  --mono:'JetBrains Mono',ui-monospace,monospace;
  --pad:18px; --r:18px;
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html{-webkit-text-size-adjust:100%}
body{
  font-family:var(--sans);font-weight:300;
  background:var(--navy-deep);color:var(--ink);
  min-height:100vh;line-height:1.5;overflow-x:hidden;
  padding-bottom:calc(30px + env(safe-area-inset-bottom));
}
body[dir="rtl"] .lang{direction:ltr}
.ambient{position:fixed;inset:0;z-index:-1;
  background:
    radial-gradient(52% 34% at 82% -6%, rgba(212,168,67,.12), transparent 70%),
    radial-gradient(60% 42% at -12% 26%, rgba(185,141,85,.1), transparent 70%),
    var(--navy-deep);}
.ambient::after{content:"";position:absolute;inset:0;
  background-image:radial-gradient(rgba(246,240,228,.028) 1px, transparent 1px);
  background-size:26px 26px;
  mask-image:linear-gradient(180deg,transparent,#000 18%,#000 78%,transparent);}

.wrap{max-width:520px;margin:0 auto;padding:0 var(--pad)}

.masthead{text-align:center;padding:calc(20px + env(safe-area-inset-top)) 0 6px}
.eyebrow{font-family:var(--mono);font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--copper)}
.masthead h1{font-family:var(--serif);font-weight:400;font-size:31px;margin-top:3px}
.masthead .date{font-family:var(--serif);font-style:italic;font-size:14px;color:var(--ink-2);margin-top:3px}

.idrow{display:flex;align-items:center;justify-content:center;gap:9px;margin:10px 0 16px;flex-wrap:wrap}
.idchip{font-size:13px;color:var(--ink-2);border:1px solid var(--hair-soft);border-radius:999px;padding:6px 13px}
.idchip b{font-weight:500;color:var(--ink)}
.switch,.lang button{
  background:none;border:1px solid var(--hair-soft);border-radius:999px;
  color:var(--ink-3);font-family:var(--mono);font-size:10px;letter-spacing:.09em;text-transform:uppercase;
  padding:6px 10px;cursor:pointer;
}
.lang{display:inline-flex;gap:5px}
.lang button.on{color:var(--navy-deep);background:var(--copper);border-color:var(--copper);font-weight:600}

.card{
  background:var(--navy-card);
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
  border:1px solid var(--hair-soft);border-radius:var(--r);
  padding:17px 16px;margin-bottom:13px;
  box-shadow:0 10px 30px rgba(0,0,0,.22), inset 0 1px 0 rgba(246,240,228,.05);
}
.card h2{font-family:var(--serif);font-weight:400;font-size:21px;display:flex;align-items:center;gap:9px}
.card h2 .sw{margin-left:auto}
body[dir="rtl"] .card h2 .sw{margin-left:0;margin-right:auto}

.f-label{
  font-family:var(--mono);font-size:10px;letter-spacing:.15em;text-transform:uppercase;
  color:var(--copper);margin:15px 0 8px;
}
.f-label .opt{text-transform:none;letter-spacing:.02em;color:var(--ink-3)}
.hint{font-size:11.5px;color:var(--ink-3);margin-top:5px}

.f-input,.f-area,select.f-input{
  width:100%;font-family:var(--sans);font-size:16px;font-weight:300;
  color:var(--ink);background:rgba(11,30,44,.55);
  border:1px solid var(--hair-soft);border-radius:12px;
  padding:12px 13px;
  color-scheme:dark;
}
.f-area{resize:none;min-height:74px;line-height:1.5}
.f-input:focus,.f-area:focus{outline:2px solid var(--gold);outline-offset:-1px}

/* interrupteur "j'ai travaillé" */
.sw{position:relative;width:46px;height:26px;flex:none}
.sw input{position:absolute;inset:0;opacity:0;cursor:pointer;z-index:2}
.sw i{position:absolute;inset:0;border-radius:99px;background:rgba(246,240,228,.14);transition:background .2s}
.sw i::after{content:"";position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;
  background:var(--cream);transition:transform .2s}
.sw input:checked + i{background:var(--ok)}
.sw input:checked + i::after{transform:translateX(20px)}

.svc-body{display:none;padding-top:2px}
.svc-body.on{display:block}
.svc-off{display:none;font-size:12.5px;color:var(--ink-3);padding-top:10px}
.svc-off.on{display:block}

.times{display:grid;grid-template-columns:1fr auto 1fr;gap:9px;align-items:center}
.times .arrow{color:var(--ink-3)}
.dur{font-family:var(--mono);font-size:12px;color:var(--ink-2);margin-top:7px;text-align:center;min-height:16px}
.dur b{color:var(--gold);font-weight:600}

/* météo du service */
.weather{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.w-opt{
  cursor:pointer;text-align:center;
  background:rgba(11,30,44,.55);border:1px solid var(--hair-soft);border-radius:13px;
  padding:11px 4px 9px;color:var(--ink-2);
  font-family:var(--sans);font-size:11.5px;
  transition:all .15s;
}
.w-opt .ic{font-size:20px;display:block;margin-bottom:3px;filter:grayscale(1);opacity:.6}
.w-opt.on{color:var(--ink);border-color:var(--gold);background:rgba(212,168,67,.12);transform:scale(1.03)}
.w-opt.on .ic{filter:none;opacity:1}

/* commandes */
.order{border:1px solid var(--hair-soft);border-radius:13px;padding:11px;margin-bottom:9px;background:rgba(11,30,44,.35)}
.order .rowx{display:flex;gap:8px;margin-bottom:8px}
.order select{flex:1}
.order .del{flex:none;width:42px;border-radius:11px;border:1px solid var(--hair-soft);
  background:none;color:var(--ink-3);font-size:16px;cursor:pointer}
.urg{display:flex;gap:7px;margin-top:8px}
.urg button{
  flex:1;font-family:var(--sans);font-size:11.5px;color:var(--ink-2);
  background:rgba(11,30,44,.55);border:1px solid var(--hair-soft);border-radius:9px;
  padding:8px 4px;cursor:pointer;
}
.urg button.on[data-u="urgent"]{background:var(--alert);border-color:var(--alert);color:var(--cream);font-weight:500}
.urg button.on[data-u="semaine"]{background:var(--copper);border-color:var(--copper);color:var(--navy-deep);font-weight:500}
.urg button.on[data-u="pas-urgent"]{background:var(--ok);border-color:var(--ok);color:var(--navy-deep);font-weight:500}
.addline{
  width:100%;font-family:var(--sans);font-size:13.5px;color:var(--copper);
  background:none;border:1px dashed var(--hair);border-radius:12px;
  padding:11px;cursor:pointer;
}

/* mot privé */
.priv-head{display:flex;align-items:center;gap:10px;cursor:pointer;font-size:14px;color:var(--ink-2)}
.priv-body{display:none;margin-top:10px}
.priv-body.on{display:block}

.submit{
  width:100%;margin:6px 0 8px;
  font-family:var(--sans);font-size:16px;font-weight:500;letter-spacing:.02em;
  color:var(--navy-deep);background:var(--gold);
  border:0;border-radius:14px;padding:16px;cursor:pointer;
  box-shadow:0 8px 22px rgba(212,168,67,.28);
}
.submit:disabled{opacity:.45}
.submit:active{transform:scale(.985)}
.form-err{font-size:12.5px;color:var(--alert);text-align:center;min-height:18px;margin-bottom:6px}
.footnote{text-align:center;font-family:var(--serif);font-style:italic;font-size:13px;color:var(--ink-3);padding-bottom:10px}

/* confirmation plein écran */
.confirm{position:fixed;inset:0;z-index:80;display:none;align-items:center;justify-content:center;
  background:var(--navy-deep);text-align:center;padding:30px}
.confirm.on{display:flex}
.ok-ring{width:84px;height:84px;margin:0 auto 20px;border-radius:50%;
  border:2px solid var(--ok);display:flex;align-items:center;justify-content:center;
  animation:popin .45s cubic-bezier(.22,.9,.3,1) both}
.ok-ring svg{width:38px;height:38px;stroke:var(--ok);fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
@keyframes popin{from{transform:scale(.4);opacity:0}to{transform:none;opacity:1}}
.confirm h3{font-family:var(--serif);font-weight:400;font-size:27px;margin-bottom:8px}
.confirm p{font-size:14px;color:var(--ink-2)}

.banner{
  margin:4px auto 10px;max-width:420px;
  font-size:13px;padding:9px 14px;border-radius:11px;
  border:1px solid var(--hair-soft);
}
.banner.warn{color:var(--warn);border-color:rgba(212,168,67,.4);background:rgba(212,168,67,.08)}
.banner.ok{color:var(--ok);border-color:rgba(127,163,122,.35);background:rgba(127,163,122,.07)}

/* porte d'entrée */
.gate{position:fixed;inset:0;z-index:90;display:none;align-items:center;justify-content:center;
  background:var(--navy-deep);padding:26px}
.gate.on{display:flex}
.gate-card{width:100%;max-width:340px;text-align:center}
.gate-card .wordmark{font-family:var(--serif);font-size:29px;margin-bottom:4px}
.gate-card .wordmark em{font-style:normal;color:var(--copper)}
.gate-sub{font-size:13.5px;color:var(--ink-2);margin-bottom:16px}
.who{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:13px}
.who button{
  font-family:var(--sans);font-size:14px;color:var(--ink-2);
  background:var(--navy-card);border:1px solid var(--hair-soft);border-radius:999px;
  padding:9px 16px;cursor:pointer;
}
.who button.on{color:var(--navy-deep);background:var(--gold);border-color:var(--gold);font-weight:500}
.gate-input{width:100%;text-align:center;
  font-family:var(--sans);font-size:15px;
  color:var(--ink);background:var(--navy-card);
  border:1px solid var(--hair);border-radius:13px;
  padding:13px 12px;margin-bottom:11px}
.gate-input.code{font-family:var(--mono);font-size:18px;letter-spacing:.3em}
.gate-input.code::placeholder{letter-spacing:.05em;font-family:var(--sans);font-size:14px}
.gate-input:focus{outline:2px solid var(--gold);outline-offset:-1px}
.gate-btn{width:100%;font-family:var(--sans);font-size:15px;font-weight:500;
  color:var(--navy-deep);background:var(--gold);border:0;border-radius:13px;
  padding:14px;cursor:pointer}
.gate-err{font-size:12.5px;color:var(--alert);margin-top:10px;min-height:18px}
.gate .lang{margin-bottom:16px}

/* navigation fiche / réservations */
.nav{margin:2px 0 12px}
.navseg{display:flex;background:var(--navy-card);border:1px solid var(--hair-soft);border-radius:999px;padding:4px}
.navbtn{flex:1;background:none;border:0;border-radius:999px;padding:8px 4px;cursor:pointer;
  font-family:var(--sans);font-size:12.5px;color:var(--ink-2)}
.navbtn.on{background:var(--gold);color:var(--navy-deep);font-weight:500}

.cat-sec{display:flex;justify-content:space-between;align-items:center;padding:10px 4px 8px;
 margin-top:6px;border-bottom:1px solid var(--line,rgba(0,0,0,.08));cursor:pointer;user-select:none}
.cat-sec b{font-size:13.5px}
.cat-sec span{font-size:12px;opacity:.6}
.cat-sec.on b{color:var(--accent,#B98D55)}
.cfour{display:block;font-size:11px;opacity:.55;margin-top:1px}
/* liste command