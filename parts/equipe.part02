 id="rDate">
      <div class="f-label" data-t="resa_f_time">Heure</div>
      <input class="f-input" type="time" id="rTime">
      <div class="f-label" data-t="resa_f_cov">Couverts</div>
      <input class="f-input" type="number" id="rCov" min="1" max="40" value="2" inputmode="numeric">
      <div class="f-label" data-t="resa_f_nom">Nom</div>
      <input class="f-input" id="rNom">
      <div class="f-label"><span data-t="resa_f_contact">Contact</span> <span class="opt" data-t="lbl_opt">(facultatif)</span></div>
      <input class="f-input" id="rContact">
      <div class="f-label"><span data-t="resa_f_note">Note</span> <span class="opt" data-t="lbl_opt">(facultatif)</span></div>
      <textarea class="f-area" id="rNote"></textarea>
      <button class="submit" id="rSave" data-t="resa_save" style="margin-top:14px">Ajouter</button>
      <div class="form-err" id="rErr"></div>
    </div>

  <div id="rdSheet" role="dialog" aria-modal="true" aria-labelledby="rdTitre">
    <div class="panel">
      <div class="grab"></div>
      <h3 id="rdTitre" data-t="resa_detail">Réservation</h3>
      <div class="sub"><span data-t="resa_f_source">Source</span> · <span id="rdSource">—</span></div>

      <div class="f-label" style="margin-top:0" data-t="resa_f_nom">Nom</div>
      <input class="f-input" id="rdNom">
      <div class="duo">
        <div><div class="f-label" data-t="resa_f_date">Date</div><input class="f-input" type="date" id="rdDate"></div>
        <div><div class="f-label" data-t="resa_f_time">Heure</div><input class="f-input" type="time" id="rdHeure"></div>
      </div>
      <div class="duo">
        <div><div class="f-label" data-t="resa_f_cov">Couverts</div>
             <input class="f-input" type="number" id="rdCov" min="0" max="200" inputmode="numeric"></div>
        <div><div class="f-label" data-t="resa_f_statut">Statut</div>
             <select class="f-input" id="rdStatut">
               <option value="Confirmée" data-t="status_confirmee">Confirmée</option>
               <option value="À valider" data-t="status_avalider">À valider</option>
               <option value="Annulée" data-t="status_annulee">Annulée</option>
             </select></div>
      </div>
      <div class="f-label" data-t="resa_f_contact">Contact</div>
      <input class="f-input" id="rdContact">
      <div class="f-label" data-t="resa_f_note">Note</div>
      <textarea class="f-area" id="rdNote"></textarea>
      <div id="rdArr"></div>
      <div class="acts">
        <button class="rdclose" id="rdCancel" data-t="btn_fermer">Fermer</button>
        <button class="submit" id="rdSave" data-t="resa_maj_save">Enregistrer</button>
      </div>
      <div class="form-err" id="rdErr"></div>
      <div class="footnote" data-t="resa_trace">Chaque modification est enregistrée avec ton nom.</div>
    </div>
  </div>
  </div>

  <div id="viewCmd" style="display:none">
    <div class="card">
      <div class="f-label" style="margin-top:0" data-t="cmd_open">À commander</div>
      <div id="cmdList"><div class="resa-empty" data-t="resa_loading">Chargement…</div></div>
      <button class="addline" id="cmdRefresh" data-t="resa_refresh" style="margin-top:8px">↻ Actualiser</button>
    </div>
    <div class="card">
      <div class="f-label" style="margin-top:0" data-t="cmd_catalogue">Fiche de commande</div>
      <input class="f-input" id="catSearch" data-p="cmd_search" style="margin-bottom:10px">
      <div id="catList"><div class="cat-empty" data-t="resa_loading">Chargement…</div></div>
      <div class="urg" id="catUrg" style="margin-top:10px">
        <button data-u="urgent" data-t="urg_urgent">Urgent (demain)</button>
        <button data-u="semaine" class="on" data-t="urg_semaine">Cette semaine</button>
        <button data-u="pas-urgent" data-t="urg_pas_urgent">Pas urgent</button>
      </div>
      <button class="submit" id="catAdd" data-t="cmd_add_sel" style="margin-top:12px">Ajouter la sélection</button>
      <div class="form-err" id="catErr"></div>
    </div>

    <div class="card">
      <div class="f-label" style="margin-top:0" data-t="cmd_off_title">Produit hors liste</div>
      <input class="f-input" id="cProd" data-p="ph_product" style="margin-bottom:9px">
      <div class="times" style="grid-template-columns:1fr 1fr">
        <input class="f-input" id="cQte" data-p="cmd_qty">
        <select class="f-input" id="cCat"></select>
      </div>
      <div class="urg" id="offUrg" style="margin-top:9px">
        <button data-u="urgent" data-t="urg_urgent">Urgent (demain)</button>
        <button data-u="semaine" class="on" data-t="urg_semaine">Cette semaine</button>
        <button data-u="pas-urgent" data-t="urg_pas_urgent">Pas urgent</button>
      </div>
      <label class="photobtn">
        <input type="file" accept="image/*" capture="environment" id="cPhotoInput" hidden>
        <span data-t="cmd_photo">📷 Ajouter une photo</span>
      </label>
      <div id="cPhotoPrev"></div>
      <button class="submit" id="cSave" data-t="cmd_save" style="margin-top:12px">Ajouter à la liste</button>
      <div class="form-err" id="cErr"></div>
    </div>
  </div>
</div>

<!-- confirmation -->
<div class="confirm" id="confirm">
  <div>
    <div class="ok-ring"><svg viewBox="0 0 24 24"><path d="M4.5 12.5l5 5L19.5 7"/></svg></div>
    <h3 data-t="confirm_title">Fiche envoyée</h3>
    <p data-t="confirm_text">Merci — à demain pour le prochain service.</p>
  </div>
</div>

<!-- porte d'entrée -->
<div class="gate" id="gate">
  <div class="gate-card">
    <div class="wordmark">Phoenix <em>Équipe</em></div>
    <div class="lang" id="gateLang">
      <button data-l="fr">FR</button><button data-l="es">ES</button><button data-l="pt">PT</button><button data-l="ar">AR</button>
    </div>
    <div class="gate-sub" data-t="lbl_who">Qui êtes-vous ?</div>
    <div class="who" id="who">
      <button>Clément</button><button>Bouchra</button><button>Omi</button>
    </div>
    <input class="gate-input" id="gateName" data-p="gate_other" placeholder="…ou écris ton prénom">
    <input class="gate-input code" id="gateCode" type="password" autocomplete="off" data-p="gate_code" placeholder="code équipe">
    <input class="gate-input code" id="gatePerso" type="password" autocomplete="off" data-p="gate_new" placeholder="ton code personnel">
    <button class="gate-btn" id="gateBtn" data-t="gate_go">C'est parti</button>
    <div class="gate-err" id="gateErr"></div>
  </div>
</div>

