, dest:l.dest, copie:t('preparation'), titre:'ANNULATION', rappel:true,
    ts:Date.now(), table:tb.ref, couverts:tb.couverts, serveur:MOI?MOI.nom:'', fait:false,
    lignes:[{qte:l.qte, nom:l.nom, opt:{g:motif, r:''}}], allergie:''
  });
  imprimeTicketCuisine(S.tickets[0]);
  majBadge();
}

