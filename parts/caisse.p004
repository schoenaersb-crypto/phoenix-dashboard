0}
.pr-li{display:flex;align-items:center;gap:11px;padding:12px;border:1px solid var(--hair2);
 border-radius:12px;margin-bottom:7px;background:rgba(255,255,255,.02);width:100%;text-align:start}
.pr-li:active{background:rgba(185,141,85,.10)}
.pr-li .c{flex:1;min-width:0}
.pr-li .n{font-size:15px;line-height:1.25}
.pr-li .d{font-size:11.5px;color:var(--ink3);margin-top:2px;line-height:1.3;
 display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.pr-li .p{font-family:var(--mono);font-size:14px;color:var(--gold);flex:none}
.pr-li.rupt{opacity:.42}
.pr-li.rupt .p{color:var(--alert)}
.coeur{color:var(--gold);font-size:11px}
.rech{width:100%;padding:11px 13px;border-radius:11px;border:1px solid var(--hair);
 background:rgba(0,0,0,.2);color:var(--cream);font-family:inherit;font-size:15px;margin-bottom:11px}

/* ── feuille modale ────────────────────────────────────────────── */
.sheet{position:fixed;inset:0;z-index:900;display:none;background:rgba(11,26,36,.72);
 -webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}
.sheet.on{display:block}
.sheet .pan{position:absolute;left:0;right:0;bottom:0;max-height:92vh;overflow-y:auto;
 background:var(--card);border-top:1px solid var(--hair);border-radius:20px 20px 0 0;
 padding:14px 16px calc(18px + var(--safe));animation:up .2s cubic-bezier(.22,.9,.3,1) both}
@keyframes up{from{transform:translateY(24px);opacity:0}to{transform:none;opacity:1}}
.grab{width:38px;height:4px;border-radius:2px;background:var(--hair);margin:0 auto 13px}
.sheet h2{font-family:var(--serif);font-weight:400;font-size:22px;margin:0 0 2px}
.sheet .sub{font-size:12px;color:var(--ink3);margin-bottom:14px}
.lab{font-family:var(--mono);font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;
 color:var(--copper);margin:15px 0 8px}
.lab .oblig{color:var(--alert);letter-spacing:0}
.opts{display:flex;flex-wrap:wrap;gap:7px}
.opt{padding:9px 14px;border-radius:999px;border:1px solid var(--hair);font-size:13.5px;color:var(--ink2)}
.opt.on{background:var(--gold);color:var(--deep);border-color:var(--gold);font-weight:500}
.opt.ret.on{background:var(--alert);border-color:var(--alert);color:#fff}
.nb{display:flex;align-items:center;gap:14px}
.nb button{width:40px;height:40px;border-radius:50%;border:1px solid var(--hair);font-size:20px;
 display:grid;place-items:center;color:var(--gold)}
.nb b{font-family:var(--serif);font-size:26px;min-width:34px;text-align:center}
.inp{width:100%;padding:12px;border-radius:11px;border:1px solid var(--hair);
 background:rgba(0,0,0,.2);color:var(--cream);font-family:inherit;font-size:15px}
.go{width:100%;margin-top:18px;padding:15px;border-radius:14px;background:var(--gold);
 color:var(--deep);font-weight:600;font-size:16px}
.go:disabled{opacity:.4}
.go.sec{background:transparent;border:1px solid var(--hair);color:var(--ink2);margin-top:9px}
.go.dang{background:var(--alert);color:#fff}

/* ── pavé numérique ────────────────────────────────────────────── */
.pave{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:12px}
.pave button{padding:16px 0;border-radius:13px;border:1px solid var(--hair);
 font-family:var(--mono);font-size:22px;color:var(--cream);background:rgba(255,255,255,.03)}
.pave button:active{background:rgba(212,168,67,.2)}
.pave button.eff{color:var(--alert);font-size:17px}
.ecr{font-family:var(--mono);font-size:32px;text-align:center;padding:14px 0 6px;
 color:var(--gold);letter-spacing:.06em;min-height:58px}
.ecr small{display:block;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink3)}

/* ── connexion ─────────────────────────────────────────────────── */
#vLogin{position:fixed;inset:0;z-index:1000;background:var(--deep);display:none;
 flex-direction:column;padding:calc(24px + env(safe-area-inset-top,0px)) 20px calc(20px + var(--safe));
 overflow-y:auto}
#vLogin.on{display:flex}
#vLogin .marque{text-align:center;margin-bottom:8px}
#vLogin .marque b{font-family:var(--serif);font-weight:400;font-size:30px;display:block}
#vLogin .marque span{font-family:var(--mono);font-size:9.5px;letter-spacing:.22em;
 text-transform:uppercase;color:var(--copper)}
#vLogin .qui{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:20px 0 4px}
#vLogin .qui button{padding:11px 18px;border-radius:999px;border:1px solid var(--hair);
 font-size:15px;color:var(--ink2)}
#vLogin .qui button.on{background:var(--gold);border-color:var(--gold);color:var(--deep);font-weight:600}
#vLogin .msg{text-align:center;font-size:13px;min-height:20px;margin-top:10px;color:var(--alert)}
#vLogin .pave{max-width:300px;margin:6px auto 0;width:100%}
#vLogin .lg{display:flex;gap:7px;justify-content:center;margin-top:18px}
#vLogin .lg button{padding:7px 13px;border-radius:999px;border:1px solid var(--hair2);
 font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;color:var(--ink3)}
#vLogin .lg button.on{color:var(--gold);border-color:var(--hair)}

/* ── addition ──────────────────────────────────────────────────── */
.ad-li{display:flex;gap:10px;align-items:center;padding:11px;border:1px solid var(--hair2);
 border-radius:12px;margin-bottom:6px;background:rgba(255,255,255,.02)}
.ad-li.sel{border-color:var(--gold);background:rgba(212,168,67,.12)}
.ad-li .ck{flex:none;width:22px;height:22px;border-radius:6px;border:1px solid var(--hair);
 display:grid;place-items:center;font-size:13px;color:var(--deep)}
.ad-li.sel .ck{background:var(--gold);border-color:var(--gold)}
.ad-li .c{flex:1;min-width:0}
.ad-li .n{font-size:14.5px}
.ad-li .o{font-size:11px;color:var(--ink3);margin-top:2px}
.ad-li .pr{font-family:var(--mono);font-size:13.5px;color:var(--ink2)}
.tot-bloc{border:1px solid var(--hair);border-radius:14px;padding:13px 15px;margin:14px 0;
 background:var(--card2)}
.tot-l{display:flex;justify-content:space-between;align-items:baseline;padding:4px 0;font-size:14px;color:var(--ink2)}
.tot-l b{font-family:var(--mono);color:var(--ink)}
.tot-l.gd{padding-top:11px;margin-top:7px;border-top:1px dashed var(--hair);font-size:16px;color:var(--ink)}
.tot-l.gd b{font-family:var(--serif);font-size:27px;color:var(--gold)}
.tot-l.rem b{color:var(--ok)}
.paie{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:4px}
.paie button{padding:17px 10px;border-radius:14px;border:1px solid var(--hair);font-size:15px;
 display:flex;flex-direction:column;align-items:center;gap:5px}
.paie button i{font-style:normal;font-size:21px}
.paie button.pr-esp{border-color:var(--ok);color:var(--ok)}
.paie button.pr-car{border-color:var(--gold);color:var(--gold)}
.mini{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}
.mini button{flex:1;min-width:104px;padding:11px;border-radius:11px;border:1px solid var(--hair2);
 font-size:12.5px;color:var(--ink2)}

/* ── écrans cuisine / bar ──────────────────────────────────────── */
.tk{border:1px solid var(--hair);border-radius:14px;padding:13px;margin-bottom:11px;background:var(--card2)}
.tk.marche{border-color:var(--gold);background:rgba(212,168,67,.12)}
.tk.rappel{border-color:var(--alert)}
.tk .h{display:flex;align-items:baseline;gap:9px;margin-bottom:9px;padding-bottom:9px;
 border-bottom:1px dashed var(--hair)}
.tk .h b{font-family:var(--serif);font-size:27px;color:var(--gold);line-height:1}
.tk .h .m{font-family:var(--mono);font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink3)}
.tk .h .cp{margin-inline-start:auto;font-family:var(--mono);font-size:9px;letter-spacing:.12em;
 padding:3px 8px;border-radius:999px;border:1px solid var(--hair);color:var(--copper)}
.tk .l{display:flex;gap:9px;padding:4px 0;font-size:14.5px}
.tk .l .q{font-family:var(--mono);color:var(--gold);min-width:20px}
.tk .l em{display:block;font-style:normal;font-weight:600;font-size:12.5px;color:var(--gold);margin-top:1px}
.tk .l em.ret{color:var(--alert)}
.tk .alg{margin:-4px 0 9px;padding:6px 9px;border-radius:8px;background:rgba(196,99,63,.2);
 border:1px solid rgba(196,99,63,.5);font-family:var(--mono);font-size:11px;letter-spacing:.06em;color:#F0B8A0}
.tk .fait{width:100%;margin-top:10px;padding:10px;border-radius:10px;border:1px solid var(--hair);
 color:var(--ok);font-family:var(--mono);font-size:11px;letter-spacing:.1em}
.seg{display:flex;gap:7px;margin-bottom:14px}
.seg button{flex:1;padding:10px;border-radius:11px;border:1px solid var(--hair);font-size:13.5px;color:var(--ink2)}
.seg button.on{background:var(--gold);color:var(--deep);border-color:var(--gold);font-weight:500}

/* ── journée / Z ───────────────────────────────────────────────── */
.blocz{border:1px solid var(--hair2);border-radius:14px;padding:13px 15px;margin-bottom:11px;
 background:rgba(255,255,255,.02)}
.blocz h4{font-family:var(--mono);font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;
 color:var(--copper);margin:0 0 10px}
.zl{display:flex;justify-content:space-between;gap:12px;padding:5px 0;font-size:14px;color:var(--ink2)}
.zl b{font-family:var(--mono);color:var(--ink);white-space:nowrap}
.zl.sub{font-size:12.5px;color:var(--ink3);padding-inline-start:12px}
.hero{text-align:center;padding:6px 0 14px}
.hero b{font-family:var(--serif);font-size:44px;color:var(--gold);display:block;line-height:1}
.hero span{font-family:var(--mono);font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink3)}

/* ── barre du bas ──────────────────────────────────────────────── */
.bar{position:fixed;left:0;right:0;bottom:calc(53px + var(--safe));z-index:500;display:none;gap:9px;
 padding:11px 14px;background:linear-gradient(to top,var(--deep) 78%,rgba(11,30,44,0));align-items:center}
.bar.on{display:flex}
.bar .tot{flex:1;min-width:0}
.bar .tot b{font-family:var(--serif);font-size:23px;color:var(--gold);display:block;line-height:1.05}
.bar .tot span{font-family:var(--mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink3)}
.bar button{flex:none;padding:13px 15px;border-radius:13px;font-weight:600;font-size:14px}
.bar .env{background:var(--gold);color:var(--deep)}
.bar .add{border:1px solid var(--hair);color:var(--gold)}
.bar .fin{border:1px solid rgba(127,163,122,.6);color:var(--ok)}

nav{flex:none;display:flex;border-top:1px solid var(--hair2);background:var(--deep);
 padding-bottom:var(--safe)}
nav button{flex:1;padding:11px 4px 9px;font-family:var(--mono);font-size:9.5px;letter-spacing:.08em;
 text-transform:uppercase;color:var(--ink3)}
nav button.on{color:var(--gold)}
nav button i{display:block;font-style:normal;font-size:17px;margin-bottom:3px}
.badge{display:inline-block;min-width:16px;padding:0 4px;border-radius:9px;background:var(--alert);
 color:#fff;font-size:9px;line-height:16px;margin-inline-start:3px;vertical-align:1px}
#hors{display:none;background:var(--alert);color:#fff;font-family:var(--mono);font-size:10px;
 letter-spacing:.1em;text-transform:uppercase;text-align:center;padding:4px}
#hors.on{display:block}
#pr{position:fixed;width:0;height:0;border:0;left:-9999px;top:0}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style></head>
<body>

<div id="vLogin">
  <div class="marque"><b>Caisse Phoenix</b><span>Brasserie Phoenix</span></div>
  <div class="qui" id="lgQui"></div>
  <div class="ecr" id="lgEcr">····<small id="lgLab">code</small></div>
  <div class="pave" id="lgPave"></div>
  <div class="msg" id="lgMsg"></div>
  <div class="lg" id="lgLangues"></div>
</div>

<div id="hors">hors ligne — les ventes sont gardées ici</div>

<header>
  <button class="back" id="btnBack" style="display:none">‹</button>
  <div class="t"><h1 id="titre">Plan de salle</h1><div class="s" id="soustitre">Brasserie Phoenix</div></div>
  <div class="pill"><b id="kpi1">0</b><span id="kpi1l">couverts</span></div>
  <button class="moi" id="btnMoi">··</button>
</header>

<main>
  <div class="vue on" id="vPlan"></div>

  <div class="vue" id="vTable">
    <div id="cmdListe"></div>
  </div>

  <div class="vue" id="vCarte">
    <input class="rech" id="rech" placeholder="Chercher un produit" autocomplete="off">
    <div class="cats" id="cats"></div>
    <div id="prodListe"></div>
  </div>

  <div class="vue" id="vAdd"><div id="addCorps"></div></div>

  <div class="vue" id="vEcran">
    <div class="seg" id="segEcran">
      <button data-d="cuisine" class="on">Cuisine</button>
      <button data-d="bar">Bar</button>
    </div>
    <div id="tickets"></div>
  </div>

  <div class="vue" id="vJour"><div id="jourCorps"></div></div>
</main>

<div class="bar" id="barBas">
  <div class="tot"><b id="totMt">0,00 €</b><span id="totNb">0 article</span></div>
  <button class="add" id="btnAjouter">+ Carte</button>
  <button class="fin" id="btnAddition">Addition</button>
  <button class="env" id="btnEnvoyer">Envoyer</button>
</div>

<nav>
  <button data-v="plan" class="on"><i>▦</i><span data-t="nav_salle">Salle</span></button>
  <button data-v="ecran"><i>▤</i><span data-t="nav_ecrans">Écrans</span><span class="badge" id="bdg" style="display:none">0</span></button>
  <button data-v="jour"><i>∑</i><span data-t="nav_jour">Journée</span></button>
</nav>

<div class="sheet" id="sheet"><div class="pan" id="pan"></div></div>
<iframe id="pr" title="impression"></iframe>

<script>
/* ══════════════════════════════════════════════════════════════════
   CAISSE PHOENIX — version 2, 31 juillet 2026
   Prise de commande, addition, encaissement, clôture.

   Ce qui a changé depuis la maquette du 30 juillet :
   — tout est gardé sur l'appareil (un rechargement ne perd plus rien),
   — chaque serveur a son profil, et sa connexion vaut pointage,
   — l'addition, l'encaissement et le Z sont dans l'application,
   — quatre langues d'interface, dont l'arabe de droite à gauche.

   Les montants sont manipulés en centimes entiers d'un bout à l'autre.
   Une caisse qui additionne des flottants finit toujours par afficher
   un centime qui n'existe pas.
   ══════════════════════════════════════════════════════════════════ */
var D = {"produits":[{"id":"lunch","nom":"LUNCH du jour","cat":"Lunch","prix":17.35,"desc":"","dest":"cuisine","coeur":1,"ret":[],"mods":[],"alg":["?"],"algv":0},{"id":"carpaccio_de_gambas_rouge_sauce_3cm1","nom":"Carpaccio de gambas rouge, sauce 3CM1","cat":"Entrées","prix":21.9,"desc":"Huile d'olive, zeste de citron et orange, sel noir, poivre","dest":"cuisine","coeur":1,"ret":["Huile d'olive","Zeste de citron","Orange","Sel noir","Poivre"],"mods":[],"alg":["crustaces","lait","?"],"algv":0},{"id":"saint_jacques_snackees_reduction_triple_","nom":"Saint-Jacques snackées, réduction Triple Karmeliet","cat":"Entrées","prix":18.9,"desc":"Saint-Jacques fraîches, sauce Triple Karmeliet, accompagnement du jour","dest":"cuisine","coeur":1,"ret":["Saint-Jacques fraîches","Sauce Triple Karmeliet","Accompagnement du jour"],"mods":[],"alg":["mollusques","gluten","lait","?"],"algv":0},{"id":"carpaccio_de_crevettes","nom":"Carpaccio de crevettes","cat":"Entrées","prix":19.9,"desc":"Huile d'olive, zeste de citron et orange, sel noir, poivre","dest":"cuisine","coeur":0,"ret":["Huile d'olive","Zeste de citron","Orange","Sel noir","Poivre"],"mods":[],"alg":["crustaces"],"algv":0},{"id":"carpaccio_de_boeuf_a_l_italienne","nom":"Carpaccio de boeuf à l'italienne","cat":"Entrées","prix":14.9,"desc":"Viande hachée maison et minute, tomates séchées, mini-billes de mozzarella, huile d'olive parfumée","dest":"cuisine","coeur":0,"ret":["Viande hachée maison","Minute","Tomates séchées","Mini-billes de mozzarella","Huile d'olive parfumée"],"mods":[],"alg":["lait","sulfites"],"algv":0},{"id":"poelee_de_supions_au_chorizo","nom":"Poêlée de supions au chorizo","cat":"Entrées","prix":14.9,"desc":"Supions frits, chorizo","dest":"cuisine","coeur":0,"ret":["Supions frits","Chorizo"],"mods":[],"alg":["mollusques","gluten"],"algv":0},{"id":"tomates_burrata_pesto_de_pistache","nom":"Tomates, burrata & pesto de pistache","cat":"Entrées","prix":13.9,"desc":"Tomates, burrata, pesto de pistache, micro roquette, zeste de fruits","dest":"cuisine","coeur":0,"ret":["Tomates","Burrata","Pesto de pistache","Micro roquette","Zeste de fruits"],"mods":[],"alg":["lait","coque"],"algv":0},{"id":"camembert_roti_au_four_sa_charcuterie","nom":"Camembert rôti au four & sa charcuterie","cat":"Entrées","prix":13.9,"desc":"Camembert, thym, miel, charcuterie","dest":"cuisine","coeur":0,"ret":["Camembert","Thym","Miel","Charcuterie"],"mods":[],"alg":["lait","sulfites","?"],"algv":0},{"id":"melon_jambon_cru_porto","nom":"Melon, jambon cru & porto","cat":"Entrées","prix":12.9,"desc":"Melon, jambon serrano et porto","dest":"cuisine","coeur":0,"ret":["Melon","Jambon serrano","Porto"],"mods":[],"alg":["sulfites"],"algv":0},{"id":"crevettes_frites_quisquillas","nom":"Crevettes frites (quisquillas)","cat":"Entrées","prix":12.1,"desc":"Servies avec une sauce aïoli maison","dest":"cuisine","coeur":0,"ret":[],"mods":[],"alg":["crustaces","oeufs","gluten"],"algv":0},{"id":"huitres","nom":"Huîtres","cat":"Entrées","prix":12.0,"desc":"4 huîtres, oignon dans du vinaigre, yuzu, salade","dest":"cuisine","coeur":0,"ret":["4 huîtres","Oignon dans du vinaigre","Yuzu","Salade"],"mods":[],"note":"supplément coupe de cava +3 €","alg":["mollusques","sulfites"],"algv":0},{"id":"oeuf_mollet_facon_carbonara","nom":"OEuf mollet façon carbonara","cat":"Entrées","prix":10.9,"desc":"Crème légère, lardons croustillants, parmesan, pecorino","dest":"cuisine","coeur":0,"ret":["Crème légère","Lardons croustillants","Parmesan","Pecorino"],"mods":[],"alg":["oeufs","lait"],"algv":0},{"id":"salade_de_la_mer","nom":"Salade de la Mer","cat":"Salades","prix":17.9,"desc":"Gambas snackées, avocat, mangue, coriandre fraîche, vinaigrette yuzu","dest":"cuisine","coeur":1,"ret":["Gambas snackées","Avocat","Mangue","Coriandre fraîche","Vinaigrette yuzu"],"mods":[],"alg":["crustaces","moutarde","sulfites","?"],"algv":0},{"id":"salade_levante","nom":"Salade Levante","cat":"Salades","prix":16.9,"desc":"Thon mi-cuit, orange sanguine, fenouil, olives taggiasche, vinaigrette agrumes","dest":"cuisine","coeur":1,"ret":["Thon mi-cuit","Orange sanguine","Fenouil","Olives taggiasche","Vinaigrette agrumes"],"mods":[],"alg":["poissons","moutarde","sulfites","?"],"algv":0},{"id":"salade_cesar_facon_phoenix","nom":"Salade César façon Phoenix","cat":"Salades","prix":14.9,"desc":"Poulet rôti tranché, anchois, parmesan en copeaux, croûtons maison","dest":"cuisine","coeur":0,"ret":["Poulet rôti tranché","Anchois","Parmesan en copeaux","Croûtons maison"],"mods":[],"alg":["poissons","lait","gluten","oeufs","moutarde"],"algv":0},{"id":"salade_chevre_miel","nom":"Salade chèvre & miel","cat":"Salades","prix":12.9,"desc":"Rondelles de chèvre chaud, miel, salade croquante","dest":"cuisine","coeur":0,"ret":["Rondelles de chèvre chaud","Miel","Salade croquante"],"mods":[],"alg":["lait","moutarde","sulfites","?"],"algv":0},{"id":"salade_grecque","nom":"Salade grecque","cat":"Salades","prix":11.9,"desc":"","dest":"cuisine","coeur":0,"ret":[],"mods":[],"alg":["lait","sulfites","?"],"algv":0},{"id":"