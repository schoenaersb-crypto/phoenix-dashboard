load();
setInterval(load, 5 * 60 * 1000);   /* rafraîchissement toutes les 5 min */
/* Avant : chaque retour dans l'app relancait une requete Apps Script —
   1,5 a 2,6 s d'attente, puis reconstruction complete de l'ecran. Desormais
   on ne redemande le classeur que si la derniere reponse date de plus de
   90 secondes. Les ecritures (reservation, avis, equipe) continuent, elles,
   a rafraichir tout de suite. */
var PAUSE_RETOUR = 90 * 1000;
document.addEventListener('visibilitychange', function(){
  if(document.hidden) return;
  if(Date.now() - DERNIER_CHARGE < PAUSE_RETOUR) return;
  load();
});
</script>
