

var el = function (i) { return document.getElementById(i); };
function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){
  return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
function cts(x){ return Math.round((+x||0)*100); }
function eur(c){ return ((c||0)/100).toFixed(2).replace('.', ',') + ' €'; }
function eurNu(c){ return ((c||0)/100).toFixed(2).replace('.', ','); }
function hhmm(t){ var d=new Date(t); return ('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2); }
function jjmm(t){ var d=new Date(t); return ('0'+d.getDate()).slice(-2)+'/'+('0'+(d.getMonth()+1)).slice(-2); }
function iso(t){ var d=new Date(t); return d.getFullYear()+'-'+('0'+(d.getMonth()+1)).slice(-2)+'-'+('0'+d.getDate()).slice(-2); }
/* Un service qui déborde sur la nuit appartient à la journée de la veille.
   Cinq heures du matin est la coupure : personne ne sert après. */
function jourService(t){ var d=new Date(t||Date.now()); if(d.getHours()<5) d.setDate(d.getDate()-1); return iso(d.getTime()); }

