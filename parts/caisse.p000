<!doctype html>
<html lang="fr" id="htmlRoot"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0B1E2C">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; connect-src 'self' https://script.google.com https://script.googleusercontent.com http://localhost:* http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-inline'; form-action 'none'; base-uri 'none'; object-src 'none'">
<title>Caisse — Brasserie Phoenix</title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Jost:wght@300;400;500;600&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{
 --navy:#16364A; --deep:#0B1E2C; --card:#17394E; --card2:rgba(27,63,85,.55);
 --copper:#B98D55; --gold:#D4A843; --cream:#F6F0E4;
 --ink:var(--cream); --ink2:rgba(246,240,228,.62); --ink3:rgba(246,240,228,.38);
 --ok:#7FA37A; --warn:#D4A843; --alert:#C4633F;
 --hair:rgba(185,141,85,.28); --hair2:rgba(185,141,85,.14);
 --serif:'Cormorant Garamond',Georgia,serif;
 --sans:'Jost',system-ui,-apple-system,sans-serif;
 --mono:'JetBrains Mono',ui-monospace,monospace;
 --safe:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;overscroll-behavior:none}
body{background:var(--deep);color:var(--ink);font-family:var(--sans);font-size:16px;
 -webkit-font-smoothing:antialiased;display:flex;flex-direction:column}
button{font-family:inherit;font-size:inherit;color:inherit;background:none;border:0;cursor:pointer}
.mono{font-family:var(--mono)}
/* Un montant se lit toujours de gauche à droite, même dans une page
   écrite de droite à gauche : sans cela le symbole € passe devant. */
[dir="rtl"] .mono,[dir="rtl"] .hero b,[dir="rtl"] .zl b,[dir="rtl"] .zl.sub span,
[dir="rtl"] .tot-l b,[dir="rtl"] .li .pr,[dir="rtl"] .ad-li .pr,[dir="rtl"] .pr-li .p,
[dir="rtl"] .bar .tot b,[dir="rtl"] .ecr,[dir="rtl"] .tb .m{direction:ltr;unicode-bidi:isolate}

header{flex:none;padding:calc(10px + env(safe-area-inset-top,0px)) 14px 10px;
 border-bottom:1px solid var(--hair2);display:flex;align-items:center;gap:12px;background:var(--deep)}
header .t{flex:1;min-width:0}
header h1{font-family:var(--serif);font-weight:400;font-size:21px;margin:0;line-height:1.15;
 white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
header .s{font-family:var(--mono);font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;
 color:var(--copper);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pill{flex:none;display:flex;align-items:baseline;gap:5px;padding:5px 11px;border-radius:999px;
 border:1px solid var(--hair);background:rgba(185,141,85,.08)}
.pill b{font-family:var(--serif);font-size:19px;color:var(--gold);line-height:1}
.pill span{font-family:var(--mono);font-size:8.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink3)}
.back,.moi{flex:none;width:36px;height:36px;border-radius:50%;border:1px solid var(--hair);
 display:grid;place-items:center;font-size:19px;color:var(--copper)}
.moi{font-family:var(--mono);font-size:12px;font-weight:600;color:var(--gold)}

main{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:14px 14px 96px}
.vue{display:none}.vue.on{display:block}

/* ── plan de salle ─────────────────────────────────────────────── */
.zone{font-family:var(--mono);font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;
 color:var(--copper);margin:16px 0 9px}
.zone:first-child{margin-top:0}
.grille{display:grid;grid-template-columns:repeat(auto-fill,minmax(78px,1fr));gap:9px}
.tb{aspect-ratio:1;border:1px solid var(--hair);border-radius:13px;background:var(--card2);
 display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;
 transition:transform .1s,border-color .15s,background .15s;position:relative}
.tb:active{transform:scale(.95)}
.tb .r{font-family:var(--mono);font-size:14px;font-weight:600}
.tb .p{font-family:var(--mono);font-size:9px;color:var(--ink3)}
.tb .m{font-size:10.5px;color:var(--ink2);margin-top:1px}
.tb .sv{position:absolute;top:5px;right:7px;font-family:var(--mono);font-size:8px;color:var(--copper)}
.tb.occ{border-color:var(--gold);background:rgba(212,168,67,.13)}
.tb.att{border-color:var(--alert);background:rgba(196,99,63,.15)}
.tb.add{border-color:var(--ok);background:rgba(127,163,122,.15)}
.tb.oub{animation:oub 1.6s ease-in-out infinite}
@keyframes oub{0%,100%{box-shadow:0 0 0 0 rgba(196,99,63,0)}50%{box-shadow:0 0 0 4px rgba(196,99,63,.30)}}

/* ── commande ──────────────────────────────────────────────────── */
.svc{margin-bottom:16px}
.svc h3{font-family:var(--mono);font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;
 color:var(--copper);margin:0 0 8px;display:flex;align-items:center;gap:9px}
.svc h3 .etat{font-size:9px;letter-spacing:.08em;padding:2px 7px;border-radius:999px;border:1px solid}
.e-attente{color:var(--alert);border-color:rgba(196,99,63,.5)}
.e-lance{color:var(--ok);border-color:rgba(127,163,122,.5)}
.