nction (txt) { subN.textContent = txt || ''; },
    hide: function () {
      prof = Math.max(0, prof - 1);
      if (prof) return;
      clearTimeout(tShow);
      if (!veil.classList.contains('on')) { coupePatience(); return; }
      /* Une fois visible, on reste 420 ms : mieux vaut une attente franche qu'un clignotement. */
      var reste = Math.max(0, 420 - (Date.now() - tMin));
      setTimeout(ferme, reste);
    },
    raz: function () { prof = 0; clearTimeout(tShow); ferme(); },
    inline: function (el, msg) {
      if (typeof el === 'string') el = document.getElementById(el);
      if (!el) return;
      el.innerHTML = '<div class="phx-inline"><span class="bird phx-bird"></span><span></span></div>';
      el.querySelector('.phx-inline span:last-child').textContent = msg || 'Chargement…';
    }
  };

  /* Le ruban du haut suit le réseau tout seul. Aucun appel existant n'est à modifier. */
  function reseauPlus() {
    reseau++;
    if (reseau === 1) { clearTimeout(tWisp); tWisp = setTimeout(function () { wisp.classList.add('on'); }, 200); }
  }
  function reseauMoins() {
    reseau = Math.max(0, reseau - 1);
    if (!reseau) { clearTimeout(tWisp); wisp.classList.remove('on'); }
  }

  /* Les actions où l'on attend vraiment méritent le voile, et une phrase qui dit
     ce qui se passe. Les autres se contentent du ruban. Le voile est accroché à
     la promesse elle-même : il ne peut donc pas rester ouvert par oubli. */
  var LOURDES = {
    resa_capture:         ['Lecture de la capture', "Je lis l'image et j'en sors les réservations."],
    resa_lot:             ['Ajout des réservations', 'Je vérifie les doublons avant d’écrire.'],
    resa_maj:             ['Enregistrement', null],
    resa_supprimer:       ['Suppression', null],
    resa_statut:          ['Mise à jour', null],
    reservation_manuelle: ['Enregistrement de la réservation', null],
    reserver_public:      ['Envoi de votre réservation', 'Nous vous confirmons par courriel.'],
    club_inscription:     ['Inscription au club', null],
    inscrire:             ['Inscription', null],
    commande:             ['Envoi de la commande', null],
    commande_statut:      ['Mise à jour', null],
    retour:               ['Envoi de votre retour', null],
    avis_reponse:         ['Publication de la réponse', null],
    avis_agent:           ['Rédaction des réponses', 'Cela prend une poignée de secondes.'],
    facture_pdf:          ['Ouverture de la facture', null],
    chat:                 ['Je réfléchis', null]
  };

  function actionDe(args) {
    try {
      var init = args[1];
      if (!init || typeof init.body !== 'string') return null;
      var c = init.body.charAt(0);
      if (c !== '{') return null;
      return JSON.parse(init.body).action || null;
    } catch (e) { return null; }
  }

  if (window.fetch) {
    var brut = window.fetch.bind(window);
    window.fetch = function () {
      var lourd = LOURDES[actionDe(arguments)] || null;
      reseauPlus();
      if (lourd) { PHXload.show(lourd[0]); if (lourd[1]) setTimeout(function(){ PHXload.step(lourd[1]); }, 600); }
      function fini() { reseauMoins(); if (lourd) PHXload.hide(); }
      var p;
      try { p = brut.apply(null, arguments); }
      catch (e) { fini(); throw e; }
      return p.then(function (r) { fini(); return r; },
                    function (e) { fini(); throw e; });
    };
  }

  window.PHX = window.PHX || {};
  window.PHX.load = PHXload;
})();
</script>
<!-- ══ fin PHX-LOADER ══ -->

</body>
</html>
