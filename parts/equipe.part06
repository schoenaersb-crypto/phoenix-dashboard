/* catalogue : recherche + cases + quantités */
var CATALOGUE = null;
renderCatList();
function loadCatalogue(){
  post({ action:'catalogue' })
    .then(function(j){ CATALOGUE = j.catalogue || []; renderCatList(); })
    .catch(function(){ CATALOGUE = []; renderCatList(); });
}
/* La sélection survit aux plis/déplis et à la recherche : elle vit
   dans SEL, pas dans le DOM. */
var SEL = {};        /* nom → {u, f, qte} */
var OUVERTS = {};    /* sections dépliées */
function extrasClasseur(){
  var connus = {};
  FICHE.forEach(function(sec){ sec.items.forEach(function(i){ connus[i[0].toLowerCase()] = 1; }); });
  return (CATALOGUE || []).filter(function(p){
    /* seuls les vrais produits du classeur, jamais les charges */
    return String(p.type||'').toLowerCase() === 'produit'
        && !connus[String(p.produit||'').toLowerCase()];
  });
}
function ligneCat(nom, u, f){
  var sel = SEL[nom];
  return '<div class="cat-row"><input type="checkbox" data-prod="'+esc(nom)+'" data-unit="'+esc(u||'')+'" data-f="'+esc(f||'')+'"'+(sel?' checked':'')+'>'
    + '<div class="cname">'+esc(nom)+(u?' <span class="cunit">/ '+esc(u)+'</span>':'')
    + (f?'<span class="cfour">'+esc(f)+'</span>':'')+'</div>'
    + '<input class="f-input cqty" inputmode="text" placeholder="'+esc(t('cmd_qty'))+'" data-q="'+esc(nom)+'" value="'+esc(sel&&sel.qte||'')+'"></div>';
}
function renderCatList(){
  var box = el('catList');
  var q = (el('catSearch').value||'').trim().toLowerCase();
  var h = '', trouve = false;
  FICHE.forEach(function(sec, si){
    var items = sec.items.filter(function(i){
      return !q || (i[0]+' '+(i[2]||'')+' '+sec.s).toLowerCase().indexOf(q)>-1;
    });
    if(!items.length) return;
    trouve = true;
    var nSel = sec.items.filter(function(i){ return SEL[i[0]]; }).length;
    var open = q ? true : !!OUVERTS[si];
    h += '<div class="cat-sec'+(open?' on':'')+'" data-sec="'+si+'"><b>'+esc(sec.s)+'</b>'
       + '<span>'+(nSel? nSel+' ✓ · ':'')+items.length+'</span></div>';
    if(open) h += items.map(function(i){ return ligneCat(i[0], i[1], i[2]); }).join('');
  });
  var extra = extrasClasseur().filter(function(p){
    return !q || (p.produit+' '+(p.categorie||'')).toLowerCase().indexOf(q)>-1;
  });
  if(extra.length){
    trouve = true;
    var open = q ? true : !!OUVERTS['x'];
    h += '<div class="cat-sec'+(open?' on':'')+'" data-sec="x"><b>'+esc(t('cmd_extras'))+'</b><span>'+extra.length+'</span></div>';
    if(open) h += extra.map(function(p){ return ligneCat(p.produit, p.unite||'', p.fournisseur||''); }).join('');
  }
  box.innerHTML = trouve ? h : '<div class="cat-empty">'+t('cmd_no_match')+'</div>';
}
el('catList').addEventListener('click', function(ev){
  var sec = ev.target.closest('.cat-sec');
  if(sec){ OUVERTS[sec.dataset.sec] = !OUVERTS[sec.dataset.sec]; renderCatList(); }
});
el('catList').addEventListener('change', function(ev){
  var cb = ev.target;
  if(cb.matches('input[type=checkbox]')){
    if(cb.checked) SEL[cb.dataset.prod] = { u:cb.dataset.unit, f:cb.dataset.f,
      qte:(SEL[cb.dataset.prod]||{}).qte||'' };
    else delete SEL[cb.dataset.prod];
  }
});
el('catList').addEventListener('input', function(ev){
  var inp = ev.target;
  if(inp.matches('.cqty')){
    var nom = inp.dataset.q;
    if(!SEL[nom]){
      var cb = el('catList').querySelector('input[data-prod="'+(window.CSS&&CSS.escape?CSS.escape(nom):nom)+'"]');
      SEL[nom] = { u:cb?cb.dataset.unit:'', f:cb?cb.dataset.f:'', qte:'' };
      if(cb) cb.checked = true;
    }
    SEL[nom].qte = inp.value.trim();
  }
});
el('catSearch').addEventListener('input', renderCatList);
el('catUrg').querySelectorAll('button').forEach(function(b){
  b.addEventListener('click', function(){ el('catUrg').querySelectorAll('button').forEach(function(x){x.classList.remove('on')}); b.classList.add('on'); });
});
el('catAdd').addEventListener('click', function