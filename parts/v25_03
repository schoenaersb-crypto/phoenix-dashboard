

/* ─── ÉQUIPE : la grille des heures ─────────────────────────────── */
.eq-nav{display:flex;align-items:center;gap:10px;margin-bottom:14px}
.eq-nav button{
  background:transparent;border:1px solid var(--hair);color:var(--gold);
  width:32px;height:32px;border-radius:9px;font-size:17px;line-height:1;cursor:pointer;flex:none;
  font-family:var(--sans)
}
.eq-nav button:disabled{opacity:.28;cursor:default}
.eq-titre{flex:1;text-align:center;line-height:1.25}
.eq-titre b{display:block;font-size:14.5px;font-weight:400}
.eq-titre span{display:block;font-size:11px;color:var(--ink-3);letter-spacing:.04em}

.eq-kpi{display:flex;gap:8px;margin-bottom:14px}
.eq-kpi div{
  flex:1;text-align:center;padding:9px 4px;border-radius:12px;
  background:rgba(212,168,67,.07);border:1px solid var(--hair-soft)
}
.eq-kpi b{display:block;font-family:var(--mono);font-size:15px;color:var(--gold);font-weight:500}
.eq-kpi span{display:block;font-size:10px;color:var(--ink-3);margin-top:2px;letter-spacing:.03em}

.eq-grid{display:grid;grid-template-columns:58px repeat(7,1fr);gap:3px;align-items:stretch}
.eq-gh{
  font-size:10.5px;color:var(--ink-3);text-align:center;padding:2px 0 5px;
  letter-spacing:.06em;line-height:1.2
}
.eq-gh span{display:block;font-family:var(--mono);font-size:9.5px;opacity:.6}
.eq-gh.we{color:var(--copper)}
.eq-nom{
  font-size:12px;display:flex;align-items:center;padding-right:4px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis
}
.eq-nom.tot{color:var(--copper);font-size:11px;letter-spacing:.05em}
.eq-c{
  position:relative;border-radius:8px;background:rgba(212,168,67,.1);
  min-height:40px;display:flex;flex-direction:column;align-items:center;justify-content:center;
  cursor:pointer;transition:background .15s;padding:4px 1px 6px
}
.eq-c.we{background:rgba(185,141,85,.13)}
.eq-c:hover,.eq-c:focus{background:rgba(212,168,67,.22);outline:none}
.eq-c b{font-family:var(--mono);font-size:12.5px;font-weight:500;color:var(--cream)}
.eq-c.vide{background:transparent;color:var(--ink-3);font-size:12px;cursor:default;border:1px dashed var(--hair-soft)}
.eq-c.vide:hover{background:transparent}
.eq-c.tot{background:transparent;border-top:1px solid var(--hair-soft);border-radius:0;
  min-height:28px;cursor:default}
.eq-c.tot,.eq-c.tot b{font-family:var(--mono);font-size:11.5px;color:var(--copper)}
.eq-c.pb{box-shadow:inset 0 0 0 1px var(--warn)}
/* le trait midi / soir sous le chiffre */
.eq-c i{display:block;width:76%;height:4px;border-radius:2px;background:var(--gold);margin-top:4px;overflow:hidden}
.eq-c i u{display:block;height:100%;background:#8E6B3F;text-decoration:none}
/* le point qui dit « en poste en ce moment » */
.eq-c s{position:absolute;top:4px;right:4px;width:5px;height:5px;border-radius:50%;
  background:var(--ok);text-decoration:none}

.eq-leg{display:flex;flex-wrap:wrap;gap:11px;margin-top:11px;font-size:10.5px;color:var(--ink-3);align-items:center}
.eq-leg span{display:flex;align-items:center;gap:4px}
.eq-leg i.lg{width:11px;height:3px;border-radius:2px;display:inline-block}
.eq-leg i.midi{background:#8E6B3F}
.eq-leg i.soir{background:var(--gold)}
.eq-leg i.pb{background:transparent;box-shadow:inset 0 0 0 1px var(--warn);height:9px;width:9px;border-radius:3px}
.eq-astuce{font-style:italic;opacity:.7;flex-basis:100%;margin-top:1px}

.eq-actions{display:flex;align-items:center;gap:10px;margin-top:13px;
  padding-top:11px;border-top:1px solid var(--hair-soft)}
.eq-actions button{
  background:transparent;border:1px solid var(--hair);color:var(--gold);
  border-radius:8px;padding:5px 11px;font-family:var(--sans);font-size:11.5px;cursor:pointer
}
.eq-actions span{font-size:10.5px;color:var(--ink-3)}

.eq-seance{display:flex;flex-wrap:wrap;gap:8px;align-items:baseline;margin-top:5px;font-size:12.5px}
.eq-seance .h{font-family:var(--mono);color:var(--ink)}
.eq-seance .h em{font-style:normal;color:var(--ok)}
.eq-seance .d{font-family:var(--mono);color:var(--ink-2);font-size:11.5px}
.eq-seance .s{
  font-size:10px;letter-spacing:.05em;padding:1px 6px;border-radius:20px;
  background:rgba(185,141,85,.2);color:var(--copper)
}
.eq-seance .s.soir{background:rgba(212,168,67,.18);color:var(--gold)}
.eq-seance .s.journee{background:rgba(127,163,122,.18);color:var(--ok)}
.eq-seance .s.pb{background:rgba(212,168,67,.18);color:var(--warn)}

.eq-sous{font-size:11px;color:var(--ink-3);margin-top:4px}
.eq-ct{
  background:transparent;border:1px solid var(--hair-soft);color:var(--ink-3);
  border-radius:20px;padding:0 7px;font-family:var(--sans);font-size:10px;cursor:pointer;
  margin-left:5px;vertical-align:1px
}
.eq-ct:hover{border-color:var(--hair);color:var(--gold)}

@media (max-width:360px){
  .eq-grid{grid-template-columns:46px repeat(7,1fr);gap:2px}
  .eq-c b{font-size:11.5px}
  .eq-nom{font-size:11px}
}

/* la ligne du rendement : ce qu'une heure de travail a rapporté ce jour-là */
.eq-nom.sub{color:var(--ink-3);font-size:10.5px;letter-spacing:.04em}
/* v23 — choisir qui apparait dans le tableau */
.eq-qui{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 12px}
.eq-chip{background:transparent;border:1px solid var(--hair-soft);color:var(--ink-2);
  font-family:inherit;font-size:12px;padding:5px 11px;border-radius:999px;cursor:pointer;
  transition:border-color .15s,color .15s,background .15s}
.eq-chip:hover{border-color:var(--hair);color:var(--cream)}
.eq-chip.on{border-color:var(--gold);color:var(--gold);background:rgba(212,168,67,.10)}
.eq-c b.inc{color:var(--warn)}
/* une case nourrie par la fiche de fin de service, pas par la pointeuse */
.eq-c.dec{background:transparent;box-shadow:inset 0 0 0 1px var(--hair-soft)}
.eq-c.dec i{opacity:.55}
.eq-leg i.dec{background:transparent;box-shadow:inset 0 0 0 1px var(--hair);height:9px;width:9px;border-radius:3px}
.eq-note{font-size:11.5px;color:var(--ink-3);margin-top:8px;line-height:1.5}
.eq-c.sub{background:transparent;min-height:22px;cursor:default;
  font-family:var(--mono);font-size:10.5px;color:var(--ink-3);padding:0}
.eq-c.sub.we{background:transparent}
</style>
</head>

<body>
<div class="ambient" aria-hidden="true"></div>

