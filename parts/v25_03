<script>
/* ═══════════════════════════════════════════════════════
   CONFIGURATION — colle ici l'URL de ton Apps Script
   (ou ouvre la page avec ?api=TON_URL pour tester)
   ═══════════════════════════════════════════════════════ */
var CONFIG = {
  API_URL: "https://script.google.com/macros/s/AKfycbw4M6kbboHLRlj84PoO3CdrxcuxKKxlpq-CWph5V3meq4pwISTZ8PZJIK5cCerTxD0PLQ/exec"
};

/* SECURITE : la surcharge par ?api= a été retirée le 30/07/2026. Elle permettait
   à un lien piégé portant le vrai domaine de détourner les envois — et donc les
   codes — vers un serveur étranger. L'adresse de production est la seule valable. */
var API = CONFIG.API_URL;

var DATA = null;
var HISTORY = [];
/* v22 — reactivite : on ne redessine que si les donnees ont bouge,
   et on ne redemande pas le classeur a chaque retour dans l'app. */
var DERNIER_CHARGE = 0;
var EMPREINTE = '';
function empreinteDe(j){
  /* l'heure de generation change a chaque reponse : on la retire avant de
     comparer, sinon rien ne serait jamais 'identique'. */
  try {
    var t = JSON.stringify(j), i = t.indexOf('"genere"');
    if(i >= 0){ var f = t.indexOf(',', i); if(f > i) t = t.slice(0, i) + t.slice(f + 1); }
    return t;
  } catch(_) { return String(Math.random()); }
}
var ADMIN = '';
try { ADMIN = localStorage.getItem('phx_admin') || ''; } catch(_){}
function askGate(msg){
  el('gateErr').textContent = msg || '';
  el('gate').classList.add('on');
  setTimeout(function(){ el('gateInput').focus(); }, 120);
}
function gateSubmit(){
  var v = el('gateInput').value.trim();
  if(!v) return;
  ADMIN = v;
  try { localStorage.setItem('phx_admin', v); } catch(_){}
  el('gate').classList.remove('on');
  el('gateInput').value = '';
  load();
}
var REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
var EUR  = new Intl.NumberFormat('fr-FR',{style:'currency',currency:'EUR',maximumFractionDigits:0});
var EUR2 = new Intl.NumberFormat('fr-FR',{style:'currency',currency:'EUR',minimumFractionDigits:2});

/* ─── utilitaires ─────────────────────────────────── */
function esc(s){
  return String(s==null?'':s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function el(id){return document.getElementById(id)}

function stars(n){
  var v = Math.round(Number(n)||0), s='';
  for(var i=0;i<5;i++) s += (i<v?'★':'·');
  return s;
}
function feel(n){
  var v = Math.round(Number(n)||0);
  var cls = v>=4?'ok':(v>=3?'warn':'alert');
  var h = '<span class="feel '+cls+'" aria-hidden="true">';
  for(var i=1;i<=5;i++) h += '<i class="'+(i<=v?'f':'')+'"></i>';
  return h+'</span>';
}
function glyph(path){
  return '<div class="glyph"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">'+path+'</svg></div>';
}
function stateBlock(icon, titre, texte){
  return '<div class="state">'+glyph(icon)+'<strong>'+esc(titre)+'</strong>'+texte+'</div>';
}

/* compteur animé — chiffres, jamais colorés données */
function countUp(node, target, fmt){
  if(REDUCED || target === 0){ node.textContent = fmt(target); return; }
  var t0 = null, dur = 750;
  function step(ts){
    if(!t0) t0 = ts;
    var p = Math.min((ts - t0)/dur, 1);
    var e = 1 - Math.pow(1-p, 3);
    node.textContent = fmt(target * e);
    if(p < 1) requestAnimationFrame(step);
    else node.textContent = fmt(target);
  }
  requestAnimationFrame(step);
}
function animateFigures(root){
  root.querySelectorAll('[data-count]').forEach(function(n){
    var v = parseFloat(n.getAttribute('data-count')) || 0;
    var kind = n.getAttribute('data-fmt');
    var fmt = kind==='eur' ? function(x){return EUR.format(x)}
            : kind==='dec' ? function(x){return x.toFixed(2)}
            : function(x){return String(Math.round(x))};
    countUp(n, v, fmt);
  });
  root.querySelectorAll('.meter i').forEach(function(m){
    var w = m.getAttribute('data-w');
    requestAnimationFrame(function(){ m.style.width = w + '%'; });
  });
}

/* ─── en-tête : date + statut + synchro ───────────── */
function paintHeader(){
  var d = new Date();
  var jours = ['dimanche','lundi','mardi','mercredi','jeudi','vendredi','samedi'];
  el('stampDate').textContent = jours[d.getDay()] + ' ' +
    d.toLocaleDateString('fr-FR',{day:'2-digit',month:'long'});

  /* horaires été 2026 : jeudi→mardi dès 18h, fermé mercredi, + dimanche midi */
  var jour = d.getDay(), h = d.getHours();
  var ferme = (jour === 3);
  var enService = !ferme && (h >= 18 || (jour === 0 && h >= 12 && h < 16));

  el('dot').className = 'dot' + (enService ? '' : ' closed');
  el('serviceState').textContent =
    ferme ? 'Fermé — mercredi' : (enService ? 'En service' : 'Hors service');
}

/* ─── chargement des données ──────────────────────── */
/* rendu blindé : une section qui casse n'entraîne plus les autres */
function renderTout(){
  var j = DATA;
  el('stampSync').textContent = (j.genere ? ('synchro ' + String(j.genere).slice(11,16)) : '') + ' · 