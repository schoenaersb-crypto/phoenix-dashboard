  function cpt(etat){ return toutes.filter(function(l){ return l.etat === etat; }).length; }
  var nbImp = f.nbImpaye != null ? f.nbImpaye : cpt('Impayée');
  var nbDou = f.nbDouteux != null ? f.nbDouteux : cpt('À vérifier');
  var nbEch = f.nbEcheancier != null ? f.nbEcheancier : cpt('Échéancier');
  var sansPdf = f.sansPdf != null ? f.sansPdf : toutes.filter(function(l){ return !l.fichier; }).length;
  var mImp = f.montantImpaye || 0, mDou = f.montantDouteux || 0, mEch = f.montantEcheancier || 0;

  var h = '<div class="duo">'
    + '<div class="card"><div class="card-label">Reste à payer</div>'
    + '<div class="figure"><span data-count="'+mImp+'" data-fmt="eur">'+EUR.format(0)+'</span></div>'
    + ((mImp>0)?'<span class="tag alert">'+nbImp+' facture'+(nbImp>1?'s':'')+'</span>':'<span class="tag ok">rien en attente</span>')
    + '</div>'
    + '<div class="card"><div class="card-label">À vérifier</div>'
    + '<div class="figure"><span data-count="'+mDou+'" data-fmt="eur">'+EUR.format(0)+'</span></div>'
    + ((nbDou>0)?'<span class="tag warn">'+nbDou+' en doute</span>':'<span class="tag ok">tout est tracé</span>')
    + '</div>'
    + '</div>';

  if(nbEch){
    h += '<div class="card" style="margin-top:12px"><div class="card-label">Échéanciers en cours</div>'
      + '<div class="figure"><span data-count="'+mEch+'" data-fmt="eur">'+EUR.format(0)+'</span>'
      + '<span class="unit">· '+nbEch+' facture'+(nbEch>1?'s':'')+'</span></div>'
      + '<div class="row-meta" style="margin-top:4px">Dettes en cours de remboursement par versements — visibles dans le relevé.</div></div>';
  }

  h += '<div class="card" style="margin-top:12px"><div class="card-label">Achats du mois</div>'
    + '<div class="figure"><span data-count="'+(f.totalMois||0)+'" data-fmt="eur">'+EUR.format(0)+'</span>'
    + '<span class="unit">· '+nbTotal+' facture'+(nbTotal>1?'s':'')+' en base</span></div></div>';

  if(f.impayeParFournisseur && f.impayeParFournisseur.length){
    var maxI = f.impayeParFournisseur[0].total || 1;
    h += '<div class="card" style="margin-top:12px"><div class="card-label">Ce qui reste dû, par fournisseur</div>';
    f.impayeParFournisseur.forEach(function(p){
      var w = Math.max(4, Math.round((p.total/maxI)*100));
      h += '<div class="frow">'
        + '<div class="frow-top"><span class="frow-name">'+esc(p.nom)
        + (p.nb ? ' <span class="fnb">'+p.nb+' fact.</span>' : '') + '</span>'
        + '<span class="frow-val">'+EUR2.format(p.total||0)+'</span></div>'
        + '<div class="fbar-track"><div class="fbar-fill alert" style="width:'+w+'%"></div></div>'
        + (p.variantes ? '<div class="fvar">regroupe : '+esc(p.variantes.join(' · '))+'</div>' : '')
        + '</div>';
    });
