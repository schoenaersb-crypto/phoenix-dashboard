  var fp = el('facPlus');
  if(fp) fp.addEventListener('click', function(){ F_LIMITE += 30; renderFactures(); });
}

/* ─── accès admin aux documents : le PDF passe par le backend, jamais par un lien Drive public ─── */
var PDF_CACHE = {};
function ouvrirPdf(id, lien){
  if(PDF_CACHE[id]){ window.open(PDF_CACHE[id], '_blank'); return; }
  var libelle = lien ? lien.textContent : '';
  if(lien) lien.textContent = '⏳ ouverture…';
  fetch(API, { method:'POST', cache:'no-store', headers:{'Content-Type':'text/plain;charset=utf-8'},
    body: JSON.stringify({ action:'facture_pdf', code: ADMIN, id: id }) })
    .then(function(r){ return r.json(); })
    .then(function(j){
      if(lien) lien.textContent = libelle;
      if(!j || j.ok === false) throw new Error((j && j.error) || 'refusé');
      var bin = atob(j.b64), n = bin.length, oct = new Uint8Array(n);
      for(var i=0;i<n;i++) oct[i] = bin.charCodeAt(i);
      var url = URL.createObjectURL(new Blob([oct], {type: j.mime || 'application/pdf'}));
      PDF_CACHE[id] = url;
      window.open(url, '_blank');
    })
    .catch(function(e){
      if(lien){ lien.textContent = libelle; }
      alert('Impossible d\'ouvrir le document : ' + e.message);
    });
}

