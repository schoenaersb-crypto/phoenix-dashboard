    + '</div>';

  h += '<div class="card" style="margin-top:12px"><div class="card-label">Derniers avis</div>';
  a.lignes.forEach(function(r){
    h += '<div class="row"><div class="row-main">'
      + '<div class="stars">' + stars(r.note) + '</div>'
      + '<div class="row-title" style="margin-top:4px">' + esc(r.auteur||'Anonyme')
      + ' <span style="color:var(--ink-3);font-size:12px">· ' + esc(r.plateforme||'') + ' · ' + esc(r.date||'') + '</span></div>'
      + (r.extrait ? '<div class="row-meta">' + esc(r.extrait) + '</div>' : '')
      + (r.repondu ? '' : '<span class="tag warn">à répondre</span>')
      + '</div></div>';
  });
  h += '</div>';
  root.innerHTML = h;
  animateFigures(root);
  chargerAvisAReponse();
