/* ─── le bloc des heures, chargé à part ──────────────────────────── */
function eqRendHeures() {
  var zone = el('eq-heures');
  if (!zone) return;
  var lundi = eqLundi(EQ_OFF);
  var dimanche = eqPlus(lundi, 6);
  var depuis = eqISO(lundi), jusqu = eqISO(dimanche);

  eqCharge(depuis, jusqu, function (j) {
    if (!j) { zone.innerHTML = eqReplis(); eqLieNav(zone); return; }
    var f = eqFusion(j.seances || [], j.declare || []);
    EQ_DONNEES = { seances: f.seances, anomalies: j.anomalies, ecarts: f.ecarts };
    var seances = f.seances;
    var tous = eqNomsTous(seances);
    /* un nom disparu de la semaine ne doit pas rester coché en silence */
    EQ_QUI = EQ_QUI.filter(function (n) { return tous.indexOf(n) >= 0; });
    var vues = EQ_QUI.length
      ? seances.filter(function (s) { return EQ_QUI.indexOf(s.nom) >= 0; })
      : seances;
    var caJour = eqCaSemaine(lundi);
    var g = eqGrille(vues, lundi, EQ_QUI.length ? null : caJour);
    var totMin = g.parJour.reduce(function (s, x) { return s + x; }, 0);
    /* Filtrer sur une personne fausserait un €/h calculé sur le CA de
       toute la maison : on ne montre le rendement que sur l'équipe entière. */
    var r = EQ_QUI.length ? { ca: 0, couverts: 0, jours: 0, heures: totMin / 60, parHeure: 0, minParCouvert: 0 }
      : eqRendement(totMin, lundi);

    var titre = 'Semaine du ' + lundi.getDate()
      + (lundi.getMonth() !== dimanche.getMonth() ? ' ' + MOIS_LONG[lundi.getMonth()] : '')
      + ' au ' + dimanche.getDate() + ' ' + MOIS_LONG[dimanche.getMonth()];

    var h = '<div class="card">';
    h += '<div class="eq-nav">'
      + '<button data-eq="prev" aria-label="Semaine précédente">‹</button>'
      + '<div class="eq-titre"><b>' + titre + '</b><span>'
      + (EQ_OFF === 0 ? 'semaine en cours' : 'il y a ' + EQ_OFF + (EQ_OFF > 1 ? ' semaines' : ' semaine'))
      + '</span></div>'
      + '<button data-eq="next"' + (EQ_OFF === 0 ? ' disabled' : '') + ' aria-label="Semaine suivante">›</button>'
      + '</div>';

    if (!seances.length) {
      h += '<div class="row"><div class="row-main"><div class="row-meta">'
        + 'Aucune heure cette semaine-là : ni fiche de fin de service, ni pointage.'
        + '</div></div></div></div>';
      zone.innerHTML = h;
      eqLieNav(zone);
      return;
    }

    h += eqPastilles(tous);
    /* Les deux ratios de l'en-tête reposent sur le total des heures. Si
       une seule journée de la semaine a une sortie manquante, ce total est
       faux : on préfère ne rien annoncer plutôt qu'annoncer à côté. */
    var netteSemaine = g.sur.every(function (x, i) { return x || !g.parJour[i]; });
    h += '<div class="eq-kpi">'
      + '<div><b>' + (netteSemaine ? eqHM(totMin) : '≈ ' + eqHM(totMin)) + '</b><span>travaillées</span></div>'
      + (r.ca && netteSemaine ? '<div><b>' + Math.round(r.parHeure) + ' €</b><span>de CA par heure</span></div>' : '')
      + (r.couverts && netteSemaine ? '<div><b>' + eqDuree(r.minParCouvert) + '</b><span>par couvert</span></div>'
        : '<div><b>' + g.noms.length + '</b><span>en poste</span></div>')
      + '</div>';

    h += g.html;
    var nbDec = seances.filter(function (s) { return s.source === 'declare'; }).length;
    h += '<div class="eq-actions"><button data-eq="copier">Copier le tableau</button>'
      + '<span>' + seances.length + (seances.length > 1 ? ' entrées' : ' entrée')
      + (nbDec ? ' · ' + nbDec + ' venant des fiches' : '')
      + ' · à conserver 4 ans</span></div>';
    h += '</div>';

    if (EQ_JOUR && EQ_JOUR >= depuis && EQ_JOUR <= jusqu) {
      h += eqDetailJour(vues, EQ_JOUR, eqVenteDu(EQ_JOUR));
    }
    h += eqParPersonne(g.par, g.noms);
    h += eqEtat(seances, vues, lundi);
    h += eqDoubles(f.doubles);
    h += eqEcarts(f.ecarts);
    h += eqAnomalies(j.anomalies);

    zone.innerHTML = h;
    eqLieNav(zone);
  });
}

/* Quand le backend ne connaît pas encore la route : on ne laisse pas
   un écran vide, on affiche ce qu'on a et on dit ce qui manque. */
function eqReplis() {
  var profils = DATA.profils || [];
  var h = '<div class="card"><div class="card-label">Heures prestées</div>';
  if (profils.length) {
    var maxT = Math.max.apply(null, profils.map(function (p) { return p.total || 0; })) || 1;
    profils.forEach(function (p) {
      var sous = [];
      if (p.semaine) sous.push(p.semaine + ' h cette semaine');
      if (p.dernier) sous.push('dernier service ' + esc(p.dernier));
      else if (p.inscrit) sous.push('inscrit le ' + esc(p.inscrit));
      h += '<div class="meter-row"><div class="meter-head">'
        + '<span class="meter-name">' + esc(p.nom) + '</span>'
        + '<span class="meter-val">' + (p.total || 0) + ' h</span></div>'
        + '<div class="meter"><i style="width:' + Math.round((p.total || 0) / maxT * 100) + '%"></i></div>'
        + (sous.length ? '<div class="eq-sous">' + sous.join(' · ') + '</div>' : '')
        + '</div>';
    });
  }
  h += '<div class="row" style="border-top:1px solid var(--hair-soft);margin-top:8px">'
    + '<div class="row-main"><div class="row-meta">'
    + 'Le détail jour par jour n\'est pas accessible en ce moment : le classeur ne '
    + 'répond pas sur <code>caisse_heures</code>. D\'ici là, seul le cumul s\'affiche.'
    + '</div></div></div>';
  return h + '</div>';
}

function eqLieNav(zone) {
  zone.querySelectorAll('[data-eq]').forEach(function (b) {
    b.addEventListener('click', function () {
      var q = b.getAttribute('data-eq');
      if (q === 'prev') { EQ_OFF++; EQ_JOUR = null; eqRendHeures(); }
      else if (q === 'next') { if (EQ_OFF > 0) { EQ_OFF--; EQ_JOUR = null; eqRendHeures(); } }
      else if (q === 'copier') {
        var txt = eqExport((EQ_DONNEES && EQ_DONNEES.seances) || [], eqLundi(EQ_OFF));
        var fait = function () { b.textContent = 'Copié'; setTimeout(function () { b.textContent = 'Copier le tableau'; }, 1600); };
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(txt).then(fait, function () { });
        else {
          var t = document.createElement('textarea');
          t.value = txt; document.body.appendChild(t); t.select();
          try { document.execCommand('copy'); fait(); } catch (e) { }
          document.body.removeChild(t);
        }
      }
    });
  });
  zone.querySelectorAll('[data-eqqui]').forEach(function (b) {
    b.addEventListener('click', function () {
      var n = b.getAttribute('data-eqqui');
      if (n === '*') EQ_QUI = [];
      else {
        var i = EQ_QUI.indexOf(n);
        if (i >= 0) EQ_QUI.splice(i, 1); else EQ_QUI.push(n);
      }
      eqQuiGarde();
      eqRendHeures();
    });
  });
  zone.querySelectorAll('[data-eqj]').forEach(function (c) {
    var ouvre = function () {
      var j = c.getAttribute('data-eqj');
      EQ_JOUR = (EQ_JOUR === j) ? null : j;
      eqRendHeures();
    };
    c.addEventListener('click', ouvre);
    c.addEventListener('keydown', function (ev) {
      if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); ouvre(); }
    });
  });
  zone.querySelectorAll('[data-eqct]').forEach(function (b) {
    b.addEventListener('click', function (ev) {
      ev.stopPropagation();
      var n = b.getAttribute('data-eqct');
      var v = prompt('Heures contractuelles par semaine pour ' + n + ' ?\n(laisser vide pour retirer)', eqContrat(n) || '');
      if (v === null) return;
      eqContrat(n, v.trim() ? Number(String(v).replace(',', '.')) : 0);
      eqRendHeures();
    });
  });
}


/* ─── accès de l'équipe : c'est le patron qui ouvre les profils ───
   L'auto-inscription a été retirée du backend le 31/07/2026 : un prénom
   était un champ libre, donc le code équipe suffisait à se fabriquer une
   identité, et un départ ne fermait rien. Ici, désactiver ferme vraiment. */
var PROFILS_ACCES = null;

function accesBloc(){
  var h = '<div class="card"><div class="card-h"><span class="card-t">Accès de l\'équipe</span></div>'
        + '<div id="accList"><div class="row-meta">Chargement…</div></div>'
        + '<div class="acc-form">'
        +   '<input id="accNom" maxlength="30" placeholder="Prénom" autocomplete="off">'
        +   '<input id="accCode" maxlength="40" placeholder="Code personnel (8 min.)" autocomplete="off">'
        +   '<button id="accAdd">Ouvrir le profil</button>'
        + '</div>'
        + '<div class="acc-msg" id="accMsg"></div>'
        + '<div class="acc-note">Désactiver ferme l\'accès tout de suite, même si le code est connu — '
        + 'c\'est ce qu\'il faut faire quand quelqu\'un s\'en va. Supprimer efface la ligne.</div>'
        + '</div>';
  return h;
}

function accesCharge(){
  if(!el('accList')) return;
  accesPost({ action:'equipe_liste' })
    .then(function(j){ PROFILS_ACCES = j.profils || []; accesRend(); })
    .catch(function(){ el('accList').innerHTML = '<div class="row-meta">Liste indisponible.</div>'; });
}

function accesRend(){
  var box = el('accList'); if(!box) return;
  if(!PROFILS_ACCES || !PROFILS_ACCES.length){
    box.innerHTML = '<div class="row-meta">Aucun profil. Ouvre le premier ci-dessous.</div>'; return;
  }
  box.innerHTML = PROFILS_ACCES.map(function(p){
    return '<div class="acc-li' + (p.actif ? '' : ' off') + '">'
      + '<span class="acc-dot ' + (p.actif ? 'ok' : 'no') + '"></span>'
      + '<div class="c"><div class="n">' + esc(p.prenom) + '</div>'
      + '<div class="m">' + (p.actif ? 'actif' : 'désactivé')
      + (p.cree ? ' · ouvert le ' + esc(p.cree) : '')
      + (p.aCode ? '' : ' · sans code') + '</div></div>'
      + '<button class="b" data-acc="code" data-nom="' + esc(p.prenom) + '">Code</button>'
      + '<button class="b' + (p.actif ? ' on' : '') + '" data-acc="' + (p.actif ? 'off' : 'on')
      + '" data-nom="' + esc(p.prenom) + '">' + (p.actif ? 'Désactiver' : 'Réactiver') + '</button>'
      + '</div>';
  }).join('');
}

function accesPost(p){
  p.code = ADMIN;
  return fetch(API, { method:'POST', cache:'no-store',
    headers:{'Content-Type':'text/plain;charset=utf-8'}, body: JSON.stringify(p) })
    .then(function(r){ return r.json(); })
    .then(function(j){ if(j.ok === false) throw new Error(j.error || 'erreur'); return j; });
}

function accesMsg(txt, ok){
  var m = el('accMsg'); if(!m) return;
  m.style.color = ok ? 'var(--ok)' : 'var(--alert)';
  m.textContent = txt;
  if(ok) setTimeout(function(){ if(m.textContent === txt) m.textContent = ''; }, 3500);
}

document.addEventListener('click', function(ev){
  var b = ev.target.closest('[data-acc]');
  if(b){
    var nom = b.getAttribute('data-nom'), quoi = b.getAttribute('data-acc');
    if(quoi === 'code'){
      var c = prompt('Nouveau code personnel pour ' + nom + ' (8 caractères minimum)');
      if(c === null) return;
      accesPost({ action:'equipe_code', prenom:nom, nouveauCode:String(c).trim() })
        .then(function(){ accesMsg('Code changé pour ' + nom + '.', true); accesCharge(); })
        .catch(function(e){ accesMsg(e.message, false); });
      return;
    }
    accesPost({ action:'equipe_actif', prenom:nom, actif: quoi === 'on' })
      .then(function(){ accesMsg(nom + (quoi === 'on' ? ' réactivé.' : ' désactivé — son code n\'ouvre plus rien.'), true); accesCharge(); })
      .catch(function(e){ accesMsg(e.message, false); });
    return;
  }
  if(ev.target.id === 'accAdd'){
    var n = el('accNom').value.trim(), c = el('accCode').value.trim();
    if(!n){ accesMsg('Indique un prénom.', false); return; }
    if(c.length < 8){ accesMsg('Le code doit faire au moins 8 caractères.', false); return; }
    accesPost({ action:'equipe_creer', prenom:n, nouveauCode:c })
      .then(function(){ el('accNom').value=''; el('accCode').value='';
        accesMsg('Profil ouvert pour ' + n + '. Donne-lui son code de vive voix.', true); accesCharge(); })
      .catch(function(e){ accesMsg(e.message, false); });
  }
});

