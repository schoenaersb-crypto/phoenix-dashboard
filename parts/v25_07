/* ─── module RÉSERVATIONS ─────────────────────────── */
var RESA_VUE = 'avenir';       // 'avenir' | 'passees'
var RESA_LIMITE = 15;          // pagination des passées

function resaChip(source, statut){
  var s = String(source||'').toLowerCase();
  var cls = 'autre', lbl = source || '?';
  if(s.indexOf('fork') > -1 || s.indexOf('fourchette') > -1){ cls = 'thefork'; lbl = 'TheFork'; }
  else if(s.indexOf('whatsapp') > -1 || s.indexOf('wa') === 0){ cls = 'whatsapp'; lbl = 'WhatsApp'; }
  else if(s.indexOf('web') > -1 || s.indexOf('site') > -1 || s.indexOf('page') > -1){ cls = 'web'; lbl = 'Site web'; }
  else if(s.indexOf('mail') > -1 || s.indexOf('email') > -1 || s.indexOf('gmail') > -1){ cls = 'email'; lbl = 'Email'; }
  else if(s.indexOf('carnet') > -1){ cls = 'autre'; lbl = 'Carnet'; }
  else if(s.indexOf('app') > -1 || s.indexOf('equipe') > -1 || s.indexOf('équipe') > -1){ cls = 'web'; lbl = 'App équipe'; }
  var h = '<span class="rchip ' + cls + '">' + esc(lbl) + '</span>';
  if(/valid/i.test(statut||'')) h += '<span class="rchip valider">À valider</span>';
  return h;
}

function resaJourLabel(iso, isoAjd, isoDemain){
  if(iso === isoAjd) return 'Aujourd’hui';
  if(iso === isoDemain) return 'Demain';
  var d = new Date(iso + 'T12:00:00');
  if(isNaN(d)) return iso;
  return d.toLocaleDateString('fr-FR', { weekday:'long', day:'numeric', month:'long' });
}

function resaCarte(r, montrerDate){
  var warn = /valid/i.test(r.statut||'');
  var cvt = Number(r.couverts) || 0;
  var manque = r.manque || [];
