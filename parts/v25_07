        + (p.variantes ? '<div class="fvar">regroupe : '+esc(p.variantes.join(' · '))+'</div>' : '')
        + '</div>';
    });
    h += '</div>';
  }

  var q = F_Q.trim().toLowerCase();
  var liste = toutes.filter(function(l){
    if(F_FILTRE === 'douteuses' && l.etat !== 'À vérifier') return false;
    if(F_FILTRE === 'impayees'  && l.etat !== 'Impayée') return false;
    if(F_FILTRE === 'echeancier'&& l.etat !== 'Échéancier') return false;
    if(F_FILTRE === 'sanspdf'   && l.fichier) return false;
    if(q){
      var t = ((l.fournisseur||'')+' '+(l.numero||'')+' '+(l.date||'')+' '+(l.preuve||'')).toLowerCase();
      if(t.indexOf(q) === -1) return false;
    }
    return true;
