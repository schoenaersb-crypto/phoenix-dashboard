'; }catch(_){ }
        return;
      }
      EMPREINTE = neuve;
      /* recopiée dans l'appareil : la prochaine ouverture affiche cette
         photo instantanément au lieu des squelettes */
      try{ localStorage.setItem('phx_pilotage_data', JSON.stringify(j)); }catch(_){ }
      renderTout();
    })
    .catch(function(e){
      DERNIER_CHARGE = Date.now();
      /* une photo est déjà affichée : on la garde plutôt qu'un écran d'erreur */
      if(DATA) return;
      var msg = '<div class="state">'+glyph('<path d="M12 8v5M12 16.5v.5"/><path d="M10.3 4.2L2.8 17.5A2 2 0 004.5 20.5h15a2 2 0 001.7-3L13.7 4.2a2 2 0 00-3.4 0z"/>')
        + '<strong>Données inaccessibles</strong>'
        + esc(e.message) + '<br><br>Vérifie que le déploiement Apps Script est réglé sur '
        + '« Tout le monde » et que l\'URL se termine par <code>/exec</code>.</div>';
      ['accueil','ventes','equipe','factures','avis'].forEach(function(k){ el('p-'+k).innerHTML = msg; });
    });
}

/* ─── graphique : 7 derniers services ─────────────── */
function barChart(derniers){
  /* derniers arrive du plus récent au plus ancien → on remet en ordre chrono */
  var pts = derniers.slice().reverse();
  var W = 640, H = 150, padL = 6, padR = 6, padT = 26, padB = 22;
  var iw = W - padL - padR, ih = H - padT - padB;
  var max = Math.max.apply(null, pts.map(function(p){return p.ca||0})) || 1;
  var n = pts.length;
  var slot = iw / n;
  var bw = Math.min(34, slot * .52);          /* barre fine, l'air fait le reste */
  var r = 4;                                   /* bout arrondi côté donnée */

  var svg = '<svg viewBox="0 0 '+W+' '+H+'" role="img" aria-label="Chiffre d\'affaires des 7 derniers services">';
  svg += '<line class="gridline" x1="'+padL+'" y1="'+(padT+ih)+'" x2="'+(W-padR)+'" y2="'+(padT+ih)+'"/>';

  pts.forEach(function(p,i){
    var x = padL + slot*i + (slot-bw)/2;
    var hh = Math.max(3, (p.ca||0)/max * ih);
    var y = padT + ih - hh;
    var now = (i === n-1);
    var d = 'M'+x+' '+(padT+ih)
          + ' V'+(y+r)
          + ' Q'+x+' '+y+' '+(x+r)+' '+y
          + ' H'+(x+bw-r)
          + ' Q'+(x+bw)+' '+y+' '+(x+bw)+' '+(y+r)
          + ' V'+(padT+ih)+' Z';
    svg += '<g class="bar'+(now?' now':'')+'" data-i="'+i+'" tabindex="0" aria-label="'+esc(p.date)+' : '+esc(EUR.format(p.ca||0))+', '+(p.couverts||0)+' couverts">';
    svg += '<path class="mark" d="'+d+'"/>';
    if(now){ /* étiquette directe sur le service le plus récent uniquement */
      svg += '<text class="bar-lab" x="'+(x+bw/2)+'" y="'+(y-8)+'" text-anchor="middle">'+esc(EUR.format(p.ca||0))+'</text>';
    }
    svg += '<text class="axis-lab" x="'+(x+bw/2)+'" y="'+(H-6)+'" text-anchor="middle">'+esc(String(p.date||'').slice(0,5))+'</text>';
    svg += '<rect class="hit" x="'+(padL+slot*i)+'" y="'+padT+'" width="'+slot+'" height="'+ih+'"/>';
    svg += '</g>';
  });
  svg += '</svg>';
  return {svg:svg, pts:pts, geo:{W:W,padL:padL,slot:slot,padT:padT}};
}

function bindChart(container, chart){
  var wrap = container.querySelector('.chart-wrap');
  if(!wrap) return;
  var tip = document.createElement('div');
  tip.className = 'tip';
  wrap.appendChild(tip);
  var svgEl = wrap.querySelector('svg');

  function show(g){
    var i = +g.getAttribute('data-i');
    var p = chart.pts[i];
    tip.innerHTML = '<span class="t-meta">'+esc(p.date)+'</span><br>'
      + esc(EUR.format(p.ca||0)) + ' · ' + (p.couverts||0) + ' couverts';
    var rect = svgEl.getBoundingClientRect();
    var scale = rect.width / chart.geo.W;
    var cx = (chart.geo.padL + chart.geo.slot*(i+.5)) * scale;
    tip.style.left = cx + 'px';
    tip.style.top  = (chart.geo.padT * scale + 14) + 'px';
    tip.classList.add('on');
    g.classList.add('hov');
  }
  function hide(g){
    tip.classList.remove('on');
    if(g) g.classList.remove('hov');
  }
  wrap.querySelectorAll('.bar').forEach(function(g){
    g.addEventListener('pointerenter', function(){ show(g); });
    g.addEventListener('pointerleave', function(){ hide(g); });
    g.addEventListener('focus', function(){ show(g); });
    g.addEventListener('blur',  function(){ hide(g); });
    g.addEventListener('click', function(e){ e.stopPropagation(); show(g);
      setTimeout(function(){ hide(g); }, 2200);
    });
  });
}

/* ─── module ACCUEIL — recap essentiel + objectifs ── */
function accAnneau(pct, montant, sous){
  var p = Math.max(0, Math.min(1, pct));
  var R = 56, C = 2 * Math.PI * R;
  return '<div class="ring-wrap"><svg viewBox="0 0 140 140" class="ring">'
    + '<defs><linearGradient id="ringG" x1="0" y1="0" x2="1" y2="1">'
    + '<stop offset="0" stop-color="#EDD08A"/><stop offset=".6" stop-color="#D4A843"/><stop offset="1" stop-color="#B98D55"/></linearGradient></defs>'
    + '<circle cx="70" cy="70" r="' + R + '" class="ring-bg"/>'
    + '<circle cx="70" cy="70" r="' + R + '" class="ring-val" stroke="url(#ringG)"'
    + ' stroke-dasharray="' + (C * p).toFixed(1) + ' ' + C.toFixed(1) + '" transform="rotate(-90 70 70)"/>'
    + '<text x="70" y="64" class="ring-pct">' + Math.round(pct * 100) + '%</text>'
    + '<text x="70" y="84" class="ring-sub">' + esc(sous) + '</text>'
    + '</svg><div class="ring-cap">' + montant + '</div></div>';
}
function accBarre(label, fait, objectif){
  var p = objectif > 0 ? fait / objectif : 0;
  var w = Math.max(2, Math.min(100, Math.round(p * 100)));
  return '<div class="abar"><div class="abar-top"><span>' + esc(label) + '</span>'
    + '<span class="abar-val">' + EUR.format(fait) + ' <em>/ ' + EUR.format(objectif) + '</em></span></div>'
    + '<div class="abar-track"><div class="abar-fill' + (p >= 1 ? ' full' : '') + '" style="width:' + w + '%"></div></div>'
    + '<div class="abar-pct">' + Math.round(p * 100) + ' %' + (p >= 1 ? ' — objectif atteint 🎉' : '') + '</div></div>';
}
