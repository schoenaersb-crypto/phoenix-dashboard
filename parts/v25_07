var F_FILTRE = 'douteuses';
var F_LIMITE = 30;
var F_Q = '';

var F_ETATS = {
  'Impayée':    { cls:'alert', lib:'Impayée' },
  'À vérifier': { cls:'warn',  lib:'À vérifier' },
  'Échéancier': { cls:'ech',   lib:'Échéancier' },
  'Payée':      { cls:'ok',    lib:'Payée' }
};

function renderFactures(){
  var f = DATA.factures;
  var root = el('p-factures');
  if(!f || ((!f.lignes || !f.lignes.length) && !f.totalImpaye && !f.aTransmettre)){
    root.innerHTML = stateBlock('<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4"/><path d="M10 12h5M10 16h5"/>',
      'Aucune facture en vue',
