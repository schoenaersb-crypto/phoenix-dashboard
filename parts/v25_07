/* ─── module VENTES — multi-périodes (v12) ────────── */
var V_PER = 'jour';   // 'jour' | 'mois' | 'tri' | 'an'
var V_OFF = 0;        // 0 = période courante, 1 = précédente, …
var MOIS_FR = ['janvier','février','mars','avril','mai','juin','juillet','août','septembre','octobre','novembre','décembre'];
var MOIS_C  = ['janv','févr','mars','avr','mai','juin','juil','août','sept','oct','nov','déc'];

function vPct(cur, prev){
  if(prev == null || prev <= 0) return null;
  return ((cur - prev) / prev) * 100;
}
function vDelta(pct, libelle){
  if(pct == null) return '<span class="vdelta na">— vs ' + esc(libelle) + '</span>';
  var up = pct >= 0;
  return '<span class="vdelta ' + (up?'up':'down') + '">' + (up?'▲':'▼') + ' '
    + Math.abs(Math.round(pct)) + ' % vs ' + esc(libelle) + '</span>';
}
function vSomme(tout, prefix){
  var ca = 0, cv = 0, n = 0;
  tout.forEach(function(x){ if(x.d.slice(0, prefix.length) === prefix){ ca += x.ca; cv += x.cv; n++; } });
  return { ca: ca, cv: cv, n: n };
}
function vSommeTri(tout, an, tri){
  var ca = 0, cv = 0, n = 0;
  tout.forEach(function(x){
    if(x.d.slice(0,4) !== String(an)) return;
    if(Math.floor((Number(x.d.slice(5,7)) - 1) / 3) !== tri) return;
    ca += x.ca; cv += x.cv; n++;
  });
  return { ca: ca, cv: cv, n: n };
}
function vMoisCle(d){ return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0'); }

function renderVentes(){
  var v = DATA.ventes;
  var root = el('p-ventes');
  if(!v || !v.jour){
    root.innerHTML = stateBlock('<path d="M3 17l5-6 4 3 6-8"/><path d="M14 6h4v4"/>',
      'Aucune vente enregistrée',
      'Dès que le service est saisi (formulaire ou export Agora) dans la feuille <code>Ventes</code>, le chiffre s\'affiche ici.');
    return;
  }
  var tout = v.tout || [];
  if(!tout.length){ renderVentesSimple(v, root); return; }

  var now = new Date();
  var cur = { ca: 0, cv: 0, n: 0 }, prev = null, yoy = null;
  var labPrev = '', labYoy = '', titre = '', chartPts = [], ariaChart = '';

  if(V_PER === 'jour'){
    var idx = tout.length - 1 - V_OFF;
    if(idx < 0){ V_OFF = tout.length - 1; idx = 0; }
    var selJ = tout[idx];
    cur = { ca: selJ.ca, cv: selJ.cv, n: 1 };
    var dd = new Date(selJ.d + 'T12:00:00');
    titre = dd.toLocaleDateString('fr-FR', { weekday:'long', day:'numeric', month:'long', year:'numeric' });
    if(idx > 0){ prev = { ca: tout[idx-1].ca }; labPrev = 'service préc.'; }
    var y1 = (Number(selJ.d.slice(0,4)) - 1) + selJ.d.slice(4);
    var e1 = null; tout.forEach(function(x){ if(x.d === y1) e1 = x; });
    if(e1){ yoy = { ca: e1.ca }; labYoy = 'même jour ' + y1.slice(0,4); }
    chartPts = tout.slice(Math.max(0, idx - 13), idx + 1).map(function(x){
      return { date: x.d.slice(8,10) + '/' + x.d.slice(5,7), ca: x.ca, couverts: x.cv };
    }).reverse();
    ariaChart = '14 derniers services';
  }
  else if(V_PER === 'mois'){
    var mAnc = new Date(now.getFullYear(), now.getMonth() - V_OFF, 1);
    var cle = vMoisCle(mAnc);
    cur = vSomme(tout, cle);
    titre = MOIS_FR[mAnc.getMonth()] + ' ' + mAnc.getFullYear();
    var mPrev = new Date(mAnc.getFullYear(), mAnc.getMonth() - 1, 1);
    var sPrev = vSomme(tout, vMoisCle(mPrev));
    if(sPrev.n){ prev = sPrev; labPrev = MOIS_C[mPrev.getMonth()] + ' ' + mPrev.getFullYear(); }
    var sYoy = vSomme(tout, (mAnc.getFullYear()-1) + '-' + String(mAnc.getMonth()+1).padStart(2,'0'));
    if(sYoy.n){ yoy = sYoy; labYoy = MOIS_C[mAnc.getMonth()] + ' ' + (mAnc.getFullYear()-1); }
    chartPts = tout.filter(function(x){ return x.d.slice(0,7) === cle; }).map(function(x){
      return { date: x.d.slice(8,10), ca: x.ca, couverts: x.cv };
    }).reverse();
    ariaChart = 'jours du mois';
  }
  else if(V_PER === 'tri'){
    var triNow = Math.floor(now.getMonth() / 3);
    var anT = now.getFullYear(), t = triNow - V_OFF;
    while(t < 0){ t += 4; anT--; }
    cur = vSommeTri(tout, anT, t);
    titre = 'T' + (t+1) + ' ' + anT;
    var tp = t - 1, anP = anT; if(tp < 0){ tp = 3; anP--; }
    var sTP = vSommeTri(tout, anP, tp);
    if(sTP.n){ prev = sTP; labPrev = 'T' + (tp+1) + ' ' + anP; }
    var sTY = vSommeTri(tout, anT - 1, t);
    if(sTY.n){ yoy = sTY; labYoy = 'T' + (t+1) + ' ' + (anT-1); }
    chartPts = [];
    for(var mi = t*3; mi < t*3+3; mi++){
      var s = vSomme(tout, anT + '-' + String(mi+1).padStart(2,'0'));
      chartPts.push({ date: MOIS_C[mi], ca: s.ca, couverts: s.cv });
    }
    chartPts.reverse();
    ariaChart = 'mois du trimestre';
  }
  else {
    var anA = now.getFullYear() - V_OFF;
    cur = vSomme(tout, String(anA));
    titre = String(anA);
    var sAP = vSomme(tout, String(anA - 1));
    if(sAP.n){ prev = sAP; labPrev = String(anA - 1); }
    chartPts = [];
    for(var mj = 0; mj < 12; mj++){
      var sm = vSomme(tout, anA + '-' + String(mj+1).padStart(2,'0'));
      chartPts.push({ date: MOIS_C[mj], ca: sm.ca, couverts: sm.cv });
    }
    chartPts.reverse();
    ariaChart = 'mois de l\'année';
  }

  var peutAvancer = V_OFF > 0;
  var peutReculer = (V_PER === 'jour') ? (V_OFF < tout.length - 1) : true;

  var h = '<div class="rseg" id="vseg">'
    + ['jour','mois','tri','an'].map(function(p){
        var lab = { jour:'Jour', mois:'Mois', tri:'Trimestre', an:'Année' }[p];
        return '<button data-per="' + p + '" class="' + (V_PER===p?'on':'') + '">' + lab + '</button>';
      }).join('')
    + '</div>';

  h += '<div class="vnav">'
    + '<button class="vnav-btn" id="vPrev"' + (peutReculer?'':' disabled') + '>‹</button>'
    + '<div class="vnav-lab">' + esc(titre) + '</div>'
    + '<button class="vnav-btn" id="vNext"' + (peutAvancer?'':' disabled') + '>›</button>'
    + '</div>';

  var ticket = cur.cv > 0 ? EUR2.format(cur.ca / cur.cv) : null;
  h += '<div class="card hero">'
    + '<div class="card-label">Chiffre d\'affaires' + (V_PER !== 'jour' && cur.n ? ' · ' + cur.n + ' jour' + (cur.n>1?'s':'') + ' de service' : '') + '</div>'
    + '<div class="figure"><span data-count="' + (cur.ca||0) + '" data-fmt="eur">' + EUR.format(0) + '</span></div>'
    + '<div class="figure-sub">' + (cur.cv > 0 ? (cur.cv + ' couverts · ticket moyen ' + ticket) : 'couverts non renseignés sur cette période') + '</div>'
    + '<div class="vdeltas">' + vDelta(vPct(cur.ca, prev && prev.ca), labPrev || 'période préc.')
    + (V_PER !== 'an' ? vDelta(vPct(cur.ca, yoy && yoy.ca), labYoy || 'année préc.') : '') + '</div>';

  var chart = null;
  if(chartPts.length > 1){
    chart = barChart(chartPts);
    h += '<div class="chart-wrap">' + chart.svg + '</div>';
  }

  if(V_PER !== 'jour' && cur.n > 0){
    var best = null;
    tout.forEach(function(x){
      var dans = (V_PER === 'mois') ? x.d.slice(0,7) === vMoisCle(new Date(now.getFullYear(), now.getMonth() - V_OFF, 1))
               : (V_PER === 'an') ? x.d.slice(0,4) === titre
               : (x.d.slice(0,4) === titre.slice(3) && Math.floor((Number(x.d.slice(5,7))-1)/3) === (Number(titre.slice(1,2))-1));
      if(dans && (!best || x.ca > best.ca)) best = x;
    });
    if(best){
      var bd = new Date(best.d + 'T12:00:00');
      h += '<div class="vbest">Meilleur service : ' + bd.toLocaleDateString('fr-FR',{weekday:'long',day:'numeric',month:'long'}) + ' — ' + EUR.format(best.ca) + '</div>';
    }
  }
  h += '</div>';

  root.innerHTML = h;
  if(chart) bindChart(root, chart);
  animateFigures(root);

  root.querySelectorAll('#vseg button').forEach(function(b){
    b.addEventListener('click', function(){ V_PER = b.getAttribute('data-per'); V_OFF = 0; renderVentes(); });
  });
  var bp = el('vPrev'), bn = el('vNext');
  if(bp) bp.addEventListener('click', function(){ V_OFF++; renderVentes(); });
  if(bn) bn.addEventListener('click', function(){ if(V_OFF > 0){ V_OFF--; renderVentes(); } });
}

