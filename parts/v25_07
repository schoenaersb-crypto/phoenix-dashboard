/* ─── ticket IA ───────────────────────────────────── */
function openTicket(){
  el('scrim').classList.add('on');
  el('ticketWrap').classList.add('on');
  if(!HISTORY.length) push('ai', 'Prêt. Demande-moi le résumé de la journée, ou pose une question sur les ventes, l\'équipe, les factures ou les avis.');
  setTimeout(function(){ el('input').focus(); }, 360);
}
function closeTicket(){
  el('scrim').classList.remove('on');
  el('ticketWrap').classList.remove('on');
}

function push(role, text){
  HISTORY.push({role: role==='me'?'user':'assistant', content:text});
  var d = document.createElement('div');
  d.className = 'msg ' + role;
  d.textContent = text;
  el('thread').appendChild(d);
  var hr = document.createElement('hr');
  hr.className = 'ticket-rule';
  el('thread').appendChild(hr);
  el('thread').scrollTop = el('thread').scrollHeight;
}

function ask(text){
  if(!text.trim()) return;
  if(!API){
    push('ai','Le dashboard n\'est pas encore relié à ton Apps Script — je n\'ai aucune donnée à lire.');
    return;
  }
  push('me', text);
  el('input').value = '';
  el('sendBtn').disabled = true;

  var wait = document.createElement('div');
  wait.className = 'msg typing';
  wait.textContent = 'Lecture des données…';
  el('thread').appendChild(wait);
  el('thread').scrollTop = el('thread').scrollHeight;

  fetch(API, {
    method:'POST',
    /* text/plain évite le preflight CORS, qu'Apps Script ne gère pas */
    headers:{'Content-Type':'text/plain;charset=utf-8'},
    body: JSON.stringify({
      action:'chat',
      code: ADMIN,
      message: text,
      history: HISTORY.slice(-10)
    })
  })
  .then(function(r){ return r.json(); })
  .then(function(j){
    wait.remove();
    if(j.ok === false) throw new Error(j.error || 'erreur inconnue');
    push('ai', j.reply || '(réponse vide)');
  })
  .catch(function(e){
    wait.remove();
    push('ai', 'Impossible de répondre : ' + e.message + '\nVérifie que la clé API est bien enregistrée dans les propriétés du script.');
  })
  .finally(function(){
    el('sendBtn').disabled = false;
  });
}

el('gateBtn').addEventListener('click', gateSubmit);
el('gateInput').addEventListener('keydown', function(e){ if(e.key==='Enter') gateSubmit(); });
el('askBtn').addEventListener('click', openTicket);
el('closeBtn').addEventListener('click', closeTicket);
el('scrim').addEventListener('click', closeTicket);
el('sendBtn').addEventListener('click', function(){ ask(el('input').value); });

el('input').addEventListener('input', function(){
  this.style.height = 'auto';
  this.style.height = Math.min(this.scrollHeight, 110) + 'px';
});
el('input').addEventListener('keydown', function(e){
  if(e.key === 'Enter' && !e.shiftKey){ e.preventDefault(); ask(this.value); }
});
document.addEventListener('keydown', function(e){
  if(e.key === 'Escape') closeTicket();
});
document.querySelectorAll('.chip').forEach(function(c){
  c.addEventListener('click', function(){ ask(c.textContent); });
});

