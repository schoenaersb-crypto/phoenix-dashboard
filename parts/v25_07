function resaCaptureValide(){
  var j = RESA_CAP;
  if(!j) return;
  var choisies = [];
  var cases = document.querySelectorAll('#capList .capck');
  for(var i = 0; i < cases.length; i++){
    var c = cases[i];
    if(c.checked && !c.disabled){
      var r = (j.reservations || [])[+c.getAttribute('data-i')];
      if(r) choisies.push(r);
    }
  }
  var msg = el('capMsg');
  if(!choisies.length){ msg.textContent = 'Rien de sélectionné.'; return; }
  msg.textContent = 'Ajout de ' + choisies.length + ' réservation(s)…';
  fetch(API, { method:'POST', cache:'no-store',
    headers:{'Content-Type':'text/plain;charset=utf-8'},
    body: JSON.stringify({ action:'resa_lot', code: ADMIN, reservations: choisies }) })
    .then(function(x){ return x.json(); })
    .then(function(r){
      if(!r || r.ok === false){ msg.textContent = 'Échec : ' + ((r&&r.error)||'inconnu'); return; }
      msg.textContent = r.ajoutees + ' ajoutée(s)'
        + (r.ignorees ? ' · ' + r.ignorees + ' déjà notée(s)' : '') + '.';
      RESA_CAP = null;
      setTimeout(load, 800);
    })
    .catch(function(e){ msg.textContent = 'Réseau : ' + e.message; });
}

function resaCaptureBind(){
  var b = el('capBtn'), f = el('capFile');
  if(!b || !f) return;
  b.addEventListener('click', function(){ f.click(); });
  f.addEventListener('change', function(){
    if(f.files && f.files[0]) resaCaptureLire(f.files[0]);
  });
  if(RESA_CAP) resaCaptureAffiche();
}

function resaGroupeParJour(liste, isoAjd, isoDemain){
  var jours = [], idx = {};
  liste.forEach(function(r){
    var k = r.date || '?';
    if(idx[k] == null){ idx[k] = jours.length; jours.push({ date:k, resas:[], cvt:0 }); }
    jours[idx[k]].resas.push(r);
    jours[idx[k]].cvt += Number(r.couverts) || 0;
  });
  var h = '';
  jours.forEach(function(j){
    j.resas.sort(function(a,b){ return String(a.heure||'').localeCompare(String(b.heure||'')); });
    h += '<div class="rday"><span class="rd-t">' + esc(resaJourLabel(j.date, isoAjd, isoDemain)) + '</span>'
      + '<span class="rd-c">' + j.resas.length + ' résa · ' + j.cvt + ' cvt</span></div>';
    j.resas.forEach(function(r){ h += resaCarte(r, false); });
  });
  return h;
}

function renderResa(){
  var root = el('p-resa');
  var resas = DATA.reservations || [];
  if(!resas.length){
    root.innerHTML = resaCaptureBloc() + stateBlock('<rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 3v4M16 3v4M4 10h16"/>',
      'Pas encore de réservation',
      'Les réservations arrivent ici depuis la page publique, les emails, TheFork, WhatsApp et l\'app équipe.');
    resaCaptureBind();
    return;
  }
  var d = new Date();
  function iso(dt){ return dt.getFullYear()+'-'+String(dt.getMonth()+1).padStart(2,'0')+'-'+String(dt.getDate()).padStart(2,'0'); }
  var isoAjd = iso(d);
  var d2 = new Date(d.getTime() + 864e5), isoDemain = iso(d2);
  var d7 = new Date(d.getTime() + 7*864e5), iso7 = iso(d7);

  var futures = resas.filter(function(r){ return r.date >= isoAjd; })
                     .sort(function(a,b){ return String(a.date).localeCompare(String(b.date)) || String(a.heure||'').localeCompare(String(b.heure||'')); });
  var passees = resas.filter(function(r){ return r.date < isoAjd; })
                     .sort(function(a,b){ return String(b.date).localeCompare(String(a.date)) || String(b.heure||'').localeCompare(String(a.heure||'')); });

  var ceSoir = futures.filter(function(r){ return r.date === isoAjd; });
  var cvtSoir = ceSoir.reduce(function(s,r){ return s + (Number(r.couverts)||0); }, 0);
  var sept = futures.filter(function(r){ return r.date < iso7; });
  var cvt7 = sept.reduce(function(s,r){ return s + (Number(r.couverts)||0); }, 0);
  var cvtPasses = passees.reduce(function(s,r){ return s + (Number(r.couverts)||0); }, 0);

  var h = resaCaptureBloc();
  h += '<div class="resa-stats">'
    + '<div class="rstat"><div class="rs-num">' + ceSoir.length + '<span style="font-size:15px;color:var(--ink-2)"> · ' + cvtSoir + '</span></div><div class="rs-lbl">Auj. · cvt</div></div>'
    + '<div class="rstat"><div class="rs-num">' + sept.length + '<span style="font-size:15px;color:var(--ink-2)"> · ' + cvt7 + '</span></div><div class="rs-lbl">7 jours · cvt</div></div>'
    + '<div class="rstat"><div class="rs-num">' + passees.length + '</div><div class="rs-lbl">90 j passés</div></div>'
    + '</div>';

  h += '<div class="rseg">'
    + '<button data-vue="avenir" class="' + (RESA_VUE==='avenir'?'on':'') + '">À venir (' + futures.length + ')</button>'
    + '<button data-vue="passees" class="' + (RESA_VUE==='passees'?'on':'') + '">Passées (' + passees.length + ')</button>'
    + '</div>';

  if(RESA_VUE === 'avenir'){
    h += futures.length
      ? resaGroupeParJour(futures, isoAjd, isoDemain)
      : '<div class="resa-vide">Aucune réservation à venir pour l\'instant.<br>Elles arrivent seules depuis TheFork, les emails, WhatsApp et la page de réservation.</div>';
  } else {
    if(passees.length){
      h += '<div class="rday"><span class="rd-t" style="text-transform:none">90 derniers jours</span>'
        + '<span class="rd-c">' + cvtPasses + ' couverts servis</span></div>';
      var visibles = passees.slice(0, RESA_LIMITE);
      var jourCourant = '';
      visibles.forEach(function(r){
        if(r.date !== jourCourant){
          jourCourant = r.date;
          h += '<div class="rday"><span class="rd-t">' + esc(resaJourLabel(r.date, isoAjd, isoDemain)) + '</span></div>';
        }
        h += resaCarte(r, false);
      });
      if(passees.length > RESA_LIMITE){
        h += '<button class="resa-plus" id="resaPlus">Afficher ' + Math.min(15, passees.length - RESA_LIMITE) + ' de plus (' + (passees.length - RESA_LIMITE) + ' restantes)</button>';
      }
    } else {
      h += '<div class="resa-vide">Pas encore de réservation passée enregistrée.</div>';
    }
  }

  root.innerHTML = h;

  root.querySelectorAll('.rseg button').forEach(function(b){
    b.addEventListener('click', function(){
      RESA_VUE = b.getAttribute('data-vue');
      RESA_LIMITE = 15;
      renderResa();
    });
  });
  var plus = el('resaPlus');
  if(plus) plus.addEventListener('click', function(){ RESA_LIMITE += 15; renderResa(); });
  resaCaptureBind();
}

/* ─── module ÉQUIPE ───────────────────────────────── */
/* ─── module ÉQUIPE — les heures, pour de vrai ────────────────────
   L'ancienne version n'affichait qu'un cumul par personne : « 56,5 h »,
   sans dire ni quel jour, ni à quelle heure, ni sur quel service. On
   ne peut rien analyser avec ça — ni voir une soirée en sous-effectif,
   ni justifier une heure supplémentaire, ni répondre à l'Inspection du
   travail, qui exige l'heure exacte d'entrée et de sortie, jour par
   jour, et quatre ans d'archives (art. 34.9 de l'Estatuto de los
   Trabajadores, amende de 751 à 7 500 €).

   Ce qu'on affiche maintenant : une grille de la semaine, personne par
   personne et jour par jour ; le détail d'une journée au doigt, avec
   les heures réelles ; les heures mises face au chiffre d'affaires,
   qui est la seule façon de savoir si un service coûte trop cher ; et
   ce qui cloche, mis devant les yeux plutôt que noyé.

   La journée de service bascule à 5 h du matin, ici comme dans la
   caisse : une soirée qui finit à 1 h appartient à la veille. Compter
   de minuit à minuit couperait chaque service en deux. */

var EQ_OFF = 0;            /* 0 = semaine en cours, 1 = la précédente… */
var EQ_JOUR = null;        /* le jour dont on regarde le détail */
var EQ_CACHE = {};
var EQ_ETAT = 'attente';   /* 'attente' | 'ok' | 'absent' */
var EQ_DONNEES = null;
/* v23 — qui apparait dans le tableau. Liste vide = toute l'equipe.
   Le choix reste sur l'appareil : on ne le redemande pas a chaque ouverture. */
var EQ_QUI = [];
try { EQ_QUI = JSON.parse(localStorage.getItem('phx_eq_qui') || '[]') || []; } catch (_) { EQ_QUI = []; }
function eqQuiGarde() { try { localStorage.setItem('phx_eq_qui', JSON.stringify(EQ_QUI)); } catch (_) { } }
function eqNomsTous(seances) {
  var vus = {}, out = [];
  (seances || []).forEach(function (s) { if (!vus[s.nom]) { vus[s.nom] = 1; out.push(s.nom); } });
  return out.sort();
}
function eqPastilles(tous) {
  if (tous.length < 2) return '';
  var h = '<div class="eq-qui" role="group" aria-label="Qui apparait dans le tableau">';
  h += '<button class="eq-chip' + (EQ_QUI.length ? '' : ' on') + '" data-eqqui="*">Toute l\'équipe</button>';
  tous.forEach(function (n) {
    h += '<button class="eq-chip' + (EQ_QUI.indexOf(n) >= 0 ? ' on' : '') + '" data-eqqui="'
      + esc(n) + '">' + esc(n) + '</button>';
  });
  return h + '</div>';
}
var JOURS_L = ['L', 'M', 'M', 'J', 'V', 'S', 'D'];
var JOURS_LONG = ['lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi', 'dimanche'];
var MOIS_LONG = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet',
  'août', 'septembre', 'octobre', 'novembre', 'décembre'];

function eqLundi(off) {
  var d = new Date();
  if (d.getHours() < 5) d.setDate(d.getDate() - 1);
  d.setDate(d.getDate() - ((d.getDay() + 6) % 7) - 7 * (off || 0));
  d.setHours(12, 0, 0, 0);
  return d;
}
function eqISO(d) {
  return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
}
function eqPlus(d, n) { var x = new Date(d.getTime()); x.setDate(x.getDate() + n); return x; }

/* « 8 h 30 » se lit mieux que « 8,5 h » quand on vérifie une journée ;
   « 8,5 » se compare mieux quand on lit une colonne. On garde les deux
   selon l'endroit. */
function eqHM(min) {
  var m = Math.round(min || 0);
  if (!m) return '—';
  var h = Math.floor(m / 60), r = m % 60;
  return r ? h + ' h ' + ('0' + r).slice(-2) : h + ' h';
}
/* « 0 h 19 » pour dix-neuf minutes se lit mal : sous l'heure, on
   compte en minutes. */
function eqDuree(min) {
  var m = Math.round(min || 0);
  if (!m) return '\u2014';
  return m < 60 ? m + ' min' : eqHM(m);
}
function eqDec(min) {
  var v = Math.round((min || 0) / 6) / 10;
  return (v % 1 === 0) ? String(v) : String(v).replace('.', ',');
}

/* Les heures contractuelles ne sont nulle part dans les données : sans
   elles, impossible de dire si quelqu'un dépasse. Bastien les pose au
   doigt, elles restent sur l'appareil. */
function eqContrat(nom, v) {
  try {
    if (v === undefined) {
      var x = localStorage.getItem('phx_contrat_' + nom);
      return x ? Number(x) : 0;
    }
    if (v) localStorage.setItem('phx_contrat_' + nom, String(v));
    else localStorage.removeItem('phx_contrat_' + nom);
  } catch (e) { }
  return v || 0;
}

function eqCharge(depuis, jusqu, cb) {
  var cle = depuis + '|' + jusqu;
  if (EQ_CACHE[cle]) return cb(EQ_CACHE[cle]);
  fetch(API, {
    method: 'POST', cache: 'no-store',
    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
    body: JSON.stringify({ action: 'caisse_heures', code: ADMIN, depuis: depuis, jusqu: jusqu })
  })
    .then(function (r) { return r.text(); })
    .then(function (txt) {
      var j = null; try { j = JSON.parse(txt); } catch (e) { }
      if (j && j.ok) { EQ_CACHE[cle] = j; EQ_ETAT = 'ok'; cb(j); }
      else { EQ_ETAT = 'absent'; cb(null); }
    })
    .catch(function () { EQ_ETAT = 'absent'; cb(null); });
}

/* ─── les deux sources d'heures ──────────────────────────────────
   La pointeuse n'est pas en service : ce que chacun inscrit dans sa
   fiche de fin de service fait foi. Le jour où un pointage existe, il
   l'emporte — c'est la mesure, pas la déclaration — et l'écart entre
   les deux est mis de côté pour être montré tel quel. */
function eqFusion(pointe, declare) {
  var cle = function (n, j) { return n + '|' + j; };
  var mp = {}, md = {}, lignes = {};
  (pointe || []).forEach(function (s) {
    var k = cle(s.nom, s.jour); mp[k] = (mp[k] || 0) + (s.minutes || 0);
  });
  (declare || []).forEach(function (d) {
    var k = cle(d.nom, d.jour);
    md[k] = (md[k] || 0) + (d.minutes || 0);
    (lignes[k] || (lignes[k] = [])).push(d);
  });
  var out = (pointe || []).slice(), ecarts = [], doubles = [];
  /* Deux fiches pour le même service, le même jour : les heures
     s'additionnent et la journée gonfle. C'est presque toujours une
     fiche envoyée deux fois — on le montre plutôt que de l'avaler. */
  Object.keys(lignes).forEach(function (k) {
    var vus = {};
    lignes[k].forEach(function (d) {
      var s2 = d.service || 'soir';
      if (vus[s2]) return;
      vus[s2] = 1;
      var m = lignes[k].filter(function (x) { return (x.service || 'soir') === s2; });
      if (m.length > 1) {
        doubles.push({ nom: d.nom, jour: d.jour, service: s2,
          heures: m.map(function (x) { return x.minutes; }) });
      }
    });
  });
  Object.keys(md).forEach(function (k) {
    if (mp[k] === undefined) {
      lignes[k].forEach(function (d) {
        out.push({
          jour: d.jour, nom: d.nom, minutes: d.minutes, service: d.service,
          incomplet: false, enCours: false, source: 'declare', debut: '', fin: '',
          ressenti: d.ressenti, commentaire: d.commentaire,
          tsDebut: new Date(d.jour + 'T' + (d.service === 'midi' ? '11:00:00' : '18:00:00')).getTime()
        });
      });
      return;
    }
    var diff = mp[k] - md[k];
    if (Math.abs(diff) > 30) {
      ecarts.push({ nom: lignes[k][0].nom, jour: lignes[k][0].jour,
        pointe: mp[k], declare: md[k], diff: diff });
    }
  });
  return { seances: out, ecarts: ecarts, doubles: doubles };
}

/* ─── la grille : personnes × jours ──────────────────────────────── */
function eqGrille(seances, lundi, caJour) {
  var par = {}, parJour = [0, 0, 0, 0, 0, 0, 0], noms = [];
  /* Un jour dont une seule séance est incomplète ne donne pas un total
     d'heures utilisable : on le retient pour ne pas en tirer un €/h. */
  var sur = [true, true, true, true, true, true, true];
  seances.forEach(function (s) {
    var i = Math.round((new Date(s.jour + 'T12:00:00') - lundi) / 864e5);
    if (i < 0 || i > 6) return;
    if (s.incomplet || s.enCours) sur[i] = false;
    if (!par[s.nom]) { par[s.nom] = [null, null, null, null, null, null, null]; noms.push(s.nom); }
    var c = par[s.nom][i] || (par[s.nom][i] = { min: 0, midi: 0, soir: 0, encours: false, alerte: false, dec: 0, poi: 0 });
    c.min += s.minutes || 0;
    if (s.service === 'soir') c.soir += s.minutes || 0; else c.midi += s.minutes || 0;
    if (s.source === 'declare') c.dec += s.minutes || 0; else c.poi += s.minutes || 0;
    if (s.enCours) c.encours = true;
    if (s.incomplet) c.alerte = true;
    parJour[i] += s.minutes || 0;
  });
  noms.sort(function (a, b) {
    var sa = 0, sb = 0;
    par[a].forEach(function (c) { if (c) sa += c.min; });
    par[b].forEach(function (c) { if (c) sb += c.min; });
    return sb - sa;
  });

  var h = '<div class="eq-grid" role="table" aria-label="Heures de la semaine">';
  h += '<div class="eq-gh"></div>';
  for (var i = 0; i < 7; i++) {
    var d = eqPlus(lundi, i);
    var auj = eqISO(d) === eqISO(eqLundi(0)) ? '' : '';
    h += '<div class="eq-gh' + (i > 4 ? ' we' : '') + '">' + JOURS_L[i]
      + '<span>' + d.getDate() + '</span></div>';
  }
  noms.forEach(function (n) {
    h += '<div class="eq-nom" title="' + esc(n) + '">' + esc(n.slice(0, 8)) + '</div>';
    for (var i = 0; i < 7; i++) {
      var c = par[n][i];
      var jr = eqISO(eqPlus(lundi, i));
      if (!c) { h += '<div class="eq-c vide' + (i > 4 ? ' we' : '') + '" data-eqj="' + jr + '">·</div>'; continue; }
      var pm = c.min ? Math.round(c.midi / c.min * 100) : 0;
      /* Une entrée sans sortie laisse une séance d'une minute. Afficher
         « 0 » serait un mensonge : la durée n'est pas nulle, elle est
         inconnue. On écrit « ? » et la case reste cerclée. */
      var flou = c.alerte && c.min < 30;
      /* Une case bâtie sur la fiche de fin de service n'a pas la même
         valeur qu'une case mesurée par la pointeuse : elle est déclarée.
         Le cadre discret le dit sans crier au problème. */
      var decl = c.dec > 0 && c.poi === 0;
      h += '<div class="eq-c' + (i > 4 ? ' we' : '') + (c.alerte ? ' pb' : '') + (decl ? ' dec' : '')
        + '" data-eqj="' + jr + '" tabindex="0"'
        + (flou ? ' title="pointage incomplet : durée inconnue"'
                : (decl ? ' title="heures déclarées en fin de service"' : '')) + '>'
        + '<b' + (flou ? ' class="inc"' : '') + '>' + (flou ? '?' : eqDec(c.min)) + '</b>'
        + '<i><u style="width:' + pm + '%"></u></i>'
        + (c.encours ? '<s></s>' : '') + '</div>';
    }
  });
  h += '<div class="eq-nom tot">Total</div>';
  for (var i = 0; i < 7; i++) {
    /* un total bâti sur des durées inconnues ne vaut pas mieux qu'elles */
    var tflou = !sur[i] && parJour[i] < 30;
    h += '<div class="eq-c tot' + (i > 4 ? ' we' : '') + '">'
      + (tflou ? '?' : (parJour[i] ? eqDec(parJour[i]) : '·')) + '</div>';
  }
  var cellules = [], vus = 0, caches = 0;
  if (caJour && caJour.some(function (x) { return x; })) {
    for (var i = 0; i < 7; i++) {
      var m = parJour[i], c = caJour[i];
      /* Le ratio n'a de sens que sur des heures completes. Une journée où
         il manque une sortie donnait des « 59430 €/h » : un nombre faux,
         et trop large pour sa colonne. Au-delà de 400 € par heure
         travaillée, ce n'est plus une bonne journee, c'est un pointage
         qui manque. */
      var val = (m && c && sur[i] && m >= 60) ? Math.round(c / (m / 60)) : null;
      if (val !== null && val > 400) val = null;
      if (val === null) { if (m && c) caches++; } else vus++;
      cellules.push('<div class="eq-c sub' + (i > 4 ? ' we' : '') + '"'
        + (val === null && m && c ? ' title="pointage incomplet : ratio non calculable"' : '') + '>'
        + (val === null ? '\u00b7' : val) + '</div>');
    }
  }
  if (vus) {
    h += '<div class="eq-nom sub">&euro;/h</div>' + cellules.join('');
  }
  h += '</div>';
  if (caches) {
    h += '<div class="eq-note">'
      + (vus ? 'Le &euro;/h reste vide ' + (caches > 1 ? 'les ' + caches + ' jours' : 'le jour')
             : 'Pas de &euro;/h cette semaine : ')
      + (vus ? ' ou le pointage est incomplet. ' : 'aucune journée n\'a de pointage complet. ')
      + 'Sans heures fiables, le ratio ne veut rien dire.</div>';
  }
  h += '<div class="eq-leg"><span><i class="lg midi"></i>midi</span>'
    + '<span><i class="lg soir"></i>soir</span>'
    + '<span><i class="lg dec"></i>heures déclarées</span>'
    + '<span><i class="lg pb"></i>pointage incomplet</span>'
    + '<span class="eq-astuce">touche une case pour le détail</span></div>';
  return { html: h, par: par, noms: noms, parJour: parJour, sur: sur };
}

/* ─── le détail d'une journée : les heures réelles ───────────────── */
function eqDetailJour(seances, jour, vente) {
  var duJour = seances.filter(function (s) { return s.jour === jour; });
  var d = new Date(jour + 'T12:00:00');
  var titre = JOURS_LONG[(d.getDay() + 6) % 7] + ' ' + d.getDate() + ' ' + MOIS_LONG[d.getMonth()];
  var h = '<div class="card"><div class="card-label">' + titre + '</div>';
  if (!duJour.length) {
    h += '<div class="row"><div class="row-main"><div class="row-meta">Aucune heure ce jour-là : ni fiche de fin de service, ni pointage.</div></div></div>';
    return h + '</div>';
  }
  var par = {}, ordre = [];
  duJour.forEach(function (s) { if (!par[s.nom]) { par[s.nom] = []; ordre.push(s.nom); } par[s.nom].push(s); });
  var totJ = 0;
  ordre.forEach(function (n) {
    var t = 0;
    par[n].forEach(function (s) { t += s.minutes || 0; });
    totJ += t;
    h += '<div class="row"><div class="row-main">'
      + '<div class="row-title">' + esc(n) + '</div>';
    par[n].forEach(function (s) {
      h += '<div class="eq-seance">'
        + '<span class="h">' + (s.source === 'declare'
            ? 'déclaré en fin de service'
            : (s.debut + ' → ' + (s.fin || '<em>en cours</em>'))) + '</span>'
        + '<span class="d">' + eqHM(s.minutes) + '</span>'
        + '<span class="s ' + s.service + '">' + s.service + '</span>'
        + (s.incomplet ? '<span class="s pb">sortie non pointée</span>' : '')
        + '</div>';
    });
    h += '</div><div class="row-value">' + eqHM(t) + '</div></div>';
  });
  h += '<div class="row"><div class="row-main"><div class="row-meta" style="color:var(--copper)">'
    + ordre.length + (ordre.length > 1 ? ' personnes' : ' personne') + ' en poste'
    + (vente ? ' &middot; ' + Math.round(vente.ca) + ' \u20ac pour ' + vente.cv + ' couverts'
      + (totJ ? ' &middot; ' + Math.round(vente.ca / (totJ / 60)) + ' \u20ac par heure' : '') : '')
    + '</div></div><div class="row-value">' + eqHM(totJ) + '</div></div>';
  return h + '</div>';
}

/* ─── par personne, face au contrat ──────────────────────────────── */
function eqParPersonne(par, noms) {
  var h = '<div class="card"><div class="card-label">Par personne, cette semaine</div>';
  noms.forEach(function (n) {
    var t = 0, jours = 0;
    par[n].forEach(function (c) { if (c) { t += c.min; jours++; } });
    var ct = eqContrat(n);
    var pct = ct ? Math.min(100, Math.round(t / 60 / ct * 100)) : 0;
    var sur = ct ? (t / 60 - ct) : 0;
    h += '<div class="meter-row"><div class="meter-head">'
      + '<span class="meter-name">' + esc(n)
      + ' <button class="eq-ct" data-eqct="' + esc(n) + '">'
      + (ct ? 'contrat ' + ct + ' h' : 'poser le contrat') + '</button></span>'
      + '<span class="meter-val">' + eqHM(t) + '</span></div>';
    if (ct) {
      h += '<div class="meter"><i style="width:' + pct + '%' + (sur > 0.25 ? ';background:var(--alert)' : '') + '"></i></div>';
    }
    var sous = jours + (jours > 1 ? ' jours' : ' jour');
    if (ct && sur > 0.25) sous += ' · <span style="color:var(--alert)">+' + eqHM(sur * 60) + ' au-delà du contrat</span>';
    else if (ct && sur < -0.25) sous += ' · ' + eqHM(-sur * 60) + ' sous le contrat';
    h += '<div class="eq-sous">' + sous + '</div></div>';
  });
  return h + '</div>';
}

/* ─── ce qu'il manque, en clair ──────────────────────────────────
   Un jour où quelqu'un a pointé est un jour où le restaurant tournait :
   c'est le seul repère honnête dont on dispose pour distinguer « il a
   oublié de pointer » de « il ne travaillait pas ». On ne prétend donc
   rien savoir des jours où personne n'a rien pointé — on les signale
   à part. */
function eqEtat(toutes, vues, lundi) {
  var noms = eqNomsTous(vues);
  var actif = [false, false, false, false, false, false, false];
  var idx = function (jour) { return Math.round((new Date(jour + 'T12:00:00') - lundi) / 864e5); };
  (toutes || []).forEach(function (s) {
    var i = idx(s.jour);
    if (i >= 0 && i <= 6) actif[i] = true;
  });
  var nomJour = function (i) {
    var d = eqPlus(lundi, i);
    return JOURS_LONG[(d.getDay() + 6) % 7] + ' ' + d.getDate();
  };

  var lignes = '';
  noms.forEach(function (n) {
    var presence = [null, null, null, null, null, null, null];
    (vues || []).forEach(function (s) {
      if (s.nom !== n) return;
      var i = idx(s.jour);
      if (i < 0 || i > 6) return;
      if (!presence[i]) presence[i] = { manque: false };
      if (s.incomplet || s.enCours) presence[i].manque = true;
    });
    var sansSortie = [], sansPointage = [];
    for (var i = 0; i < 7; i++) {
      if (presence[i]) { if (presence[i].manque) sansSortie.push(nomJour(i)); }
      else if (actif[i]) sansPointage.push(nomJour(i));
    }
    if (!sansSortie.length && !sansPointage.length) return;
    lignes += '<div class="row"><div class="row-main">'
      + '<div class="row-title">' + esc(n) + '</div>'
      + (sansSortie.length ? '<div class="row-meta"><span style="color:var(--warn)">sortie manquante</span> : '
        + esc(sansSortie.join(', ')) + '</div>' : '')
      + (sansPointage.length ? '<div class="row-meta">pas d\'heures : ' + esc(sansPointage.join(', ')) + '</div>' : '')
      + '</div></div>';
  });

  var creux = [];
  for (var k = 0; k < 7; k++) if (!actif[k]) creux.push(nomJour(k));

  if (!lignes && !creux.length) {
    return '<div class="card"><div class="card-label">Pointages</div>'
      + '<div class="row"><div class="row-main"><div class="row-meta">'
      + 'Rien à reprendre cette semaine : chacun a ses heures sur chaque jour ouvert.</div></div></div></div>';
  }
  /* « à corriger » n'a de sens que s'il y a quelque chose à corriger :
     deux jours de fermeture ne sont pas une faute. */
  var h = '<div class="card"><div class="card-label">'
    + (lignes ? 'Heures à compléter' : 'Heures') + '</div>' + lignes;
  if (creux.length) {
    h += '<div class="row"><div class="row-main"><div class="row-meta">'
      + 'Aucune heure : ' + esc(creux.join(', '))
      + ' <span style="color:var(--ink-3)">— fermeture, ou fiches non remplies.</span>'
      + '</div></div></div>';
  }
  /* Sans planning, un jour sans heures est indiscernable d'un jour de
     repos. Le dire évite de lire cette liste comme une liste de fautes. */
  if (lignes) {
    h += '<div class="row"><div class="row-main"><div class="row-meta">'
      + 'Un jour sans heures peut être un repos : le tableau ne connaît pas le planning, '
      + 'il signale seulement ce qui manque par rapport aux autres.'
      + '</div></div></div>';
  }
  return h + '</div>';
}

/* ─── déclaré face à pointé ──────────────────────────────────────
   Le jour où la caisse tournera, les deux sources vivront côte à côte.
   Elles ne diront pas toujours la même chose : c'est précisément ce
   qu'il faut voir, et pas moyenner en silence. */
function eqEcarts(ecarts) {
  if (!ecarts || !ecarts.length) return '';
  var h = '<div class="card"><div class="card-label">Déclaré et pointé ne coïncident pas</div>';
  ecarts.slice(0, 12).forEach(function (e) {
    var d = new Date(e.jour + 'T12:00:00');
    var signe = e.diff > 0 ? '+' : '−';
    h += '<div class="row"><div class="row-main">'
      + '<div class="row-title">' + esc(e.nom) + ' — '
      + d.getDate() + '/' + ('0' + (d.getMonth() + 1)).slice(-2) + '</div>'
      + '<div class="row-meta">fiche ' + eqHM(e.declare)
      + ' &middot; pointeuse ' + eqHM(e.pointe)
      + ' <span style="color:var(--warn)">(' + signe + ' ' + eqHM(Math.abs(e.diff)) + ')</span>'
      + '</div></div></div>';
  });
  h += '<div class="row"><div class="row-main"><div class="row-meta">'
    + 'C\'est le pointage qui est compté dans le tableau : il est mesuré, la fiche est déclarée. '
    + 'Un écart répété sur la même personne se règle en salle, pas dans le classeur.'
    + '</div></div></div>';
  return h + '</div>';
}

/* ─── deux fois la même fiche ────────────────────────────────────── */
function eqDoubles(doubles) {
  if (!doubles || !doubles.length) return '';
  var h = '<div class="card"><div class="card-label">Fiches en double</div>';
  doubles.slice(0, 10).forEach(function (d) {
    var j = new Date(d.jour + 'T12:00:00');
    var tot = d.heures.reduce(function (a, x) { return a + x; }, 0);
    h += '<div class="row"><div class="row-main">'
      + '<div class="row-title" style="color:var(--warn)">' + esc(d.nom) + ' — '
      + j.getDate() + '/' + ('0' + (j.getMonth() + 1)).slice(-2)
      + ', service du ' + esc(d.service) + '</div>'
      + '<div class="row-meta">' + d.heures.map(function (x) { return eqHM(x); }).join(' + ')
      + ' — comptées ' + eqHM(tot) + ' sur la journée</div>'
      + '</div></div>';
  });
  h += '<div class="row"><div class="row-main"><div class="row-meta">'
    + 'Une même personne a rempli deux fiches pour le même service. Les heures '
    + 'se cumulent : tant que le doublon est là, la journée est majorée. '
    + 'À retirer dans la feuille <code>Equipe</code>.'
    + '</div></div></div>';
  return h + '</div>';
}

function eqVenteDu(jour) {
  var tout = (DATA.ventes && DATA.ventes.tout) || [];
  for (var i = 0; i < tout.length; i++) if (tout[i].d === jour) return tout[i];
  return null;
}
function eqCaSemaine(lundi) {
  var out = [];
  for (var i = 0; i < 7; i++) {
    var v = eqVenteDu(eqISO(eqPlus(lundi, i)));
    out.push(v ? (v.ca || 0) : 0);
  }
  return out;
}

/* ─── heures et chiffre d'affaires : le seul vrai ratio ──────────── */
function eqRendement(minutes, lundi) {
  var tout = (DATA.ventes && DATA.ventes.tout) || [];
  var ca = 0, cv = 0, jours = 0;
  for (var i = 0; i < 7; i++) {
    var jr = eqISO(eqPlus(lundi, i));
    tout.forEach(function (x) { if (x.d === jr) { ca += x.ca || 0; cv += x.cv || 0; jours++; } });
  }
  var heures = minutes / 60;
  return {
    ca: ca, couverts: cv, jours: jours, heures: heures,
    parHeure: heures ? ca / heures : 0,
    minParCouvert: cv ? minutes / cv : 0
  };
}

function eqAnomalies(anos) {
  if (!anos || !anos.length) return '';
  var h = '<div class="card"><div class="card-label">À régler</div>';
  anos.slice(0, 12).forEach(function (a) {
    var d = new Date(a.jour + 'T12:00:00');
    h += '<div class="row"><div class="row-main">'
      + '<div class="row-title" style="color:var(--warn)">' + esc(a.nom) + ' — '
      + d.getDate() + '/' + ('0' + (d.getMonth() + 1)).slice(-2) + '</div>'
      + '<div class="row-meta">' + esc(a.detail) + '</div></div></div>';
  });
  h += '<div class="row"><div class="row-main"><div class="row-meta">'
    + 'Un pointage incomplet est compté au plafond de 13 h : le total est donc majoré, pas perdu. '
    + 'À corriger dans la feuille <code>Pointage</code>.</div></div></div>';
  return h + '</div>';
}

/* ─── l'export, pour Marta et pour les quatre ans d'archives ─────── */
function eqExport(seances, lundi) {
  var l = ['Jour\tDate\tPrénom\tEntrée\tSortie\tMinutes\tHeures\tService\tSource\tRemarque'];
  seances.slice().sort(function (a, b) { return a.tsDebut - b.tsDebut; }).forEach(function (s) {
    var d = new Date(s.jour + 'T12:00:00');
    l.push([JOURS_LONG[(d.getDay() + 6) % 7], s.jour, s.nom, s.debut || '', s.fin || '',
