    +   '<button data-fil="impayees" class="'+(F_FILTRE==='impayees'?'on':'')+'">À payer ('+nbImp+')</button>'
    +   '<button data-fil="echeancier" class="'+(F_FILTRE==='echeancier'?'on':'')+'">Échéancier ('+nbEch+')</button>'
    + '</div>'
    + '<div class="rseg fseg">'
    +   '<button data-fil="toutes" class="'+(F_FILTRE==='toutes'?'on':'')+'">Toutes ('+nbTotal+')</button>'
    +   '<button data-fil="sanspdf" class="'+(F_FILTRE==='sanspdf'?'on':'')+'">Sans PDF ('+sansPdf+')</button>'
    + '</div>'
    + '<input class="fsearch" id="fq" type="search" placeholder="Chercher un fournisseur, un numéro…" value="'+esc(F_Q)+'">'
    + '<div class="row-meta" style="margin:8px 2px 4px">'+liste.length+' facture'+(liste.length>1?'s':'')
    +   ' · '+EUR2.format(totalFiltre)+'</div>';

  if(!liste.length){
    h += '<div class="resa-vide">Rien dans cette vue.</div>';
  } else {
    liste.slice(0, F_LIMITE).forEach(function(l, i){
      var et = F_ETATS[l.etat] || { cls:'warn', lib:(l.statut||'à traiter') };
      var prods = l.produits && l.produits.length ? l.produits : null;
      var did = 'fdet-'+i;
      h += '<div class="row facture-head" onclick="toggleFacture(\'' + did + '\')" style="cursor:pointer">'
        + '<div class="row-main">'
        + '<div class="row-title"><span class="caret">▸</span> ' + esc(l.fournisseur) + '</div>'
        + '<div class="row-meta">' + esc(l.date) + (l.numero ? ' · n° '+esc(l.numero) : '')
        + (l.type && l.type !== 'Factura' ? ' · <span style="color:var(--copper);font-weight:500">'+esc(l.type)+'</span>' : '')
        + (prods ? ' · '+prods.length+' article'+(prods.length>1?'s':'') : '') + '</div>'
        + '<span class="tag '+et.cls+'">' + esc(et.lib) + '</span>'
        + (l.preuve ? '<div class="fpreuve">' + esc(l.preuve) + '</div>' : '')
        + (l.fichier
            ? '<br><a class="fpdf" href="#" onclick="event.preventDefault();event.stopPropagation();ouvrirPdf(\'' + esc(l.fichier) + '\',this)">📄 Ouvrir le PDF</a>'
            : '<br><span class="fpdf off">PDF pas encore archivé</span>')
        + '</div><div class="row-value">' + EUR2.format(l.montant||0) + '</div></div>';
      h += '<div class="facture-detail" id="'+did+'">';
      if(prods){
        prods.forEach(function(p){
          h += '<div class="pline"><span class="pref">'+esc(p.ref||'')+'</span>'
            + '<span class="pdes">'+esc(p.designation||p.produit||'')+'</span>'
            + '<span class="pqte">'+(p.quantite!=null?esc(String(p.quantite)):'')+'</span>'
            + '<span class="ppu">'+(p.pu!=null?EUR2.format(p.pu):'')+'</span></div>';
        });
      } else {
        h += '<div class="pline pline-empty">Le détail produit se remplit tout seul : l\'agent catalogue relit chaque PDF.</div>';
      }
      h += '</div>';
    });
    if(liste.length > F_LIMITE){
      h += '<button class="resa-plus" id="facPlus">Afficher 30 de plus (' + (liste.length - F_LIMITE) + ' restantes)</button>';
    }
  }
  h += '</div>';

  root.innerHTML = h;
  animateFigures(root);

  root.querySelectorAll('.fseg button').forEach(function(b){
    b.addEventListener('click', function(){
      F_FILTRE = b.getAttribute('data-fil'); F_LIMITE = 30; renderFactures();
    });
