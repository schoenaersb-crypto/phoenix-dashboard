svc h3 button{margin-inline-start:auto;font-family:var(--mono);font-size:9.5px;letter-spacing:.08em;
 color:var(--deep);background:var(--gold);padding:5px 11px;border-radius:999px;font-weight:600}
.li{display:flex;gap:10px;align-items:flex-start;padding:10px 11px;border:1px solid var(--hair2);
 border-radius:12px;margin-bottom:7px;background:rgba(255,255,255,.02)}
.li .q{font-family:var(--mono);font-size:15px;color:var(--gold);min-width:22px}
.li .c{flex:1;min-width:0}
.li .n{font-size:14.5px;line-height:1.25}
.li .o{font-size:11.5px;color:var(--gold);margin-top:3px;line-height:1.35}
.li .o.ret{color:var(--alert)}
.li .o.gris{color:var(--ink3)}
.li .pr{font-family:var(--mono);font-size:13px;color:var(--ink2);white-space:nowrap}
.li .pr.off{text-decoration:line-through;color:var(--ink3)}
.li.att{opacity:.62}
.li.annule{opacity:.45}
.li.annule .n{text-decoration:line-through}
.li .x{flex:none;color:var(--ink3);font-size:17px;padding:0 4px;min-width:26px}
.vide{text-align:center;color:var(--ink3);font-size:13.5px;padding:26px 0;line-height:1.6}

/* ── carte ─────────────────────────────────────────────────────── */
