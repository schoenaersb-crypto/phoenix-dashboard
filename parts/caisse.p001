e-debar{color:var(--ink3);border-color:var(--hair)}
.e-retard{color:#E8A54B;border-color:rgba(232,165,75,.6);animation:clignote 1.1s ease-in-out infinite}
@keyframes clignote{0%,100%{opacity:1}50%{opacity:.35}}
.svc h3 button.pulse{animation:clignote 1.4s ease-in-out infinite}
.svc h3 button[data-debar]{background:transparent;color:var(--copper);border:1px solid var(--hair)}
/* écran cuisine : l'âge et les mots-couleurs */
.tk.retard{border-color:rgba(232,165,75,.7)}
.tk .ret-mn{color:#E8A54B;animation:clignote 1.1s ease-in-out infinite}
.tk .et{font-style:normal;font-family:var(--mono);font-size:8.5px;letter-spacing:.08em;
 padding:1px 6px;border-radius:999px;border:1px solid;margin-inline-end:7px;vertical-align:1px}
.tk .et-att{color:#E08A6D;border-color:rgba(196,99,63,.6)}
.tk .et-env{color:#8FBF88;border-color:rgba(127,163,122,.6)}
.