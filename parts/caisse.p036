function faireMarcher(sv){
  var tb = S.tables[TREF]; if(!tb) return;
  var lst = tb.lignes.filter(function(l){ return !l.annule && l.service===sv && l.etat==='attente'; });
  if(!lst.length) return;
  lst.forEach(function(l){ l.etat='lance'; l.tsLance=Date.now(); });
  emettreTickets(tb, lst, 'FAIRE MARCHER');
  sauve(); renderTable(); renderPlan(); majBadge();
  PHXtoast(t('faire_marcher') + ' : ' + NOM_SVC[sv].toLowerCase());
}
