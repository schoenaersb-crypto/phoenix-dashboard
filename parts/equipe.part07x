; renderCatList();
      e.style.color='var(--ok)'; e.textContent=t('cmd_saved'); setTimeout(function(){e.textContent='';e.style.color='';},2000);
      loadCommandes(); return;
    }
    post(queue[i]).then(function(){ run(i+1); }).catch(function(err){
      btn.disabled=false;
      if(/code/i.test(err.message)){ CODE=''; try{localStorage.removeItem('phx_eq_code');}catch(_){}; openGate(t('err_code')); }
      else e.textContent = t('err_send');
    });
  })(0);
});

/* produit hors liste + photo */
fillCats(el('cCat'));
el('offUrg').querySelectorAll('button').forEach(function(b){
  b.addEventListener('click', function(){ el('offUrg').querySelectorAll('button').forEach(function(x){x.classList.remove('on')}); b.classList.add('on'); });
});
var OFFPHOTO = '';
function compressImg(file, cb){
  var reader = new FileReader();
  reader.onload = function(ev){
    var img = new Image();
    img.onload = function(){
      var max=1024, w=img.width, h=img.height;
      if(w>h && w>max){ h=Math.round(h*max/w); w=max; } else if(h>=w && h>max){ w=Math.round(w*max/h); h=max; }
      var c=document.createElement('canvas'); c.width=w; c.height=h;
      c.getContext('2d').drawImage(img,0,0,w,h);
      try{ cb(c.toDataURL('image/jpeg',0.7)); }catch(_){ cb(''); }
    };
    img.onerror=function(){ cb(''); };
    img.src=ev.target.result;
  };
  reader.readAsDataURL(file);
}
el('cPhotoInput').addEventListener('change', function(){
  var f = this.files && this.files[0]; if(!f) return;
  el('cPhotoPrev').innerHTML = '<div class="cat-empty">…</div>';
  compressImg(f, function(dataUrl){
    OFFPHOTO = dataUrl || '';
    if(!OFFPHOTO){ el('cPhotoPrev').innerHTML=''; return; }
    el('cPhotoPrev').innerHTML = '<img src="'+OFFPHOTO+'"><div class="rm" id="cPhotoRm">✕ '+t('cmd_photo_rm')+'</div>';
    el('cPhotoRm').addEventListener('click', function(){ OFFPHOTO=''; el('cPhotoPrev').innerHTML=''; el('cPhotoInput').value=''; });
  });
});
el('cSave').addEventListener('click', function(){
  var e = el('cErr'); e.style.color=''; e.textContent='';
  var prod = el('cProd').value.trim();
  if(!prod){ e.textContent = t('cmd_need_prod'); return; }
  var catK = el('cCat').value;
  var urg = el('offUrg').querySelector('button.on');
  var urgTxt = urg ? t(urg.dataset.u==='urgent'?'urg_urgent':(urg.dataset.u==='semaine'?'urg_semaine':'urg_pas_urgent')) : '';
  var btn = el('cSave'); btn.disabled = true; e.style.color=''; e.textContent = t('resa_loading');
  post({ action:'commande', article:(catK?t(catK)+' · ':'')+prod, quantite:el('cQte').value.trim(), urgence:urgTxt, photo:OFFPHOTO||undefined })
  .then(function(){
    el('cProd').value=''; el('cQte').value=''; OFFPHOTO=''; el('cPhotoPrev').innerHTML=''; el('cPhotoInput').value=''; btn.disabled=false;
    e.style.color='var(--ok)'; e.textContent=t('cmd_saved');
    setTimeout(function(){ e.textContent=''; e.style.color=''; }, 2000);
    loadCommandes();
  })
  .catch(function(err){
    btn.disabled=false; e.style.color='';
    if(/code/i.test(err.message)){ CODE=''; try{localStorage.removeItem('phx_eq_code');}catch(_){}; openGate(t('err_code')); }
    else e.textContent = t('err_send');
  });
});

/* re-render des listes si on change de langue en étant sur un onglet vivant */
document.querySelectorAll('.lang button').forEach(function(b){
  b.addEventListener('click', function(){
    if(el('viewResa').style.display !== 'none') setTimeout(loadReservations, 40);
    if(el('viewCmd').style.display !== 'none') setTimeout(loadCommandes, 40);
    setTimeout(function(){ fillCats(el('cCat')); renderCatList(); }, 20);
  });
});

/* ── démarrage ── */
applyLang();
if(!NOM || !CODE) openGate(); else { paintWho(); checkStatut(); }
</script>
