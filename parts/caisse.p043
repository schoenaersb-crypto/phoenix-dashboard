, toutes=true;
  lignesPayables(tb).forEach(function(l){ if(ADD.sel[l.id]) s += l.pu*l.qte; else toutes=false; });
  if(!s) return 0;
  /* Derniere selection : sur une table remisee, la somme des prorata
     arrondis ne retombe pas juste. Quand la selection couvre tout ce qui
     reste a payer, on sert le solde exact — jamais de centimes orphelins. */
  if(toutes) return resteTable(tb.ref);
  var tot = sousTotal(tb);
  var rem = tb.remise ? Math.round(tb.remise * s / tot) : 0;
  return Math.max(0, s - rem);
}
function montantAPayer(tb){
  var reste = resteTable(tb.ref);
  if(ADD.mode==='sel')  return Math.min(reste, montantSel(tb));
  if(ADD.mode==='part' && ADD.parts>1){
    /* La part se calcule sur le total fige au moment du choix des parts,
       jamais sur le reste : sinon chaque paiement redivise ce qui reste,
       les parts fondent et la table ne se solde jamais.
       Le dernier payeur recoit le solde exact, centimes compris. */
    var base = ADD.base || reste;
    if(ADD.partsPayees >= ADD.parts-1) return reste;
    return Math.min(reste, Math.round(base/ADD.parts));
  }
  