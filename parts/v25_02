/* ════════════════════════════════════════════════
   PHOENIX PILOTAGE v25 — refonte « élégance de maison »
   Palette imposée : navy · cuivre · doré · crème
   Direction : sobriété bistronomique, hiérarchie nette,
   moins d'effets, plus de lisibilité (plein soleil, en service)
   ════════════════════════════════════════════════ */
:root{
  --navy:#16364A;
  --navy-deep:#0A1B28;
  --navy-card:#122B3D;
  --navy-card-solid:#122B3D;
  --panel-2:#0E2333;
  --copper:#B98D55;
  --gold:#D4A843;
  --gold-soft:rgba(212,168,67,.3);
  --cream:#F6F0E4;

  --ink:var(--cream);
  --ink-2:rgba(246,240,228,.7);
  --ink-3:rgba(246,240,228,.48);

  /* statuts fonctionnels — toujours accompagnés d'un texte */
  --ok:#7FA37A;
  --warn:#D4A843;
  --alert:#C4633F;

  --hair:rgba(185,141,85,.3);
  --hair-soft:rgba(185,141,85,.14);

  --serif:'Cormorant Garamond',Georgia,serif;
  --sans:'Jost',system-ui,-apple-system,sans-serif;
  --mono:'JetBrains Mono',ui-monospace,'Courier New',monospace;

  --pad:16px;
  --r:16px;
  --dock-h:74px;

  --shadow-1:0 6px 20px rgba(4,12,18,.35);
  --shadow-2:0 10px 30px rgba(4,12,18,.45);
  --ease:cubic-bezier(.22,.9,.3,1);
}

*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html{-webkit-text-size-adjust:100%}

body{
  font-family:var(--sans);
  font-weight:300;
  background:var(--navy-deep);
  color:var(--ink);
  min-height:100vh;
  padding-bottom:calc(var(--dock-h) + 26px + env(safe-area-inset-bottom));
  line-height:1.5;
  overflow-x:hidden;
}

/* ── fond : navy profond, un seul halo cuivré immobile, grain discret ──
   (l'aurora animée des versions précédentes pompait la batterie) */
.ambient{
  position:fixed;inset:0;z-index:-1;
  background:
    radial-gradient(90% 46% at 50% -10%, rgba(185,141,85,.14), transparent 60%),
    radial-gradient(70% 50% at 50% 115%, rgba(22,54,74,.75), transparent 70%),
    linear-gradient(178deg,#081722 0%, #0A1B28 48%, #0C2231 100%);
  overflow:hidden;
}
.ambient::before{content:"";display:none}
.ambient::after{
  content:"";position:absolute;inset:0;
  background-image:radial-gradient(rgba(246,240,228,.028) 1px, transparent 1px);
  background-size:28px 28px;
  mask-image:linear-gradient(180deg,transparent,#000 15%,#000 80%,transparent);
}

/* ════════════════════════════════════════════════
   EN-TÊTE
   ════════════════════════════════════════════════ */
.topbar{
  position:sticky;top:0;z-index:40;
  background:rgba(9,23,34,.9);
  backdrop-filter:blur(12px);
  -webkit-backdrop-filter:blur(12px);
  border-bottom:1px solid var(--hair-soft);
  padding:calc(13px + env(safe-area-inset-top)) var(--pad) 12px;
}
.topbar-row{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}

.wordmark{
  font-family:var(--serif);
  font-size:23px;letter-spacing:.04em;line-height:1.1;
  font-weight:600;white-space:nowrap;
}
.wordmark em{
  font-style:normal;
  background:linear-gradient(100deg,#E9CD87 0%, var(--gold) 55%, var(--copper) 100%);
  -webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;color:var(--gold);
}

.service-state{display:inline-flex;align-items:center;gap:7px;margin-top:4px}
.dot{width:7px;height:7px;border-radius:50%;background:var(--ok);flex:none;position:relative}
.dot::after{
  content:"";position:absolute;inset:-4px;border-radius:50%;
  border:1px solid var(--ok);opacity:.45;
  animation:pulse 2.6s ease-out infinite;
}
.dot.closed{background:var(--copper);opacity:.55}
.dot.closed::after{display:none}
@keyframes pulse{0%{transform:scale(.5);opacity:.5}80%,100%{transform:scale(1.5);opacity:0}}

.stamp{
  font-family:var(--mono);
  font-size:10px;letter-spacing:.15em;text-transform:uppercase;
  color:var(--copper);line-height:1.55;
}
.stamp.right{text-align:right;white-space:nowrap}
.sync{color:var(--ink-3);letter-spacing:.11em;cursor:pointer}

/* ════════════════════════════════════════════════
   CONTENU
   ════════════════════════════════════════════════ */
main{padding:16px var(--pad) 0}

.panel{display:none}
.panel.on{display:block;animation:rise .28s var(--ease) both}
@keyframes rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

/* ── accès de l'équipe ── */
.acc-li{display:flex;align-items:center;gap:10px;padding:11px 12px;border:1px solid var(--hair-soft);
 border-radius:12px;margin-bottom:7px;background:var(--panel-2)}
.acc-li.off{opacity:.5}
.acc-li .c{flex:1;min-width:0}
.acc-li .n{font-size:15px}
.acc-li .m{font-size:11.5px;color:var(--ink-3);margin-top:2px}
.acc-li .b{flex:none;padding:8px 12px;border-radius:999px;border:1px solid var(--hair);
 font-size:11.5px;color:var(--ink-2);background:none;cursor:pointer;min-height:34px}
.acc-li .b.on{border-color:var(--alert);color:var(--alert)}
.acc-dot{width:8px;height:8px;border-radius:50%;flex:none}
.acc-dot.ok{background:var(--ok)}.acc-dot.no{background:var(--alert)}
.acc-form{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.acc-form input{flex:1;min-width:130px;padding:12px;border-radius:11px;border:1px solid var(--hair-soft);
 background:rgba(6,16,24,.5);color:var(--cream);font-family:inherit;font-size:14.5px}
.acc-form input:focus{outline:2px solid var(--gold);outline-offset:-1px}
.acc-form button{flex:none;padding:12px 18px;border-radius:11px;background:var(--gold);
 color:var(--navy-deep);font-weight:600;font-size:14.5px;border:0;cursor:pointer}
.acc-msg{font-size:12.5px;margin-top:9px;min-height:16px}
.acc-note{font-size:12px;color:var(--ink-3);line-height:1.5;margin-top:10px}

/* ── cartes : panneaux pleins, liseré cuivre, une ombre calme ── */
.card{
  position:relative;
  background:var(--navy-card);
  border:1px solid var(--hair-soft);
  border-radius:var(--r);
  padding:16px 15px;
  margin-bottom:12px;
  box-shadow:var(--shadow-1);
}
.card.hero{
  background:linear-gradient(172deg,#153043 0%, #102638 100%);
  border-color:var(--hair);
  box-shadow:var(--shadow-2);
}
.card.hero::before{
  content:"";position:absolute;top:0;left:15px;right:auto;bottom:auto;width:34px;height:2px;
  background:linear-gradient(90deg,var(--gold),var(--copper));
  border-radius:0 0 2px 2px;pointer-events:none;
}

.card-h{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.card-t,
.card-label{
  font-family:var(--mono);
  font-size:10px;letter-spacing:.16em;text-transform:uppercase;
  color:var(--copper);
  margin-bottom:10px;
  display:flex;align-items:center;gap:8px;
}
.card-h .card-t{margin-bottom:0}
.card-label::after{content:"";flex:1;height:1px;background:var(--hair-soft)}

/* chiffres — nets, sans dégradé : la donnée n'a pas besoin de maquillage */
.figure{
  font-family:var(--sans);font-weight:600;
  font-size:40px;line-height:1.05;letter-spacing:-.01em;
  color:var(--ink);
  font-variant-numeric:tabular-nums;
}
.hero .figure > span[data-count]{color:var(--ink);background:none;-webkit-text-fill-color:currentColor;filter:none}
.figure .unit{font-size:14px;font-weight:400;color:var(--copper);margin-left:4px}
.figure-sub{font-size:13.5px;color:var(--ink-2);margin-top:7px}

.delta{
  display:inline-flex;align-items:center;gap:4px;
  font-size:12.5px;font-weight:500;
  font-family:var(--sans);
  border:1px solid currentColor;border-radius:999px;
  padding:3px 10px;margin-left:10px;vertical-align:6px;
}
.delta.up{color:var(--ok)}
.delta.down{color:var(--alert)}

.duo{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.duo .card{margin-bottom:0}
.duo .figure{font-size:26px}

/* ── graphique (SVG) ── */
.chart-wrap{margin-top:15px;position:relative}
.chart-wrap svg{display:block;width:100%;height:auto}
.bar{cursor:pointer}
.bar rect.hit{fill:transparent}
.bar path.mark{fill:var(--copper);opacity:.42;transition:opacity .18s}
.bar.now path.mark{fill:var(--gold);opacity:1;filter:none}
.bar.hov path.mark{opacity:.78}
.bar.now.hov path.mark{opacity:1}
.axis-lab{font-family:var(--mono);font-size:9px;letter-spacing:.06em;fill:var(--ink-3)}
.bar-lab{font-family:var(--sans);font-weight:500;font-size:11px;fill:var(--ink)}
.gridline{stroke:rgba(246,240,228,.09);stroke-width:1}

.tip{
  position:absolute;z-index:5;pointer-events:none;
  background:var(--navy-deep);
  border:1px solid var(--hair);border-radius:9px;
  padding:7px 10px;
  font-size:12px;color:var(--ink);
  white-space:nowrap;
  transform:translate(-50%,-108%);
  box-shadow:var(--shadow-1);
  opacity:0;transition:opacity .14s;
}
.tip .t-meta{color:var(--ink-3);font-family:var(--mono);font-size:10px;letter-spacing:.08em}
.tip.on{opacity:1}

/* ── jauges (heures équipe) ── */
.meter-row{padding:11px 0;border-top:1px solid var(--hair-soft)}
.meter-row:first-of-type{border-top:0}
.meter-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:7px}
.meter-name{font-size:14.5px}
.meter-val{font-family:var(--mono);font-size:12.5px;color:var(--ink-2)}
.meter{height:5px;border-radius:99px;background:rgba(246,240,228,.08);overflow:hidden}
.meter i{
  display:block;height:100%;border-radius:99px;
  background:linear-gradient(90deg,var(--copper),var(--gold));
  width:0;transition:width .8s var(--ease);
}

/* ── lignes de liste ── */
.row{
  display:flex;align-items:flex-start;gap:12px;
  padding:13px 0;
  border-top:1px solid var(--hair-soft);
}
.row:first-of-type{border-top:0}
.row-main{flex:1;min-width:0}
.row-title{font-size:15px;font-weight:400}
.row-meta{font-size:12.5px;color:var(--ink-3);margin-top:3px}
.row-value{
  font-family:var(--mono);font-size:14px;font-variant-numeric:tabular-nums;
  white-space:nowrap;
}

.tag{
  display:inline-flex;align-items:center;gap:5px;
  font-family:var(--mono);font-size:9.5px;letter-spacing:.09em;text-transform:uppercase;
  padding:3.5px 8px;border-radius:6px;
  border:1px solid currentColor;
  margin-top:6px;
  background:rgba(9,23,34,.4);
}
.tag::before{content:"";width:5px;height:5px;border-radius:50%;background:currentColor}
.tag.ok{color:var(--ok)}
.tag.warn{color:var(--warn)}
.tag.alert{color:var(--alert)}
.tag.ech{background:rgba(90,140,180,.14);color:#8fb8d8;border-color:rgba(140,180,215,.35)}

/* ressenti : 5 points */
.feel{display:inline-flex;gap:3px;margin-top:6px;vertical-align:middle}
.feel i{width:7px;height:7px;border-radius:50%;background:rgba(246,240,228,.13)}
.feel.ok i.f{background:var(--ok)}
.feel.warn i.f{background:var(--warn)}
.feel.alert i.f{background:var(--alert)}

.stars{font-family:var(--mono);font-size:13px;color:var(--gold);letter-spacing:.1em}

/* ── factures ── */
.frow{margin-top:12px}
.frow:first-child{margin-top:6px}
.frow-top{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:5px}
.frow-name{font-size:13.5px;color:var(--ink)}
.frow-val{font-family:var(--mono);font-size:12.5px;color:var(--ink-2);font-variant-numeric:tabular-nums}
.fbar-track{height:6px;border-radius:4px;background:rgba(246,240,228,.07);overflow:hidden}
.fbar-fill{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--copper),var(--gold));transition:width .6s var(--ease)}
.fbar-fill.alert{background:linear-gradient(90deg,#b0603f,#C4633F)}
.caret{display:inline-block;color:var(--copper);font-size:11px;transition:transform .18s;transform-origin:center}
.facture-head:hover .row-title{color:var(--gold)}
.facture-detail{max-height:0;overflow:hidden;transition:max-height .28s ease;border-left:2px solid var(--gold-soft);margin:0 0 0 6px}
.facture-detail.on{max-height:600px}
.pline{display:grid;grid-template-columns:64px 1fr auto auto;gap:8px;align-items:baseline;
  padding:6px 10px;font-size:12.5px;color:var(--ink-2)}
.pline .pref{font-family:var(--mono);font-size:11px;color:var(--ink-3)}
.pline .pdes{color:var(--ink)}
.pline .pqte{font-family:var(--mono);font-variant-numeric:tabular-nums;color:var(--ink-2)}
.pline .ppu{font-family:var(--mono);font-variant-numeric:tabular-nums;color:var(--ink-3)}
.pline-empty{display:block;color:var(--ink-3);font-style:italic;padding:8px 10px}
.fpreuve{font-size:10.5px;color:var(--ink-3);margin-top:4px;line-height:1.4;font-style:italic}
.fnb{font-size:10px;color:var(--ink-3);letter-spacing:.04em}
.fvar{font-size:10px;color:var(--ink-3);opacity:.75;margin-top:3px;line-height:1.35}
.fpdf{display:inline-flex;align-items:center;gap:5px;font-family:var(--mono);font-size:9.5px;letter-spacing:.06em;
  color:var(--gold);text-decoration:none;border:1px solid rgba(212,168,67,.35);border-radius:999px;padding:4px 10px;margin-top:6px;min-height:26px}
.fpdf:active{background:rgba(212,168,67,.15)}
.fpdf.off{color:var(--ink-3);opacity:.55;text-decoration:none;cursor:default}

/* ── états vides / erreurs / chargement ── */
.state{
  text-align:center;
  padding:44px 22px;
  color:var(--ink-2);
  font-size:14px;
}
.state .glyph{
  width:52px;height:52px;margin:0 auto 16px;
  border:1px solid var(--hair);border-radius:15px;
  display:flex;align-items:center;justify-content:center;
  color:var(--copper);
  background:rgba(185,141,85,.06);
}
.state strong{
  display:block;
  font-family:var(--serif);font-size:23px;font-weight:600;
  color:var(--ink);margin-bottom:8px;
}
.state code{font-family:var(--mono);font-size:12px;color:var(--gold);word-break:break-all}

.skel{border-radius:var(--r);height:116px;margin-bottom:12px;position:relative;overflow:hidden;
  background:var(--panel-2);border:1px solid var(--hair-soft)}
.skel::after{
  content:"";position:absolute;inset:0;
  background:linear-gradient(100deg,transparent 30%,rgba(246,240,228,.05) 50%,transparent 70%);
  animation:shimmer 1.6s infinite;
}
.skel.sm{height:76px}
@keyframes shimmer{from{transform:translateX(-100%)}to{transform:translateX(100%)}}

/* ════════════════════════════════════════════════
   DOCK BAS — navigation + action IA
   ════════════════════════════════════════════════ */
.dock{
  position:fixed;left:0;right:0;bottom:0;z-index:50;
  padding:0 12px calc(10px + env(safe-area-inset-bottom));
  pointer-events:none;
}
.dock-inner{
  pointer-events:auto;
  position:relative;
  height:var(--dock-h);
  max-width:520px;margin:0 auto;
  display:grid;grid-template-columns:repeat(3,1fr) 64px repeat(3,1fr);
  align-items:stretch;
  background:rgba(9,23,34,.94);
  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);
  border:1px solid var(--hair-soft);
  border-radius:22px;
  box-shadow:0 14px 40px rgba(4,12,18,.55);
}
.dock-btn{
  background:none;border:0;cursor:pointer;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;
  color:var(--ink-3);
  font-family:var(--sans);font-size:9.5px;letter-spacing:.02em;font-weight:400;
  transition:color .2s;
  border-radius:18px;
  min-width:0;
  position:relative;
}
.dock-btn svg{width:21px;height:21px;stroke:currentColor;fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.dock-btn[aria-selected="true"]{color:var(--gold);font-weight:500;text-shadow:none}
.dock-btn[aria-selected="true"]::before{
  content:"";position:absolute;bottom:8px;top:auto;left:50%;transform:translateX(-50%);
  width:14px;height:2px;border-radius:2px;
  background:var(--gold);
}
.dock-btn:focus-visible{outline:2px solid var(--gold);outline-offset:-4px}

/* ─── module Résa ─── */
.resa-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-bottom:13px}
.rstat{background:var(--navy-card);backdrop-filter:none;-webkit-backdrop-filter:none;
  border:1px solid var(--hair-soft);border-radius:14px;padding:12px 10px;text-align:center}
.rstat .rs-num{font-family:var(--serif);font-size:26px;font-weight:600;line-height:1;color:var(--gold);filter:none}
.rstat .rs-lbl{font-family:var(--mono);font-size:9px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-3);margin-top:6px}
.rseg{display:flex;background:var(--panel-2);backdrop-filter:none;-webkit-backdrop-filter:none;
  border:1px solid var(--hair-soft);border-radius:999px;padding:3px;margin-bottom:13px;box-shadow:none}
.rseg button{flex:1;background:none;border:0;border-radius:999px;padding:10px 8px;cursor:pointer;
  font-family:var(--sans);font-size:13px;color:var(--ink-2);transition:color .2s;min-height:38px}
.rseg button.on{
  background:var(--gold);
  color:var(--navy-deep);font-weight:600;
  box-shadow:none;
}
.rday{display:flex;align-items:baseline;justify-content:space-between;margin:18px 2px 9px}
.rday:first-child{margin-top:2px}
.rday .rd-t{font-family:var(--serif);font-size:19px;font-weight:600;color:var(--ink);text-transform:capitalize}
.rday .rd-c{font-family:var(--mono);font-size:11px;color:var(--copper)}
.rcard{display:flex;align-items:center;gap:12px;
  background:var(--navy-card);backdrop-filter:none;-webkit-backdrop-filter:none;
  border:1px solid var(--hair-soft);
  border-radius:14px;padding:12px 13px;margin-bottom:8px}
.rcard.warn{border-color:var(--gold-soft);background:linear-gradient(172deg,#183350 0%, #122B3D 100%);box-shadow:none}
.rcard.incomplet{border-left:2px solid var(--copper)}
.rcard .rc-h{font-family:var(--mono);font-size:15px;color:var(--gold);min-width:50px;filter:none}
.rcard .rc-mid{flex:1;min-width:0}
.rcard .rc-nom{font-size:15.5px;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.rcard .rc-sub{display:flex;align-items:center;gap:7px;margin-top:4px;flex-wrap:wrap}
.rcard .rc-note{font-family:var(--serif);font-style:italic;font-size:13px;color:var(--ink-2);margin-top:3px}
.rcard .rc-cvt{font-family:var(--serif);font-size:24px;font-weight:600;color:var(--ink);min-width:34px;text-align:center;line-height:1}
.rcard .rc-cvt small{display:block;font-family:var(--mono);font-size:8px;letter-spacing:.12em;color:var(--ink-3);margin-top:2px;font-weight:400}
.rchip{font-family:var(--mono);font-size:9px;letter-spacing:.06em;text-transform:uppercase;padding:3px 8px;border-radius:999px;border:1px solid transparent}
.rchip.thefork{background:rgba(127,163,122,.14);color:#9DC498;border-color:rgba(127,163,122,.3)}
.rchip.whatsapp{background:rgba(101,163,163,.14);color:#8FC7C7;border-color:rgba(101,163,163,.3)}
.rchip.web{background:rgba(212,168,67,.12);color:var(--gold);border-color:rgba(212,168,67,.3)}
.rchip.email{background:rgba(185,141,85,.14);color:var(--copper);border-color:rgba(185,141,85,.32)}
.rchip.autre{background:rgba(246,240,228,.07);color:var(--ink-2);border-color:var(--hair-soft)}
.rchip.valider{background:rgba(212,168,67,.18);color:var(--warn);border-color:rgba(212,168,67,.5);font-weight:600}
.rchip.manq{background:rgba(185,141,85,.14);color:var(--copper);border:1px solid rgba(185,141,85,.35)}
.resa-vide{text-align:center;padding:26px 10px;color:var(--ink-3);font-size:13.5px}

/* ── Ventes multi-périodes ── */
.vnav{display:flex;align-items:center;justify-content:space-between;margin:0 2px 12px}
.vnav-btn{width:42px;height:42px;border-radius:50%;border:1px solid var(--hair);
  background:var(--panel-2);backdrop-filter:none;-webkit-backdrop-filter:none;
  color:var(--gold);font-size:18px;cursor:pointer;line-height:1;
  box-shadow:none;transition:background .2s}
.vnav-btn:not(:disabled):active{background:rgba(212,168,67,.14);box-shadow:none}
.vnav-btn:disabled{opacity:.22;cursor:default}
.vnav-lab{font-family:var(--serif);font-size:22px;font-weight:600;text-transform:capitalize;text-align:center;flex:1;
  background:none;-webkit-background-clip:initial;background-clip:initial;-webkit-text-fill-color:currentColor;color:var(--ink)}
.vdeltas{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.vdelta{font-family:var(--mono);font-size:10.5px;padding:4px 10px;border-radius:999px;border:1px solid transparent}
.vdelta.up{background:rgba(127,163,122,.13);color:#9DC498;border-color:rgba(127,163,122,.3)}
.vdelta.down{background:rgba(196,106,91,.13);color:#D99C8F;border-color:rgba(196,106,91,.3)}
.vdelta.na{background:rgba(246,240,228,.06);color:var(--ink-3);border-color:var(--hair-soft)}
.vbest{margin-top:10px;font-family:var(--serif);font-style:italic;font-size:13.5px;color:var(--ink-2)}

/* ── Accueil : recap + objectifs ── */
.acc-hello{font-family:var(--serif);font-size:30px;font-weight:600;line-height:1.1;
  background:none;-webkit-background-clip:initial;background-clip:initial;-webkit-text-fill-color:currentColor;color:var(--ink)}
.acc-date{font-family:var(--mono);font-size:10.5px;letter-spacing:.15em;text-transform:uppercase;color:var(--copper);margin:4px 0 15px}
.acc-hero-in{display:flex;align-items:center;gap:16px;margin:4px 0 13px}
.ring-wrap{flex:none;width:128px;text-align:center}
.ring{width:128px;height:128px;display:block}
.ring-bg{fill:none;stroke:rgba(246,240,228,.09);stroke-width:8}
.ring-val{fill:none;stroke-width:8;stroke-linecap:round;filter:none;
  transition:stroke-dasharray .8s var(--ease)}
.ring-pct{font-family:var(--sans);font-weight:600;font-size:27px;fill:var(--cream);text-anchor:middle}
.ring-sub{font-family:var(--mono);font-size:8.5px;letter-spacing:.14em;text-transform:uppercase;fill:rgba(246,240,228,.45);text-anchor:middle}
.ring-cap{font-family:var(--sans);font-weight:600;font-size:15px;color:var(--gold);margin-top:2px}
.acc-hero-txt{flex:1;min-width:0}
.ah-obj{font-family:var(--sans);font-weight:600;font-size:22px;color:var(--ink)}
.ah-obj small{font-size:12px;font-weight:300;color:var(--ink-2)}
.ah-reste{font-size:13px;color:var(--ink-2);margin-top:4px}
.ah-reste.ok{color:var(--ok);font-weight:500}
.ah-last{font-family:var(--serif);font-style:italic;font-size:13px;color:var(--ink-3);margin-top:8px}
.abar{margin-top:13px}
.abar-top{display:flex;justify-content:space-between;font-size:12.5px;color:var(--ink-2);margin-bottom:5px}
.abar-val{font-family:var(--mono);font-size:11px;color:var(--ink)}
.abar-val em{font-style:normal;color:var(--ink-3)}
.abar-track{height:8px;border-radius:999px;background:rgba(246,240,228,.07);overflow:hidden;box-shadow:none}
.abar-fill{height:100%;border-radius:999px;background:linear-gradient(90deg,var(--copper),var(--gold));
  box-shadow:none;transition:width .8s var(--ease)}
.abar-fill.full{background:linear-gradient(90deg,#6E9A69,var(--ok))}
.abar-pct{font-family:var(--mono);font-size:9.5px;letter-spacing:.1em;color:var(--ink-3);margin-top:4px;text-align:right}
.acc-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.atile{text-align:left;cursor:pointer;border-radius:14px;padding:14px;
  background:var(--navy-card);backdrop-filter:none;-webkit-backdrop-filter:none;
  border:1px solid var(--hair-soft);
  color:var(--ink);font-family:var(--sans);
  transition:border-color .2s;min-height:44px}
.atile:active{transform:scale(.97)}
.atile .at-num{font-weight:600;font-size:21px;color:var(--gold);filter:none;font-variant-numeric:tabular-nums}
.atile .at-num small{font-size:12px;font-weight:300;color:var(--ink-2)}
.atile .at-lbl{font-size:12px;color:var(--ink-2);margin-top:3px}
.atile .rchip{display:inline-block;margin-top:7px}

/* ── modales ── */
.resa-ov{position:fixed;inset:0;background:rgba(6,15,22,.74);backdrop-filter:blur(5px);-webkit-backdrop-filter:blur(5px);z-index:99;display:flex;align-items:center;justify-content:center;padding:18px}
.resa-modal{width:100%;max-width:380px;max-height:88vh;overflow:auto;background:#132C3F;border:1px solid var(--hair);border-radius:16px;padding:18px;box-shadow:var(--shadow-2)}
.rlab{display:block;margin:10px 0 0;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-2)}
.rlab input,.rlab select,.rlab textarea{width:100%;margin-top:5px;padding:11px;border-radius:11px;border:1px solid var(--hair-soft);background:rgba(6,16,24,.5);color:var(--cream);font:inherit;font-size:15px}
.rlab input:focus,.rlab select:focus,.rlab textarea:focus{outline:2px solid var(--gold);outline-offset:-1px}
.resa-act{display:flex;gap:9px;margin-top:16px}
.rbtn{flex:1;padding:12px;border-radius:12px;border:0;background:var(--gold);color:var(--navy-deep);font:inherit;font-weight:600;cursor:pointer;min-height:44px}
.rbtn.ghost{background:transparent;border:1px solid rgba(246,240,228,.22);color:var(--ink-2)}
.rbtn.danger{background:transparent;border:1px solid rgba(196,99,63,.5);color:#d98a74}
.rmsg{margin-top:9px;font-size:12px;color:var(--ink-2);min-height:15px;text-align:center}
.fseg{margin-bottom:9px}
.fsearch{width:100%;padding:11px 12px;border-radius:12px;border:1px solid var(--hair-soft);background:rgba(6,16,24,.5);color:var(--cream);font:inherit;font-size:14px}
.fsearch:focus{outline:2px solid var(--gold);outline-offset:-1px}
.resa-plus{width:100%;background:none;border:1px dashed var(--hair);border-radius:12px;color:var(--copper);
  font-family:var(--sans);font-size:13px;padding:12px;cursor:pointer;margin-top:4px;min-height:44px}
.caprow{display:flex;align-items:center;gap:9px;padding:10px 0;border-bottom:1px solid var(--hair-soft);font-size:13px;cursor:pointer}
.caprow:last-of-type{border-bottom:0}
.caprow input{width:17px;height:17px;accent-color:var(--gold);flex:0 0 auto}
.cap-h{font-family:var(--mono);font-size:12px;color:var(--gold);flex:0 0 42px}
.cap-n{flex:1 1 auto;color:var(--cream);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cap-c{flex:0 0 auto;color:var(--ink-2);font-size:12px}
.cap-s{flex:0 0 auto;font-size:10px;letter-spacing:.04em;text-transform:uppercase;color:var(--ink-3)}
.caprow.neuf .cap-s{color:var(--copper)}

/* l'orbe central — le résumé IA */
.orb{
  position:relative;align-self:center;justify-self:center;
  width:56px;height:56px;margin-top:-30px;
  border-radius:50%;border:0;cursor:pointer;
  background:linear-gradient(140deg,#E7C264 0%, var(--gold) 45%, var(--copper) 100%);
  color:var(--navy-deep);
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 8px 22px rgba(212,168,67,.35), 0 3px 8px rgba(4,12,18,.4);
  transition:transform .15s var(--ease);
}
.orb::before{
  content:"";position:absolute;inset:-6px;border-radius:50%;
  border:1px solid var(--gold-soft);
  animation:none;border-top-color:var(--gold-soft);
}
.orb:active{transform:scale(.93)}
.orb svg{width:25px;height:25px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.orb:focus-visible{outline:2px solid var(--cream);outline-offset:3px}
.orb-label{
  position:absolute;left:50%;transform:translateX(-50%);bottom:6px;
  font-family:var(--sans);font-size:10px;letter-spacing:.05em;color:var(--ink-3);
  pointer-events:none;
}

/* ════════════════════════════════════════════════
   TICKET IA — papier thermique (élément signature)
   ════════════════════════════════════════════════ */
.scrim{
  position:fixed;inset:0;z-index:60;
  background:rgba(5,13,19,.74);
  backdrop-filter:blur(4px);
  -webkit-backdrop-filter:blur(4px);
  opacity:0;pointer-events:none;transition:opacity .25s;
}
.scrim.on{opacity:1;pointer-events:auto}

.ticket-wrap{
  position:fixed;left:0;right:0;bottom:0;z-index:70;
  transform:translateY(103%);
  transition:transform .34s var(--ease);
  max-height:88vh;display:flex;flex-direction:column;
  padding:0 10px;
}
.ticket-wrap.on{transform:none}

.ticket{
  background:var(--cream);
  color:#2A2118;
  border-radius:16px 16px 0 0;
  display:flex;flex-direction:column;
  overflow:hidden;
  max-height:88vh;
  box-shadow:0 -14px 44px rgba(4,12,18,.55);
}
.ticket-head{
  flex:none;
  padding:15px 18px 12px;
  border-bottom:1px dashed rgba(42,33,24,.3);
  display:flex;align-items:center;justify-content:space-between;gap:10px;
}
.ticket-title{font-family:var(--mono);font-size:11px;font-weight:600;letter-spacing:.19em;text-transform:uppercase}
.ticket-close{background:none;border:0;cursor:pointer;font-family:var(--mono);font-size:16px;color:#2A2118;padding:6px 10px;min-height:34px}
.ticket-close:focus-visible{outline:2px solid var(--copper)}

.ticket-body{
  flex:1;overflow-y:auto;
  padding:16px 18px;
  font-family:var(--mono);font-size:12.5px;line-height:1.72;
  -webkit-overflow-scrolling:touch;
}
.msg{margin-bottom:16px;white-space:pre-wrap;word-wrap:break-word}
.msg.me{padding-left:12px;border-left:2px solid var(--copper);color:#5A4A34}
.ticket-rule{border:0;border-top:1px dashed rgba(42,33,24,.28);margin:14px 0}

.ticket-foot{
  flex:none;
  border-top:1px dashed rgba(42,33,24,.3);
  padding:11px 12px calc(11px + env(safe-area-inset-bottom));
  display:flex;gap:8px;align-items:flex-end;
  background:var(--cream);
}
.ticket-foot textarea{
  flex:1;resize:none;
  font-family:var(--mono);font-size:13px;line-height:1.5;
  color:#2A2118;background:rgba(42,33,24,.05);
  border:1px solid rgba(42,33,24,.18);border-radius:9px;
  padding:10px 11px;max-height:110px;
}
.ticket-foot textarea:focus{outline:2px solid var(--copper);outline-offset:-1px}
.send{
  flex:none;background:var(--navy);color:var(--cream);
  border:0;border-radius:9px;
  font-family:var(--sans);font-size:14px;font-weight:500;
  padding:12px 15px;cursor:pointer;min-height:44px;
}
.send:disabled{opacity:.4;cursor:default}

.chips{display:flex;gap:7px;overflow-x:auto;padding:0 18px 13px;scrollbar-width:none}
.chips::-webkit-scrollbar{display:none}
.chip{
  flex:none;font-family:var(--sans);font-size:12px;
  color:#5A4A34;background:rgba(42,33,24,.06);
  border:1px solid rgba(42,33,24,.16);border-radius:999px;
  padding:8px 13px;cursor:pointer;min-height:34px;
}
.typing{color:#8A7A62;font-style:italic}

/* ── porte d'accès (code admin) ── */
.gate{position:fixed;inset:0;z-index:90;display:none;align-items:center;justify-content:center;
  background:var(--navy-deep);padding:26px}
.gate.on{display:flex}
.gate-card{width:100%;max-width:330px;text-align:center}
.gate-card .wordmark{font-size:30px;margin-bottom:6px}
.gate-sub{font-size:13.5px;color:var(--ink-2);margin-bottom:22px}
.gate-input{width:100%;text-align:center;
  font-family:var(--mono);font-size:19px;letter-spacing:.35em;
  color:var(--ink);background:var(--navy-card);
  border:1px solid var(--hair);border-radius:13px;
  padding:14px 12px;margin-bottom:12px}
.gate-input:focus{outline:2px solid var(--gold);outline-offset:-1px}
.gate-btn{width:100%;font-family:var(--sans);font-size:15px;font-weight:500;
  color:var(--navy-deep);background:var(--gold);border:0;border-radius:13px;
  padding:14px;cursor:pointer;min-height:48px}
.gate-err{font-size:12.5px;color:var(--alert);margin-top:10px;min-height:18px}

@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}
}
@media (min-width:720px){
  body{max-width:680px;margin:0 auto}
  .ticket-wrap{max-width:680px;margin:0 auto}
}